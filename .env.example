# Copy to .env and replace every REQUIRED placeholder before startup.
# Never commit .env. Production values must come from the deployment secret store.
ENVIRONMENT=development
PUBLIC_DOMAIN=localhost
PUBLIC_RTMP_HOST=localhost
PUBLIC_RTMP_PORT=1935
RTMP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088

SESSION_SECRET=REQUIRED_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
# Generate separately; never reuse SESSION_SECRET.
WORKER_AUTH_PASSWORD=REQUIRED_INDEPENDENT_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
# Generate independently from both SESSION_SECRET and WORKER_AUTH_PASSWORD.
BOOTSTRAP_WORKER_SECRET=REQUIRED_THIRD_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
# Write the exact same value, without extra output, to this mode-0600 worker secret file.
BOOTSTRAP_WORKER_SECRET_FILE=./secrets/bootstrap_worker_secret
MASTER_ENCRYPTION_KEY=REQUIRED_FERNET_KEY
ADMIN_LOGIN=REQUIRED_ADMIN_LOGIN
# Keep the hash single-quoted so Compose treats dollar signs literally.
ADMIN_PASSWORD_HASH='REQUIRED_ARGON2ID_HASH'

SQLITE_PATH=/srv/app/data/restream.db
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_HLS_URL=http://mediamtx:8888
MEDIAMTX_INTERNAL_RTMP_URL=rtmp://mediamtx:1935
WORKER_AUTH_USER=adojapan-worker
MAX_DESTINATIONS=2
RECONNECT_INITIAL_SECONDS=2
RECONNECT_MAX_SECONDS=30
RECONNECT_STABLE_SECONDS=30
RECONNECT_MAX_FAST_FAILURES=6
LOG_LEVEL=INFO
TRUSTED_PROXIES=127.0.0.1,::1
COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200

BOOTSTRAP_SOCKET_PATH=/run/adojapan-bootstrap/bootstrap.sock
NODE_PROTOCOL_VERSION=1
# Production requires an immutable image reference ending in @sha256:<64 lowercase hex>.
NODE_AGENT_IMAGE=ghcr.io/andreykutenkikh-byte/restream-node@sha256:REQUIRED_64_HEX_DIGEST
PUBLIC_CONTROL_URL=http://localhost:8000
