def validated_port(raw_value: str) -> int:
    if not re.fullmatch(r"[0-9]{1,5}", raw_value):
        raise ValueError("invalid loopback media port")
    value = int(raw_value)
    if not 1 <= value <= 65535:
        raise ValueError("invalid loopback media port")
    return value


def validated_source_id(raw_value: str) -> str:
    if SOURCE_ID_PATTERN.fullmatch(raw_value) is None:
        raise ValueError("invalid SRT source identity")
    return raw_value


def validated_control_token_path(raw_value: str) -> Path:
    """Accept the production credential or a root-owned self-test work path."""
    if not raw_value:
        return CONTROL_TOKEN_FILE
    if CONTROL_TOKEN_TEST_PATH_PATTERN.fullmatch(raw_value) is None:
        raise ValueError("invalid control credential path")
    return Path(raw_value)


def read_control_token(token_file: Path) -> bytearray:
    """Read a bounded root-owned API credential without following links."""
    try:
        parent = token_file.parent.lstat()
        before = token_file.lstat()
    except OSError as exc:
        raise ValueError("control credential unavailable") from exc
    if (
        not stat.S_ISDIR(parent.st_mode)
        or parent.st_uid != 0
        or stat.S_IMODE(parent.st_mode) & 0o022
        or stat.S_ISLNK(before.st_mode)
        or not stat.S_ISREG(before.st_mode)
        or before.st_uid != 0
        or before.st_gid != os.getegid()
        or stat.S_IMODE(before.st_mode) not in {0o600, 0o640}
        or before.st_nlink != 1
        or not 43 <= before.st_size <= CONTROL_TOKEN_MAX_FILE_BYTES
    ):
        raise ValueError("control credential unavailable")

    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(token_file, flags)
    except OSError as exc:
        raise ValueError("control credential unavailable") from exc
    payload = bytearray()
    try:
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino)
            or opened.st_uid != before.st_uid
            or opened.st_gid != before.st_gid
            or stat.S_IMODE(opened.st_mode) != stat.S_IMODE(before.st_mode)
            or opened.st_nlink != 1
            or opened.st_size != before.st_size
            or opened.st_mtime_ns != before.st_mtime_ns
            or opened.st_ctime_ns != before.st_ctime_ns
        ):
            raise ValueError("control credential unavailable")
        payload = bytearray(os.read(descriptor, CONTROL_TOKEN_MAX_FILE_BYTES + 1))
        if os.read(descriptor, 1):
            raise ValueError("control credential unavailable")
        after = os.fstat(descriptor)
        if (
            (after.st_dev, after.st_ino, after.st_size)
            != (opened.st_dev, opened.st_ino, opened.st_size)
            or after.st_mtime_ns != opened.st_mtime_ns
            or after.st_ctime_ns != opened.st_ctime_ns
        ):
            raise ValueError("control credential unavailable")
    except (OSError, ValueError) as exc:
        for index in range(len(payload)):
            payload[index] = 0
        raise ValueError("control credential unavailable") from exc
    finally:
        os.close(descriptor)

    if payload.endswith(b"\n"):
        payload.pop()
    if CONTROL_TOKEN_PATTERN.fullmatch(payload) is None:
        for index in range(len(payload)):
            payload[index] = 0
        raise ValueError("control credential unavailable")
    return payload


def kick_srt_source(api_port: int, source_id: str, token_file: Path) -> str:
    """Kick only the hook-bound SRT UUID through the authenticated local API."""
    validated_port(str(api_port))
    validated_source_id(source_id)
    try:
        token = read_control_token(token_file)
    except ValueError:
        return RECOVERY_RESULT_CREDENTIAL

    credentials = bytearray(CONTROL_API_USER.encode("ascii"))
    credentials.extend(b":")
    credentials.extend(token)
    authorization = ""
    connection: http.client.HTTPConnection | None = None
    try:
        authorization = "Basic " + base64.b64encode(credentials).decode("ascii")
        connection = http.client.HTTPConnection(
            "127.0.0.1",
            api_port,
            timeout=CONTROL_API_REQUEST_TIMEOUT_SECONDS,
        )
        connection.request(
            "POST",
            CONTROL_API_KICK_PATH_PREFIX + source_id,
            body=b"",
            headers={
                "Accept": "application/json",
                "Authorization": authorization,
                "Connection": "close",
                "Content-Length": "0",
            },
        )
        response = connection.getresponse()
        payload = response.read(CONTROL_API_RESPONSE_LIMIT_BYTES + 1)
        if len(payload) > CONTROL_API_RESPONSE_LIMIT_BYTES:
            return RECOVERY_RESULT_RESPONSE
        if response.status == 200:
            return RECOVERY_RESULT_KICKED
        if response.status == 404:
            return RECOVERY_RESULT_GONE
        return RECOVERY_RESULT_REJECTED
    except (OSError, TimeoutError, http.client.HTTPException):
        return RECOVERY_RESULT_TRANSPORT
    finally:
        authorization = ""
        for buffer in (credentials, token):
            for index in range(len(buffer)):
                buffer[index] = 0
        if connection is not None:
            connection.close()


class RecoveryCircuitBreaker:
    """Bound recovery attempts for one hook-bound SRT publisher."""

    def __init__(self, source_id: str) -> None:
        self.source_id = validated_source_id(source_id)
        self.failures: deque[tuple[float, str]] = deque(maxlen=RECOVERY_FAILURE_THRESHOLD)
        self.opened = False
        self.completed = False
        self.exhausted = False
        self.attempts = 0
        self.next_attempt_at = 0.0
        self.reason = ""
        self.confirmed_counter: int | None = None
        self.pre_reset_observations = 0

    def record_failure(self, reason: str, now: float) -> bool:
        """Return true only when this observation opens the breaker."""
        if reason not in RESTART_LOG_TOKENS or not math.isfinite(now):
            raise ValueError("invalid source recovery observation")
        if self.opened or reason not in SOURCE_RESET_ELIGIBLE_REASONS:
            return False
        while self.failures and now - self.failures[0][0] > RECOVERY_FAILURE_WINDOW_SECONDS:
            self.failures.popleft()
        if self.failures and now < self.failures[-1][0]:
            self.failures.clear()
        self.failures.append((now, reason))
        if len(self.failures) < RECOVERY_FAILURE_THRESHOLD:
            return False
        self.opened = True
        self.reason = reason
        self.next_attempt_at = now
        return True

    def should_attempt(self, now: float) -> bool:
        if not math.isfinite(now):
            raise ValueError("invalid source recovery observation")
        return (
            self.opened
            and not self.completed
            and not self.exhausted
            and self.attempts < RECOVERY_MAX_API_ATTEMPTS
            and self.reason == RESTART_REASON_INGEST_CONFIRMED_STALL
            and self.confirmed_counter is not None
            and self.pre_reset_observations >= RECOVERY_PRE_RESET_REQUIRED_OBSERVATIONS
            and now >= self.next_attempt_at
        )

    def open_after_confirmed_input_stall(self, counter: int, now: float) -> bool:
        """Open immediately after one continuously verified, prolonged stall."""
        if isinstance(counter, bool) or not isinstance(counter, int) or counter < 0:
            raise ValueError("invalid source recovery counter")
        if not math.isfinite(now):
            raise ValueError("invalid source recovery observation")
        if self.opened or self.completed or self.exhausted:
            return False
        self.failures.clear()
        self.opened = True
        self.reason = RESTART_REASON_INGEST_CONFIRMED_STALL
        self.confirmed_counter = counter
        self.pre_reset_observations = 0
        self.next_attempt_at = max(
            self.next_attempt_at,
            now + RECOVERY_PRE_RESET_CONFIRMATION_SECONDS,
        )
        return True

    def observe_before_reset(
        self,
        successful: bool,
        sample: CounterSample | None,
        now: float,
    ) -> str:
        """Require consecutive fresh exact-source samples immediately before POST."""
        if not math.isfinite(now):
            raise ValueError("invalid source recovery observation")
        if not self.opened or self.completed or self.confirmed_counter is None:
            raise ValueError("unexpected source recovery proof")
        if not successful or sample is None:
            self.pre_reset_observations = 0
            return RECOVERY_PREFLIGHT_INVALID

        connection_id, counter = sample
        if (
            connection_id != self.source_id
            or isinstance(counter, bool)
            or not isinstance(counter, int)
            or counter < self.confirmed_counter
        ):
            self.pre_reset_observations = 0
            return RECOVERY_PREFLIGHT_INVALID
        if counter > self.confirmed_counter:
            self.pre_reset_observations = 0
            return RECOVERY_PREFLIGHT_RESUMED

        self.pre_reset_observations = min(
            RECOVERY_PRE_RESET_REQUIRED_OBSERVATIONS,
            self.pre_reset_observations + 1,
        )
        if self.pre_reset_observations >= RECOVERY_PRE_RESET_REQUIRED_OBSERVATIONS:
            return RECOVERY_PREFLIGHT_READY
        return RECOVERY_PREFLIGHT_WAIT

    def record_result(self, result: str, now: float) -> None:
        if result not in RECOVERY_SUCCESS_RESULTS | RECOVERY_FAILURE_RESULTS:
            raise ValueError("invalid source recovery result")
        if not self.should_attempt(now):
            raise ValueError("unexpected source recovery result")
        self.attempts += 1
        if result in RECOVERY_SUCCESS_RESULTS:
            self.completed = True
            return
        self.pre_reset_observations = 0
        if self.attempts >= RECOVERY_MAX_API_ATTEMPTS:
            self.exhausted = True
            return
        self.next_attempt_at = now + RECOVERY_RETRY_COOLDOWN_SECONDS

    def cancel_after_source_resumed(self) -> bool:
        """Cancel pending recovery as soon as exact-source media grows."""
        if self.completed or not (
            self.opened
            or self.exhausted
            or self.attempts > 0
            or self.confirmed_counter is not None
        ):
            return False
        self.failures.clear()
        self.opened = False
        self.exhausted = False
        self.attempts = 0
        self.next_attempt_at = 0.0
        self.reason = ""
        self.confirmed_counter = None
        self.pre_reset_observations = 0
        return True

    def source_has_resumed(self, sample: CounterSample) -> bool:
        """Compare a fresh exact-source sample with the last proven stall."""
        connection_id, counter = sample
        if (
            connection_id != self.source_id
            or isinstance(counter, bool)
            or not isinstance(counter, int)
            or counter < 0
        ):
            return False
        return self.confirmed_counter is not None and counter > self.confirmed_counter

    def invalidate_unverified_source(self) -> bool:
        """Close this proof without restoring API budget or retrying blindly."""
        if not self.opened or self.completed:
            return False
        self.opened = False
        self.reason = ""
        # Retain the last stalled counter only as a recovery baseline. A later
        # exact-source increase can still restore LIVE immediately, but another
        # POST requires a brand-new six-second ConfirmedInputStallGate proof.
        self.pre_reset_observations = 0
        return True


def build_ingest_metrics_path(source_id: str) -> str:
    return INGEST_METRICS_PATH_PREFIX + validated_source_id(source_id)


def build_ffmpeg_argv(rtsp_port: int, rtmp_port: int) -> list[str]:
    if not 1 <= rtsp_port <= 65535 or not 1 <= rtmp_port <= 65535:
        raise ValueError("invalid loopback media port")
    return [
        FFMPEG,
        "-nostdin",
        "-hide_banner",
        "-nostats",
        "-loglevel",
        "error",
        # The FLV muxer hard-fails an H.264 stream-copy packet without PTS.
        # Repair only missing input PTS from an available DTS, preserving the
        # encoded video and its native timeline instead of using wall-clock
        # timestamps or transcoding.
        "-fflags",
        "+genpts",
        "-rtsp_transport",
        "tcp",
        "-i",
        f"rtsp://127.0.0.1:{rtsp_port}/{INGEST_PATH}",
        "-map",
        "0:v:0",
        "-map",
        "0:a:0",
        "-c:v",
        "copy",
        "-c:a",
        "aac",
        "-profile:a",
        "aac_low",
        "-af",
        "aresample=48000:async=1:first_pts=0",
        "-ar",
        "48000",
        "-ac",
        "2",
        "-b:a",
        "128k",
        "-max_muxing_queue_size",
        "2048",
        "-flush_packets",
        "1",
        "-f",
        "flv",
        f"rtmp://127.0.0.1:{rtmp_port}/{OUTPUT_PATH}",
    ]


def parse_ingest_sample(
    payload: str,
    expected_connection_id: str,
) -> CounterSample | None:
    """Return identity and unique transport bytes for the active SRT publisher."""
    validated_source_id(expected_connection_id)
    matches: list[CounterSample] = []
    for line in payload.splitlines():
        match = SRT_METRIC_PATTERN.fullmatch(line)
        if match is None:
            continue
        labels = {
            item.group(1): item.group(2) for item in LABEL_PATTERN.finditer(match.group("labels"))
        }
        connection_id = labels.get("id", "")
        if (
            connection_id == expected_connection_id
            and labels.get("path") == INGEST_PATH
            and labels.get("state") == "publish"
        ):
            matches.append((connection_id, int(match.group("value"))))
    return matches[0] if len(matches) == 1 else None


def parse_output_sample(payload: str) -> CounterSample | None:
    """Return identity and bytes for the one local normalizer RTMP publisher."""
    matches: list[CounterSample] = []
    for line in payload.splitlines():
        match = RTMP_METRIC_PATTERN.fullmatch(line)
        if match is None:
            continue
        labels = {
            item.group(1): item.group(2) for item in LABEL_PATTERN.finditer(match.group("labels"))
        }
        connection_id = labels.get("id", "")
        if (
            connection_id
            and labels.get("path") == OUTPUT_PATH
            and labels.get("state") == "publish"
            and LOOPBACK_REMOTE_PATTERN.fullmatch(labels.get("remoteAddr", ""))
        ):
            matches.append((connection_id, int(match.group("value"))))
    return matches[0] if len(matches) == 1 else None


class MetricsReader(Generic[T]):
    """Read one fixed loopback metrics view, reusing one HTTP connection."""

    def __init__(
        self,
        port: int,
        path: str,
        parser: Callable[[str], T | None],
    ) -> None:
        self.port = port
        self.path = path
        self.parser = parser
        self.connection: http.client.HTTPConnection | None = None

    def close(self) -> None:
        if self.connection is not None:
            self.connection.close()
            self.connection = None

    def sample(self) -> tuple[bool, T | None]:
        try:
            if self.connection is None:
                self.connection = http.client.HTTPConnection(
                    "127.0.0.1",
                    self.port,
                    timeout=METRICS_REQUEST_TIMEOUT_SECONDS,
                )
            self.connection.request(
                "GET",
                self.path,
                headers={"Accept": "text/plain", "Connection": "keep-alive"},
            )
            response = self.connection.getresponse()
            payload = response.read(METRICS_RESPONSE_LIMIT_BYTES + 1)
            if response.status != 200 or len(payload) > METRICS_RESPONSE_LIMIT_BYTES:
                self.close()
                return False, None
            return True, self.parser(payload.decode("ascii", errors="strict"))
        except (OSError, TimeoutError, UnicodeError, http.client.HTTPException):
            self.close()
            return False, None


class GrowthGate:
    """Require repeated counter growth before opening the RTSP/RTMP bridge."""

    def __init__(self) -> None:
        self.previous: int | None = None
        self.growth_observations = 0

    def reset(self) -> None:
        self.previous = None
        self.growth_observations = 0

    def observe(self, counter: int) -> bool:
        if self.previous is None or counter < self.previous:
            self.growth_observations = 0
        elif counter > self.previous:
            self.growth_observations += 1
        self.previous = counter
        return self.growth_observations >= REQUIRED_GROWTH_OBSERVATIONS


class ConnectionGrowthGate:
    """Require repeated counter growth from one stable connection identity."""

    def __init__(self) -> None:
        self.connection_id = ""
        self.gate = GrowthGate()

    def reset(self) -> None:
        self.connection_id = ""
        self.gate.reset()

    def observe(self, sample: CounterSample) -> bool:
        _, confirmed = self.observe_with_progress(sample)
        return confirmed

    def observe_with_progress(self, sample: CounterSample) -> tuple[bool, bool]:
        connection_id, counter = sample
        progressed = (
            connection_id == self.connection_id
            and self.gate.previous is not None
            and counter > self.gate.previous
        )
        if connection_id != self.connection_id:
            self.connection_id = connection_id
            self.gate.reset()
        return progressed, self.gate.observe(counter)


class ConfirmedInputStallGate:
    """Confirm that one exact SRT publisher stayed present without media growth."""

    def __init__(self, source_id: str, counter: int, now: float) -> None:
        self.source_id = validated_source_id(source_id)
        if isinstance(counter, bool) or not isinstance(counter, int) or counter < 0:
            raise ValueError("invalid confirmed input stall counter")
        if not math.isfinite(now):
            raise ValueError("invalid confirmed input stall observation")
        self.counter = counter
        self.idle_since: float | None = now
        self.unchanged_observations = 1

    def reset_confirmation(self) -> None:
        """Discard elapsed proof while retaining the exact source and counter."""
        self.idle_since = None
        self.unchanged_observations = 0

    def observe(
        self,
        successful: bool,
        sample: CounterSample | None,
        now: float,
    ) -> bool:
        """Return true only after continuous valid no-growth proof through the grace."""
        if not math.isfinite(now):
            raise ValueError("invalid confirmed input stall observation")
        if not successful or sample is None:
            self.reset_confirmation()
            return False

        connection_id, counter = sample
        if (
            connection_id != self.source_id
            or isinstance(counter, bool)
            or not isinstance(counter, int)
            or counter < 0
        ):
            self.reset_confirmation()
            return False

        if counter > self.counter:
            # One real media-byte increase is recovery evidence.  Start a new
            # grace from that byte, while the ordinary growth gate remains free
            # to relaunch FFmpeg after its second growth observation.
            self.counter = counter
            self.idle_since = now
            self.unchanged_observations = 0
            return False
        if counter < self.counter:
            # A counter reset is not proof of an idle connection.  Adopt the new
            # baseline and require a complete fresh grace before acting.
            self.counter = counter
            self.idle_since = now
            self.unchanged_observations = 1
            return False

        if self.idle_since is None:
            self.idle_since = now
            self.unchanged_observations = 1
            return False
        self.unchanged_observations += 1
        return (
            now - self.idle_since >= CONFIRMED_INPUT_STALL_GRACE_SECONDS
            and self.unchanged_observations >= CONFIRMED_INPUT_STALL_REQUIRED_OBSERVATIONS
        )


class MediaWatchdog:
    """Fail closed when the normalizer output stalls or metrics become unavailable."""

    def __init__(self, sample: CounterSample, now: float) -> None:
        self.connection_id, self.counter = sample
        self.output_last_growth = now
        self.last_valid_observation = now
        self.output_unchanged_observations = 0
        self.ingest_connection_id = ""
        self.ingest_counter: int | None = None
        self.joint_idle_since: float | None = None
        self.joint_unchanged_observations = 0
        self.failure_reason = ""

    def reject(self, reason: str) -> bool:
        if reason not in RESTART_LOG_TOKENS:
            reason = RESTART_REASON_WATCHDOG_UNKNOWN
        self.failure_reason = reason
        return False

    def reset_joint_idle(self) -> None:
        """Discard non-consecutive proof that both media counters are idle."""
        self.ingest_connection_id = ""
        self.ingest_counter = None
        self.joint_idle_since = None
        self.joint_unchanged_observations = 0

    def observe_output(
        self,
        successful: bool,
        sample: CounterSample | None,
        now: float,
    ) -> tuple[bool, bool]:
        if not successful or sample is None:
            self.reset_joint_idle()
            return (
                (
                    now - self.last_valid_observation < METRICS_BLIND_TIMEOUT_SECONDS
                    or self.reject(RESTART_REASON_METRICS_BLIND)
                ),
                False,
            )
        self.last_valid_observation = now
        connection_id, counter = sample
        if connection_id != self.connection_id:
            return self.reject(RESTART_REASON_OUTPUT_IDENTITY), False
        if counter < self.counter:
            return self.reject(RESTART_REASON_OUTPUT_REGRESSION), False
        if counter > self.counter:
            self.counter = counter
            self.output_last_growth = now
            self.output_unchanged_observations = 0
            self.reset_joint_idle()
            return True, False
        self.output_unchanged_observations += 1
        if (
            now - self.output_last_growth >= OUTPUT_IDLE_FALLBACK_SECONDS
            and self.output_unchanged_observations >= REQUIRED_IDLE_OBSERVATIONS
        ):
            return self.reject(RESTART_REASON_OUTPUT_FALLBACK), False
        return True, True

    def observe_ingest(
        self,
        successful: bool,
        sample: CounterSample | None,
        started_at: float,
        finished_at: float,
    ) -> bool:
        if finished_at < started_at:
            return self.reject(RESTART_REASON_INGEST_TIMING)
        if not successful:
            self.reset_joint_idle()
            return True
        if sample is None:
            return self.reject(RESTART_REASON_INGEST_MISSING)
        connection_id, counter = sample
        if self.ingest_counter is None:
            self.ingest_connection_id = connection_id
            self.ingest_counter = counter
            self.joint_idle_since = finished_at
            self.joint_unchanged_observations = 1
            return True
        if connection_id != self.ingest_connection_id:
            return self.reject(RESTART_REASON_INGEST_IDENTITY)
        if counter < self.ingest_counter:
            return self.reject(RESTART_REASON_INGEST_REGRESSION)
        if counter > self.ingest_counter:
            self.ingest_counter = counter
            self.joint_idle_since = None
            self.joint_unchanged_observations = 0
            return True
        if self.joint_idle_since is None:
            self.joint_idle_since = finished_at
        self.joint_unchanged_observations += 1
        keep_child = (
            started_at - self.joint_idle_since < VERIFIED_STALL_TIMEOUT_SECONDS
            or self.joint_unchanged_observations < REQUIRED_VERIFIED_STALL_OBSERVATIONS
        )
        return keep_child or self.reject(RESTART_REASON_VERIFIED_STALL)


def sanitized_environment(
    rtsp_port: int,
    rtmp_port: int,
    metrics_port: int,
    source_id: str,
    control_api_port: int = DEFAULT_CONTROL_API_PORT,
    control_token_file: Path = CONTROL_TOKEN_FILE,
) -> dict[str, str]:
    environment = {
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/bin:/bin",
        SAFE_RTSP_PORT_ENV: str(rtsp_port),
        SAFE_RTMP_PORT_ENV: str(rtmp_port),
        SAFE_METRICS_PORT_ENV: str(metrics_port),
        SAFE_SOURCE_ID_ENV: validated_source_id(source_id),
    }
    if control_api_port != DEFAULT_CONTROL_API_PORT:
        environment[SAFE_CONTROL_API_PORT_ENV] = str(validated_port(str(control_api_port)))
    if control_token_file != CONTROL_TOKEN_FILE:
        control_token_path = str(control_token_file)
        validated_control_token_path(control_token_path)
        environment[SAFE_CONTROL_TOKEN_FILE_ENV] = control_token_path
    return environment


def make_parent_death_setup(expected_parent_pid: int) -> Callable[[], None]:
    """Build a pre-exec hook that ties FFmpeg lifetime to this supervisor."""
    libc = ctypes.CDLL(None, use_errno=True)

    def arm_parent_death_signal() -> None:
        if libc.prctl(PR_SET_PDEATHSIG, signal.SIGKILL, 0, 0, 0) != 0:
            os._exit(127)
        if os.getppid() != expected_parent_pid:
            os._exit(127)

    return arm_parent_death_signal


def stop_child(child: subprocess.Popen, *, force: bool = False) -> None:
    if child.poll() is not None:
        return
    if force:
        try:
            child.kill()
            child.wait(timeout=CHILD_STOP_GRACE_SECONDS)
        except (ProcessLookupError, subprocess.TimeoutExpired):
            pass
        return
    try:
        child.send_signal(signal.SIGINT)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + CHILD_STOP_GRACE_SECONDS
    while child.poll() is None and time.monotonic() < deadline:
        time.sleep(0.005)
    if child.poll() is None:
        try:
            child.kill()
        except ProcessLookupError:
            return
    try:
        child.wait(timeout=CHILD_STOP_GRACE_SECONDS)
    except subprocess.TimeoutExpired:
        pass


def run_supervisor(
    rtsp_port: int,
    rtmp_port: int,
    metrics_port: int,
    source_id: str,
    control_api_port: int = DEFAULT_CONTROL_API_PORT,
    control_token_file: Path = CONTROL_TOKEN_FILE,
) -> int:
    stop_requested = False

    def request_stop(_signum: int, _frame) -> None:
        nonlocal stop_requested
        stop_requested = True

    for item in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(item, request_stop)

    child_environment = {"LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"}
    argv = build_ffmpeg_argv(rtsp_port, rtmp_port)
    ingest_reader = MetricsReader(
        metrics_port,
        build_ingest_metrics_path(source_id),
        lambda payload: parse_ingest_sample(payload, source_id),
    )
    output_reader = MetricsReader(
        metrics_port,
        OUTPUT_METRICS_PATH,
        parse_output_sample,
    )
    ingest_gate = ConnectionGrowthGate()
    output_gate = ConnectionGrowthGate()
    child: subprocess.Popen | None = None
    watchdog: MediaWatchdog | None = None
    child_started = 0.0
    restart_not_before = 0.0
    recovery = RecoveryCircuitBreaker(source_id)
    confirmed_input_stall: ConfirmedInputStallGate | None = None
    source_attached_emitted = False

    try:
        while not stop_requested:
            now = time.monotonic()
            if child is not None and child.poll() is not None:
                emit_restart_reason(RESTART_REASON_CHILD_EXIT)
                recovery.record_failure(RESTART_REASON_CHILD_EXIT, now)
                child = None
                watchdog = None
                ingest_gate.reset()
                restart_not_before = now + CHILD_RESTART_FLOOR_SECONDS

            if recovery.opened:
                if child is not None:
                    stop_child(child, force=True)
                    child = None
                watchdog = None
                ingest_gate.reset()
                output_gate.reset()
                output_reader.close()
                if recovery.completed:
                    # Keep the hook alive and fail closed.  Exiting would make
                    # runOnAvailableRestart construct a fresh breaker and turn
                    # this terminal state into an unnecessary restart race or
                    # turn bounded API failures into an unbounded retry storm.
                    ingest_reader.close()
                    time.sleep(RECOVERY_WAIT_POLL_SECONDS)
                    continue
                # Re-check the exact hook-bound source immediately before every
                # POST. Two fresh, unchanged observations authorize the request;
                # any growth cancels it, while missing/untrusted metrics discard
                # the entire six-second proof.
                ingest_successful, ingest_sample = ingest_reader.sample()
                proof = recovery.observe_before_reset(
                    ingest_successful,
                    ingest_sample,
                    time.monotonic(),
                )
                if proof == RECOVERY_PREFLIGHT_INVALID:
                    recovery.invalidate_unverified_source()
                    confirmed_input_stall = None
                    ingest_gate.reset()
                    time.sleep(MEDIA_POLL_INTERVAL_SECONDS)
                    continue
                if proof == RECOVERY_PREFLIGHT_RESUMED:
                    if recovery.cancel_after_source_resumed():
                        emit_recovery_event(RECOVERY_EVENT_SOURCE_RESUMED)
                    confirmed_input_stall = None
                    ingest_gate.reset()
                    if ingest_sample is not None:
                        ingest_gate.observe(ingest_sample)
                    restart_not_before = time.monotonic()
                    continue
                now = time.monotonic()
                if proof == RECOVERY_PREFLIGHT_READY and recovery.should_attempt(now):
                    result = kick_srt_source(
                        control_api_port,
                        source_id,
                        control_token_file,
                    )
                    emit_recovery_event(result)
                    recovery.record_result(result, now)
                    if recovery.exhausted:
                        emit_recovery_event(RECOVERY_EVENT_EXHAUSTED)
                    if recovery.completed:
                        continue
                if recovery.exhausted:
                    # Attempts remain bounded, but a later proven recovery of
                    # this exact source is still allowed to reopen the bridge.
                    time.sleep(RECOVERY_WAIT_POLL_SECONDS)
                    continue
                wait_seconds = max(
                    MEDIA_POLL_INTERVAL_SECONDS,
                    min(
                        RECOVERY_WAIT_POLL_SECONDS,
                        recovery.next_attempt_at - time.monotonic(),
                    ),
                )
                time.sleep(wait_seconds)
                continue

            if child is None:
                successful, ingest_sample = ingest_reader.sample()
                now = time.monotonic()
                progressed = False
                growth_confirmed = False
                if successful and ingest_sample is not None:
                    progressed, growth_confirmed = ingest_gate.observe_with_progress(
                        ingest_sample
                    )
                    if (
                        recovery.source_has_resumed(ingest_sample) or progressed
                    ) and recovery.cancel_after_source_resumed():
                        emit_recovery_event(RECOVERY_EVENT_SOURCE_RESUMED)
                        confirmed_input_stall = None
                else:
                    ingest_gate.reset()
                confirmed_stall_detected = False
                if recovery.exhausted:
                    confirmed_input_stall = None
                elif confirmed_input_stall is None:
                    if successful and ingest_sample is not None:
                        confirmed_input_stall = ConfirmedInputStallGate(
                            source_id,
                            ingest_sample[1],
                            now,
                        )
                else:
                    confirmed_stall_detected = confirmed_input_stall.observe(
                        successful,
                        ingest_sample,
                        now,
                    )
                if confirmed_stall_detected:
                    confirmed_counter = confirmed_input_stall.counter
                    if recovery.open_after_confirmed_input_stall(
                        confirmed_counter,
                        now,
                    ):
                        emit_restart_reason(RESTART_REASON_INGEST_CONFIRMED_STALL)
                        emit_recovery_event(RECOVERY_EVENT_THRESHOLD)
                    confirmed_input_stall = None
                    ingest_gate.reset()
                    time.sleep(MEDIA_POLL_INTERVAL_SECONDS)
                    continue
                if successful:
                    if ingest_sample is None:
                        ingest_gate.reset()
                    else:
                        if not source_attached_emitted:
                            emit_state_event(STATE_EVENT_SOURCE_ATTACHED)
                            source_attached_emitted = True
                    if (
                        ingest_sample is not None
                        and growth_confirmed
                        and now >= restart_not_before
                    ):
                        supervisor_pid = os.getpid()
                        parent_death_setup = make_parent_death_setup(supervisor_pid)
                        try:
                            child = subprocess.Popen(
                                argv,
                                stdin=subprocess.DEVNULL,
                                env=child_environment,
                                close_fds=True,
                                preexec_fn=parent_death_setup,
                            )
                        except (OSError, subprocess.SubprocessError):
                            return 1
                        child_started = now
                        watchdog = None
                        confirmed_input_stall = None
                        output_gate.reset()
                else:
                    ingest_gate.reset()
                time.sleep(MEDIA_POLL_INTERVAL_SECONDS)
                continue

            successful, counter = output_reader.sample()
            now = time.monotonic()
            if watchdog is None:
                if successful and counter is not None and output_gate.observe(counter):
                    watchdog = MediaWatchdog(counter, now)
                    emit_state_event(STATE_EVENT_BRIDGE_ACTIVE)
                    ingest_reader.close()
                elif now - child_started >= OUTPUT_START_TIMEOUT_SECONDS:
                    emit_restart_reason(RESTART_REASON_OUTPUT_START_TIMEOUT)
                    recovery.record_failure(RESTART_REASON_OUTPUT_START_TIMEOUT, now)
                    stop_child(child, force=True)
                    child = None
                    ingest_gate.reset()
                    restart_not_before = now + CHILD_RESTART_FLOOR_SECONDS
                time.sleep(MEDIA_POLL_INTERVAL_SECONDS)
                continue

            keep_child, probe_ingest = watchdog.observe_output(successful, counter, now)
            if not probe_ingest:
                ingest_reader.close()
            if keep_child and probe_ingest:
                ingest_started = time.monotonic()
                ingest_successful, ingest_sample = ingest_reader.sample()
                ingest_finished = time.monotonic()
                keep_child = watchdog.observe_ingest(
                    ingest_successful,
                    ingest_sample,
                    ingest_started,
                    ingest_finished,
                )
            if not keep_child:
                failure_reason = watchdog.failure_reason or RESTART_REASON_WATCHDOG_UNKNOWN
                emit_restart_reason(failure_reason)
                recovery.record_failure(failure_reason, now)
                if (
                    failure_reason == RESTART_REASON_VERIFIED_STALL
                    and watchdog.ingest_connection_id == source_id
                    and watchdog.ingest_counter is not None
                ):
                    confirmed_input_stall = ConfirmedInputStallGate(
                        source_id,
                        watchdog.ingest_counter,
                        time.monotonic(),
                    )
                else:
                    confirmed_input_stall = None
                ingest_reader.close()
                stop_child(child, force=True)
                child = None
                watchdog = None
                ingest_gate.reset()
                restart_not_before = time.monotonic() + CHILD_RESTART_FLOOR_SECONDS
            time.sleep(MEDIA_POLL_INTERVAL_SECONDS)
        return 0
    finally:
        ingest_reader.close()
        output_reader.close()
        if child is not None:
            stop_child(child)
        if stop_requested and source_attached_emitted:
            emit_state_event(STATE_EVENT_SOURCE_DETACHED)


def main() -> int:
    if sys.argv[1:] == [SUPERVISOR_ARGUMENT]:
        try:
            rtsp_port = validated_port(os.environ.get(SAFE_RTSP_PORT_ENV, ""))
            rtmp_port = validated_port(os.environ.get(SAFE_RTMP_PORT_ENV, ""))
            metrics_port = validated_port(os.environ.get(SAFE_METRICS_PORT_ENV, ""))
            source_id = validated_source_id(os.environ.get(SAFE_SOURCE_ID_ENV, ""))
            control_api_port = validated_port(
                os.environ.get(
                    SAFE_CONTROL_API_PORT_ENV,
                    str(DEFAULT_CONTROL_API_PORT),
                )
            )
            control_token_file = validated_control_token_path(
                os.environ.get(SAFE_CONTROL_TOKEN_FILE_ENV, "")
            )
        except ValueError:
            return 2
        return run_supervisor(
            rtsp_port,
            rtmp_port,
            metrics_port,
            source_id,
            control_api_port,
            control_token_file,
        )

    if (
        len(sys.argv) != 1
        or os.environ.get("MTX_PATH") != INGEST_PATH
        or os.environ.get("MTX_SOURCE_TYPE") != "srtConn"
    ):
        return 2
    try:
        rtsp_port = validated_port(os.environ.get("RTSP_PORT", ""))
        rtmp_port = validated_port(os.environ.get(TEST_RTMP_PORT_ENV, str(DEFAULT_RTMP_PORT)))
        metrics_port = validated_port(
            os.environ.get(TEST_METRICS_PORT_ENV, str(DEFAULT_METRICS_PORT))
        )
        source_id = validated_source_id(os.environ.get("MTX_SOURCE_ID", ""))
        control_api_port = validated_port(
            os.environ.get(
                TEST_CONTROL_API_PORT_ENV,
                str(DEFAULT_CONTROL_API_PORT),
            )
        )
        control_token_file = validated_control_token_path(
            os.environ.get(TEST_CONTROL_TOKEN_FILE_ENV, "")
        )
    except ValueError:
        return 2

    # Re-exec first: the long-lived supervisor must not retain publisher-controlled
    # MediaMTX hook metadata (including MTX_QUERY) anywhere in /proc.
    environment = sanitized_environment(
        rtsp_port,
        rtmp_port,
        metrics_port,
        source_id,
        control_api_port,
        control_token_file,
    )
    script = os.path.realpath(__file__)
    try:
        os.execve(PYTHON, [PYTHON, "-I", script, SUPERVISOR_ARGUMENT], environment)
    except OSError:
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
