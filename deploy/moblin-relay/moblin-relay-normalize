#!/usr/bin/python3
"""Supervise the local Moblin audio normalizer without retaining SRT secrets."""

from __future__ import annotations

import ctypes
import http.client
import os
import re
import signal
import subprocess
import sys
import time
from collections.abc import Callable
from typing import Generic, TypeVar


PYTHON = "/usr/bin/python3"
FFMPEG = "/usr/bin/ffmpeg"
INGEST_PATH = "iphone-live"
OUTPUT_PATH = "relay-output"
DEFAULT_RTMP_PORT = 1935
DEFAULT_METRICS_PORT = 9998
TEST_RTMP_PORT_ENV = "MOBLIN_RELAY_OUTPUT_RTMP_PORT"
TEST_METRICS_PORT_ENV = "MOBLIN_RELAY_METRICS_PORT"
SAFE_RTSP_PORT_ENV = "MOBLIN_RELAY_INTERNAL_RTSP_PORT"
SAFE_RTMP_PORT_ENV = "MOBLIN_RELAY_INTERNAL_RTMP_PORT"
SAFE_METRICS_PORT_ENV = "MOBLIN_RELAY_INTERNAL_METRICS_PORT"
SUPERVISOR_ARGUMENT = "--sanitized-supervisor"
INGEST_METRICS_PATH = f"/metrics?type=paths&path={INGEST_PATH}"
OUTPUT_METRICS_PATH = "/metrics?type=rtmp_conns"
METRICS_RESPONSE_LIMIT_BYTES = 65_536
METRICS_REQUEST_TIMEOUT_SECONDS = 0.2
MEDIA_POLL_INTERVAL_SECONDS = 0.05
# The runner and small VPS targets can occasionally pause a userspace process for
# well over 100 ms.  Keep the watchdog comfortably below the 4.5 s failover
# budget without treating one scheduler/metrics hiccup as a dead media path.
MEDIA_IDLE_TIMEOUT_SECONDS = 0.5
METRICS_BLIND_TIMEOUT_SECONDS = 0.75
OUTPUT_START_TIMEOUT_SECONDS = 6.0
CHILD_STOP_GRACE_SECONDS = 0.025
CHILD_RESTART_FLOOR_SECONDS = 0.1
REQUIRED_GROWTH_OBSERVATIONS = 2
PR_SET_PDEATHSIG = 1

PATH_METRIC_PATTERN = re.compile(
    r'^paths_inbound_bytes\{(?P<labels>[^{}]*)\}\s+(?P<value>[0-9]+)$'
)
RTMP_METRIC_PATTERN = re.compile(
    r'^rtmp_conns_inbound_bytes\{(?P<labels>[^{}]*)\}\s+(?P<value>[0-9]+)$'
)
LABEL_PATTERN = re.compile(r'(\w+)="([^"\\]*)"(?:,|$)')
LOOPBACK_REMOTE_PATTERN = re.compile(r"127\.0\.0\.1:[0-9]{1,5}")
CounterSample = tuple[str, int]
T = TypeVar("T")


def validated_port(raw_value: str) -> int:
    if not re.fullmatch(r"[0-9]{1,5}", raw_value):
        raise ValueError("invalid loopback media port")
    value = int(raw_value)
    if not 1 <= value <= 65535:
        raise ValueError("invalid loopback media port")
    return value


def build_ffmpeg_argv(rtsp_port: int, rtmp_port: int) -> list[str]:
    if not 1 <= rtsp_port <= 65535 or not 1 <= rtmp_port <= 65535:
        raise ValueError("invalid loopback media port")
    return [
        FFMPEG,
        "-nostdin",
        "-hide_banner",
        "-nostats",
        "-loglevel",
        "error",
        "-rtsp_transport",
        "tcp",
        "-i",
        f"rtsp://127.0.0.1:{rtsp_port}/{INGEST_PATH}",
        "-map",
        "0:v:0",
        "-map",
        "0:a:0",
        "-c:v",
        "copy",
        "-c:a",
        "aac",
        "-profile:a",
        "aac_low",
        "-af",
        "aresample=48000:async=1:first_pts=0",
        "-ar",
        "48000",
        "-ac",
        "2",
        "-b:a",
        "128k",
        "-max_muxing_queue_size",
        "2048",
        "-f",
        "flv",
        f"rtmp://127.0.0.1:{rtmp_port}/{OUTPUT_PATH}",
    ]


def parse_inbound_bytes(payload: str) -> int | None:
    """Return the one exact ready-path byte counter from a filtered response."""
    matches: list[int] = []
    for line in payload.splitlines():
        match = PATH_METRIC_PATTERN.fullmatch(line)
        if match is None:
            continue
        labels = {
            item.group(1): item.group(2)
            for item in LABEL_PATTERN.finditer(match.group("labels"))
        }
        if labels == {"name": INGEST_PATH, "state": "ready"}:
            matches.append(int(match.group("value")))
    return matches[0] if len(matches) == 1 else None


def parse_output_sample(payload: str) -> CounterSample | None:
    """Return identity and bytes for the one local normalizer RTMP publisher."""
    matches: list[CounterSample] = []
    for line in payload.splitlines():
        match = RTMP_METRIC_PATTERN.fullmatch(line)
        if match is None:
            continue
        labels = {
            item.group(1): item.group(2)
            for item in LABEL_PATTERN.finditer(match.group("labels"))
        }
        connection_id = labels.get("id", "")
        if (
            connection_id
            and labels.get("path") == OUTPUT_PATH
            and labels.get("state") == "publish"
            and LOOPBACK_REMOTE_PATTERN.fullmatch(labels.get("remoteAddr", ""))
        ):
            matches.append((connection_id, int(match.group("value"))))
    return matches[0] if len(matches) == 1 else None


class MetricsReader(Generic[T]):
    """Read one fixed loopback metrics view, reusing one HTTP connection."""

    def __init__(
        self,
        port: int,
        path: str,
        parser: Callable[[str], T | None],
    ) -> None:
        self.port = port
        self.path = path
        self.parser = parser
        self.connection: http.client.HTTPConnection | None = None

    def close(self) -> None:
        if self.connection is not None:
            self.connection.close()
            self.connection = None

    def sample(self) -> tuple[bool, T | None]:
        try:
            if self.connection is None:
                self.connection = http.client.HTTPConnection(
                    "127.0.0.1",
                    self.port,
                    timeout=METRICS_REQUEST_TIMEOUT_SECONDS,
                )
            self.connection.request(
                "GET",
                self.path,
                headers={"Accept": "text/plain", "Connection": "keep-alive"},
            )
            response = self.connection.getresponse()
            payload = response.read(METRICS_RESPONSE_LIMIT_BYTES + 1)
            if response.status != 200 or len(payload) > METRICS_RESPONSE_LIMIT_BYTES:
                self.close()
                return False, None
            return True, self.parser(payload.decode("ascii", errors="strict"))
        except (OSError, TimeoutError, UnicodeError, http.client.HTTPException):
            self.close()
            return False, None


class GrowthGate:
    """Require repeated counter growth before opening the RTSP/RTMP bridge."""

    def __init__(self) -> None:
        self.previous: int | None = None
        self.growth_observations = 0

    def reset(self) -> None:
        self.previous = None
        self.growth_observations = 0

    def observe(self, counter: int) -> bool:
        if self.previous is None or counter <= self.previous:
            self.growth_observations = 0
        else:
            self.growth_observations += 1
        self.previous = counter
        return self.growth_observations >= REQUIRED_GROWTH_OBSERVATIONS


class OutputGrowthGate:
    """Arm output monitoring only after one RTMP publisher repeatedly grows."""

    def __init__(self) -> None:
        self.connection_id = ""
        self.gate = GrowthGate()

    def reset(self) -> None:
        self.connection_id = ""
        self.gate.reset()

    def observe(self, sample: CounterSample) -> bool:
        connection_id, counter = sample
        if connection_id != self.connection_id:
            self.connection_id = connection_id
            self.gate.reset()
        return self.gate.observe(counter)


class MediaWatchdog:
    """Fail closed when the normalizer output stalls or metrics become unavailable."""

    def __init__(self, sample: CounterSample, now: float) -> None:
        self.connection_id, self.counter = sample
        self.last_growth = now
        self.last_valid_observation = now

    def observe(
        self,
        successful: bool,
        sample: CounterSample | None,
        now: float,
    ) -> bool:
        if not successful or sample is None:
            return now - self.last_valid_observation < METRICS_BLIND_TIMEOUT_SECONDS
        self.last_valid_observation = now
        connection_id, counter = sample
        if connection_id != self.connection_id:
            return False
        if counter < self.counter:
            return False
        if counter > self.counter:
            self.counter = counter
            self.last_growth = now
        return now - self.last_growth < MEDIA_IDLE_TIMEOUT_SECONDS


def sanitized_environment(rtsp_port: int, rtmp_port: int, metrics_port: int) -> dict[str, str]:
    return {
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/bin:/bin",
        SAFE_RTSP_PORT_ENV: str(rtsp_port),
        SAFE_RTMP_PORT_ENV: str(rtmp_port),
        SAFE_METRICS_PORT_ENV: str(metrics_port),
    }


def make_parent_death_setup(expected_parent_pid: int) -> Callable[[], None]:
    """Build a pre-exec hook that ties FFmpeg lifetime to this supervisor."""
    libc = ctypes.CDLL(None, use_errno=True)

    def arm_parent_death_signal() -> None:
        if libc.prctl(PR_SET_PDEATHSIG, signal.SIGKILL, 0, 0, 0) != 0:
            os._exit(127)
        if os.getppid() != expected_parent_pid:
            os._exit(127)

    return arm_parent_death_signal


def stop_child(child: subprocess.Popen, *, force: bool = False) -> None:
    if child.poll() is not None:
        return
    if force:
        try:
            child.kill()
            child.wait(timeout=CHILD_STOP_GRACE_SECONDS)
        except (ProcessLookupError, subprocess.TimeoutExpired):
            pass
        return
    try:
        child.send_signal(signal.SIGINT)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + CHILD_STOP_GRACE_SECONDS
    while child.poll() is None and time.monotonic() < deadline:
        time.sleep(0.005)
    if child.poll() is None:
        try:
            child.kill()
        except ProcessLookupError:
            return
    try:
        child.wait(timeout=CHILD_STOP_GRACE_SECONDS)
    except subprocess.TimeoutExpired:
        pass


def run_supervisor(rtsp_port: int, rtmp_port: int, metrics_port: int) -> int:
    stop_requested = False

    def request_stop(_signum: int, _frame) -> None:
        nonlocal stop_requested
        stop_requested = True

    for item in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        signal.signal(item, request_stop)

    child_environment = {"LANG": "C", "LC_ALL": "C", "PATH": "/usr/bin:/bin"}
    argv = build_ffmpeg_argv(rtsp_port, rtmp_port)
    ingest_reader = MetricsReader(
        metrics_port,
        INGEST_METRICS_PATH,
        parse_inbound_bytes,
    )
    output_reader = MetricsReader(
        metrics_port,
        OUTPUT_METRICS_PATH,
        parse_output_sample,
    )
    gate = GrowthGate()
    output_gate = OutputGrowthGate()
    child: subprocess.Popen | None = None
    watchdog: MediaWatchdog | None = None
    child_started = 0.0
    restart_not_before = 0.0

    try:
        while not stop_requested:
            now = time.monotonic()
            if child is not None and child.poll() is not None:
                child = None
                watchdog = None
                gate.reset()
                restart_not_before = now + CHILD_RESTART_FLOOR_SECONDS

            if child is None:
                successful, counter = ingest_reader.sample()
                now = time.monotonic()
                if successful:
                    if counter is None:
                        gate.reset()
                    elif gate.observe(counter) and now >= restart_not_before:
                        supervisor_pid = os.getpid()
                        parent_death_setup = make_parent_death_setup(supervisor_pid)
                        try:
                            child = subprocess.Popen(
                                argv,
                                stdin=subprocess.DEVNULL,
                                env=child_environment,
                                close_fds=True,
                                preexec_fn=parent_death_setup,
                            )
                        except (OSError, subprocess.SubprocessError):
                            return 1
                        child_started = now
                        watchdog = None
                        output_gate.reset()
                else:
                    gate.reset()
                time.sleep(MEDIA_POLL_INTERVAL_SECONDS)
                continue

            successful, counter = output_reader.sample()
            now = time.monotonic()
            if watchdog is None:
                if successful and counter is not None and output_gate.observe(counter):
                    watchdog = MediaWatchdog(counter, now)
                elif now - child_started >= OUTPUT_START_TIMEOUT_SECONDS:
                    stop_child(child, force=True)
                    child = None
                    gate.reset()
                    restart_not_before = now + CHILD_RESTART_FLOOR_SECONDS
                time.sleep(MEDIA_POLL_INTERVAL_SECONDS)
                continue

            if not watchdog.observe(successful, counter, now):
                stop_child(child, force=True)
                child = None
                watchdog = None
                gate.reset()
                restart_not_before = time.monotonic() + CHILD_RESTART_FLOOR_SECONDS
            time.sleep(MEDIA_POLL_INTERVAL_SECONDS)
        return 0
    finally:
        ingest_reader.close()
        output_reader.close()
        if child is not None:
            stop_child(child)


def main() -> int:
    if sys.argv[1:] == [SUPERVISOR_ARGUMENT]:
        try:
            rtsp_port = validated_port(os.environ.get(SAFE_RTSP_PORT_ENV, ""))
            rtmp_port = validated_port(os.environ.get(SAFE_RTMP_PORT_ENV, ""))
            metrics_port = validated_port(os.environ.get(SAFE_METRICS_PORT_ENV, ""))
        except ValueError:
            return 2
        return run_supervisor(rtsp_port, rtmp_port, metrics_port)

    if len(sys.argv) != 1 or os.environ.get("MTX_PATH") != INGEST_PATH:
        return 2
    try:
        rtsp_port = validated_port(os.environ.get("RTSP_PORT", ""))
        rtmp_port = validated_port(
            os.environ.get(TEST_RTMP_PORT_ENV, str(DEFAULT_RTMP_PORT))
        )
        metrics_port = validated_port(
            os.environ.get(TEST_METRICS_PORT_ENV, str(DEFAULT_METRICS_PORT))
        )
    except ValueError:
        return 2

    # Re-exec first: the long-lived supervisor must not retain publisher-controlled
    # MediaMTX hook metadata (including MTX_QUERY) anywhere in /proc.
    environment = sanitized_environment(rtsp_port, rtmp_port, metrics_port)
    script = os.path.realpath(__file__)
    try:
        os.execve(PYTHON, [PYTHON, "-I", script, SUPERVISOR_ARGUMENT], environment)
    except OSError:
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
