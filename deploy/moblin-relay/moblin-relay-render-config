#!/usr/bin/python3
"""Render the secret-bearing MediaMTX runtime config into tmpfs."""

from __future__ import annotations

import base64
import grp
import hashlib
import json
import os
import pwd
import re
import stat
import tempfile
from pathlib import Path
from urllib.parse import urlsplit


SECRET_FILE = Path("/etc/moblin-relay/secrets.json")
PREVIEW_TOKEN_FILE = Path("/etc/adojapan-relay-agent/preview-reader.token")
RUNTIME_DIR = Path("/run/moblin-relay")
RUNTIME_FILE = RUNTIME_DIR / "mediamtx.json"
SLATE_FILE = "/var/lib/moblin-relay/slate.mp4"
NORMALIZER = "/opt/moblin-relay/libexec/moblin-relay-normalize"
INGEST_PATH = "iphone-live"
OUTPUT_PATH = "relay-output"
PREVIEW_USER = "relay-preview"
PREVIEW_TOKEN_PATTERN = re.compile(rb"[A-Za-z0-9._~+/=-]{32,512}\Z")
PREVIEW_TOKEN_MAX_FILE_BYTES = 513


def die(message: str) -> None:
    raise SystemExit(message)


def validate_secret_file() -> dict:
    try:
        parent_stat = SECRET_FILE.parent.lstat()
        st = SECRET_FILE.lstat()
        if (
            not stat.S_ISDIR(parent_stat.st_mode)
            or parent_stat.st_uid != 0
            or parent_stat.st_mode & 0o077
            or not stat.S_ISREG(st.st_mode)
            or st.st_uid != 0
            or st.st_mode & 0o077
        ):
            die("unsafe relay secret file permissions")
        flags = os.O_RDONLY | os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(SECRET_FILE, flags)
        opened_stat = os.fstat(fd)
        if (opened_stat.st_dev, opened_stat.st_ino) != (st.st_dev, st.st_ino):
            os.close(fd)
            die("relay secret file changed while opening")
        with os.fdopen(fd, "r", encoding="utf-8") as fp:
            return json.load(fp)
    except FileNotFoundError:
        die("relay secrets are missing")
    except (OSError, json.JSONDecodeError):
        die("relay secrets are invalid")


def validate_youtube(url: str, key: str) -> None:
    if not url or not key or "#" in url:
        die("YouTube is not configured")
    parsed = urlsplit(url)
    if parsed.scheme.lower() != "rtmps" or not parsed.hostname:
        die("invalid YouTube RTMPS URL")
    if parsed.username is not None or parsed.password is not None or parsed.fragment:
        die("invalid YouTube RTMPS URL")
    if any(ord(ch) < 0x20 or ch.isspace() for ch in url):
        die("invalid YouTube RTMPS URL")
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,256}", key):
        die("invalid YouTube stream key")


def read_preview_token() -> bytes | None:
    """Read the optional agent-owned HLS credential without following links."""

    try:
        PREVIEW_TOKEN_FILE.lstat()
    except FileNotFoundError:
        return None
    except OSError:
        die("preview reader credential is unsafe")

    try:
        parent = PREVIEW_TOKEN_FILE.parent.lstat()
        account = pwd.getpwnam("restream-agent")
    except (KeyError, OSError):
        die("preview reader credential is unsafe")

    if (
        stat.S_ISLNK(parent.st_mode)
        or not stat.S_ISDIR(parent.st_mode)
        or parent.st_uid != 0
        or parent.st_gid != account.pw_gid
        or stat.S_IMODE(parent.st_mode) != 0o750
    ):
        die("preview reader credential is unsafe")

    directory_flags = os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY
    if hasattr(os, "O_NOFOLLOW"):
        directory_flags |= os.O_NOFOLLOW
    try:
        parent_fd = os.open(PREVIEW_TOKEN_FILE.parent, directory_flags)
    except OSError:
        die("preview reader credential is unsafe")
    try:
        opened_parent = os.fstat(parent_fd)
        if (
            not stat.S_ISDIR(opened_parent.st_mode)
            or (opened_parent.st_dev, opened_parent.st_ino)
            != (parent.st_dev, parent.st_ino)
            or opened_parent.st_uid != 0
            or opened_parent.st_gid != account.pw_gid
            or stat.S_IMODE(opened_parent.st_mode) != 0o750
        ):
            die("preview reader credential is unsafe")

        try:
            before = os.stat(
                PREVIEW_TOKEN_FILE.name,
                dir_fd=parent_fd,
                follow_symlinks=False,
            )
        except OSError:
            die("preview reader credential is unsafe")
        if (
            stat.S_ISLNK(before.st_mode)
            or not stat.S_ISREG(before.st_mode)
            or before.st_uid != account.pw_uid
            or before.st_gid != account.pw_gid
            or stat.S_IMODE(before.st_mode) != 0o600
            or before.st_nlink != 1
            or not 32 <= before.st_size <= PREVIEW_TOKEN_MAX_FILE_BYTES
        ):
            die("preview reader credential is unsafe")

        flags = os.O_RDONLY | os.O_CLOEXEC
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        try:
            fd = os.open(PREVIEW_TOKEN_FILE.name, flags, dir_fd=parent_fd)
        except OSError:
            die("preview reader credential is unsafe")
        try:
            opened = os.fstat(fd)
            if (
                not stat.S_ISREG(opened.st_mode)
                or (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino)
                or opened.st_uid != account.pw_uid
                or opened.st_gid != account.pw_gid
                or stat.S_IMODE(opened.st_mode) != 0o600
                or opened.st_nlink != 1
                or opened.st_size != before.st_size
                or opened.st_mtime_ns != before.st_mtime_ns
                or opened.st_ctime_ns != before.st_ctime_ns
            ):
                die("preview reader credential is unsafe")
            payload = os.read(fd, PREVIEW_TOKEN_MAX_FILE_BYTES + 1)
            if os.read(fd, 1):
                die("preview reader credential is invalid")
            after = os.fstat(fd)
            if (
                (after.st_dev, after.st_ino, after.st_size)
                != (opened.st_dev, opened.st_ino, opened.st_size)
                or after.st_mtime_ns != opened.st_mtime_ns
                or after.st_ctime_ns != opened.st_ctime_ns
            ):
                die("preview reader credential changed while reading")
        finally:
            os.close(fd)
    except OSError:
        die("preview reader credential is unsafe")
    finally:
        os.close(parent_fd)

    if payload.endswith(b"\n"):
        payload = payload[:-1]
    if not PREVIEW_TOKEN_PATTERN.fullmatch(payload):
        die("preview reader credential is invalid")
    return payload


def preview_config(token: bytes | None) -> tuple[dict, dict | None]:
    """Return the conditional HLS config and its least-privilege reader."""

    if token is None:
        return {"hls": False}, None
    password_hash = base64.b64encode(hashlib.sha256(token).digest()).decode("ascii")
    return (
        {
            "hls": True,
            "hlsAddress": "127.0.0.1:8888",
            "hlsEncryption": False,
            "hlsAllowOrigins": [],
            "hlsTrustedProxies": [],
            "hlsAlwaysRemux": False,
            "hlsVariant": "mpegts",
            "hlsSegmentCount": 4,
            "hlsSegmentDuration": "2s",
            "hlsSegmentMaxSize": "3M",
            "hlsDirectory": "",
            "hlsMuxerCloseAfter": "10s",
        },
        {
            "user": PREVIEW_USER,
            "pass": f"sha256:{password_hash}",
            "ips": ["127.0.0.1", "::1"],
            "permissions": [{"action": "read", "path": OUTPUT_PATH}],
        },
    )


def build_runtime_config(
    user: str,
    password: str,
    passphrase: str,
    url: str,
    key: str,
    preview_token: bytes | None,
) -> dict:
    password_hash = base64.b64encode(
        hashlib.sha256(password.encode("utf-8")).digest()
    ).decode("ascii")
    preview_settings, preview_user = preview_config(preview_token)
    auth_users = [
        {
            "user": user,
            "pass": f"sha256:{password_hash}",
            "ips": [],
            "permissions": [{"action": "publish", "path": INGEST_PATH}],
        },
        {
            "user": "any",
            "pass": "",
            "ips": ["127.0.0.1", "::1"],
            "permissions": [
                {"action": "metrics"},
                {"action": "read", "path": INGEST_PATH},
                {"action": "publish", "path": OUTPUT_PATH},
            ],
        },
    ]
    if preview_user is not None:
        auth_users.append(preview_user)
    return {
        "logLevel": "warn",
        "logDestinations": ["stdout"],
        "logStructured": False,
        "dumpPackets": False,
        "readTimeout": "10s",
        "writeTimeout": "10s",
        "writeQueueSize": 1024,
        "authMethod": "internal",
        "authInternalUsers": auth_users,
        "api": False,
        "metrics": True,
        "metricsAddress": "127.0.0.1:9998",
        "pprof": False,
        "playback": False,
        "rtsp": True,
        "rtspAddress": "127.0.0.1:8554",
        "rtspTransports": ["tcp"],
        "rtmp": True,
        "rtmpAddress": "127.0.0.1:1935",
        "rtmpEncryption": "no",
        "webrtc": False,
        "srt": True,
        # Bind IPv4 explicitly.  An unspecified host can resolve to an IPv6-only
        # socket on hosts where IPV6_V6ONLY is enabled, while Moblin connects to
        # the relay by its public IPv4 address.
        "srtAddress": "0.0.0.0:8890",
        "moq": False,
        "paths": {
            INGEST_PATH: {
                "source": "publisher",
                "overridePublisher": False,
                "srtPublishPassphrase": passphrase,
                "runOnAvailable": NORMALIZER,
                "runOnAvailableRestart": True,
            },
            OUTPUT_PATH: {
                "source": "publisher",
                "overridePublisher": False,
                "alwaysAvailable": True,
                "alwaysAvailableFile": SLATE_FILE,
                "forward": [{"dest": f"{url}#{key}"}],
            }
        },
        **preview_settings,
    }


def main() -> None:
    if os.geteuid() != 0:
        die("runtime config renderer must run as root")
    data = validate_secret_file()
    try:
        srt = data["srt"]
        user = srt["user"]
        password = srt["password"]
        passphrase = srt["passphrase"]
        url = data["youtube"]["url"].strip()
        key = data["youtube"]["key"].strip()
    except (KeyError, TypeError, AttributeError):
        die("relay secrets are incomplete")

    if not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", user):
        die("invalid SRT user")
    if not re.fullmatch(r"[A-Za-z0-9_-]{16,128}", password):
        die("invalid SRT password")
    if not re.fullmatch(r"[A-Za-z0-9_-]{10,79}", passphrase):
        die("invalid SRT passphrase")
    validate_youtube(url, key)

    preview_token = read_preview_token()
    config = build_runtime_config(user, password, passphrase, url, key, preview_token)

    relay_gid = grp.getgrnam("moblin-relay").gr_gid
    RUNTIME_DIR.mkdir(mode=0o750, parents=True, exist_ok=True)
    os.chown(RUNTIME_DIR, 0, relay_gid)
    os.chmod(RUNTIME_DIR, 0o750)
    fd, temporary = tempfile.mkstemp(prefix=".mediamtx.", dir=RUNTIME_DIR)
    temporary_path = Path(temporary)
    try:
        os.fchmod(fd, 0o640)
        os.fchown(fd, 0, relay_gid)
        with os.fdopen(fd, "w", encoding="utf-8") as fp:
            json.dump(config, fp, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
            fp.write("\n")
            fp.flush()
            os.fsync(fp.fileno())
        os.replace(temporary_path, RUNTIME_FILE)
        os.chown(RUNTIME_FILE, 0, relay_gid)
        os.chmod(RUNTIME_FILE, 0o640)
        directory_fd = os.open(RUNTIME_DIR, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass


if __name__ == "__main__":
    main()
