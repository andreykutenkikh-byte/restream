def cmd_rollback(args: list[str]) -> int:
    if args != ["--dry-run"]:
        print("Safety gate: only 'relayctl rollback --dry-run' is implemented.", file=sys.stderr)
        print("Ask the owner to authorize an actual rollback.", file=sys.stderr)
        return 2
    print("DRY RUN - no changes will be made")
    print("1. systemctl disable --now moblin-relay.service; abort if it remains active")
    print("2. remove only these relay-owned files:")
    for path in ROLLBACK_FILES:
        print(f"   {path}")
    print("3. remove only these relay-owned generated subtrees after the service is inactive:")
    for path in ROLLBACK_GENERATED_TREES:
        print(f"   {path}")
    print("4. remove these relay-owned directories with rmdir, deepest first, only when empty:")
    for path in ROLLBACK_EMPTY_DIRS:
        print(f"   {path}")
    print("5. systemctl daemon-reload")
    print(
        "6. after verifying no processes or files use it: "
        "userdel moblin-relay; groupdel moblin-relay"
    )
    print("7. retain every baseline backup under /var/lib/moblin-relay/backups/")
    print("8. pre-existing files to restore: none")
    print("9. ffmpeg and shared package dependencies are not removed automatically")
    print("10. no firewall deletion: no moblin-relay firewall rule was added")
    print("11. Amnezia, Docker, routes, NAT and existing firewall rules remain untouched")
    return 0


def usage() -> None:
    print("Usage: sudo relayctl <command>")
    print("Commands: configure-youtube, start, stop, status, health, incidents, logs,")
    print("          self-test, show-moblin-url, rollback --dry-run")


def main() -> int:
    require_root()
    if len(sys.argv) < 2:
        usage()
        return 2
    command, args = sys.argv[1], sys.argv[2:]
    if command in ("configure-youtube", "set-youtube-key") and not args:
        return cmd_configure_youtube()
    if command == "start" and not args:
        return cmd_start()
    if command == "stop" and not args:
        return cmd_stop()
    if command == "status" and not args:
        return cmd_status()
    if command == "health" and not args:
        return cmd_health()
    if command == "logs" and not args:
        return cmd_logs()
    if command == "incidents" and not args:
        return cmd_incidents()
    if command == "show-moblin-url" and not args:
        return cmd_show_moblin_url()
    if command == "self-test" and not args:
        return cmd_self_test()
    if command == "rollback":
        return cmd_rollback(args)
    usage()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
