        metrics = fetch_metrics(metrics_port)
    except OSError:
        return {
            "metrics_ok": False,
            "path_ready": False,
            "forward_state": "unknown",
        }
    return parse_source_helper_status(metrics)


def same_session_recovery_failure_stage(
    samples: list[dict],
    expected_ingest_ids: list[str],
    baseline_ingest_bytes: int,
    baseline_timestamp: float,
    helper_status: dict,
) -> str:
    """Classify a failed recovery without returning metrics values or identities."""
    if not helper_status.get("metrics_ok"):
        return "stall-h-blind"
    if not helper_status.get("path_ready"):
        return "stall-h-path"
    helper_state = helper_status.get("forward_state")
    if helper_state == "error":
        return "stall-h-error"
    if helper_state != "forwarding":
        return "stall-h-state"

    complete = [sample for sample in samples if complete_metrics_sample(sample)]
    try:
        complete.sort(key=lambda sample: float(sample["t"]))
    except (KeyError, TypeError, ValueError):
        return "stall-blind"
    if not complete:
        return "stall-blind"

    for sample in complete:
        ingest_ids = sample.get("ingest_ids")
        if not isinstance(ingest_ids, list):
            return "stall-blind"
        if ingest_ids and ingest_ids != expected_ingest_ids:
            return "stall-id-rec"
    if any(not sample.get("ingest_live") or not sample.get("ingest_ids") for sample in complete):
        return "stall-i-off"

    previous_bytes = baseline_ingest_bytes
    last_growth = baseline_timestamp
    for sample in complete:
        ingest_bytes = sample.get("ingest_bytes")
        if type(ingest_bytes) is not int or ingest_bytes < previous_bytes:
            return "stall-blind"
        if ingest_bytes > previous_bytes:
            previous_bytes = ingest_bytes
            last_growth = float(sample["t"])
    latest = complete[-1]
    if (
        previous_bytes <= baseline_ingest_bytes
        or float(latest["t"]) - last_growth > CAPTURE_NO_GROWTH_LIMIT_SECONDS
    ):
        return "stall-i-byte"

    if not latest.get("normalized") or len(latest.get("normalized_ids", [])) != 1:
        return "stall-norm"
    if not latest.get("path_ready") or not sink_delivery_active(latest):
        return "stall-sink"
    return "stall-live"


def open_validated_log_tail(
    path: Path,
    writer_descriptor: int,
    work: Path,
    expected_uid: int,
) -> tuple[int, int]:
    work_resolved = validate_workdir(work)
    path_metadata = os.lstat(path)
    if (
        not stat.S_ISREG(path_metadata.st_mode)
        or stat.S_ISLNK(path_metadata.st_mode)
        or path_metadata.st_uid != expected_uid
        or path_metadata.st_nlink != 1
        or path.resolve(strict=True).parent != work_resolved
    ):
        raise TestFailure("unsafe DUT log path")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        writer_metadata = os.fstat(writer_descriptor)
        reader_metadata = os.fstat(descriptor)
        identity = (path_metadata.st_dev, path_metadata.st_ino)
        if (
            not stat.S_ISREG(writer_metadata.st_mode)
            or not stat.S_ISREG(reader_metadata.st_mode)
            or writer_metadata.st_uid != expected_uid
            or reader_metadata.st_uid != expected_uid
            or writer_metadata.st_nlink != 1
            or reader_metadata.st_nlink != 1
            or identity != (writer_metadata.st_dev, writer_metadata.st_ino)
            or identity != (reader_metadata.st_dev, reader_metadata.st_ino)
        ):
            raise TestFailure("DUT log reader does not match its writer")
        return descriptor, reader_metadata.st_size
    except BaseException:
        os.close(descriptor)
        raise


def read_validated_log_tail(
    descriptor: int,
    offset: int,
    expected_uid: int,
) -> bytes:
    if offset < 0:
        raise TestFailure("invalid DUT log tail request")
    metadata = os.fstat(descriptor)
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != expected_uid
        or metadata.st_nlink != 1
        or metadata.st_size < offset
    ):
        raise TestFailure("DUT log changed during publisher exclusivity check")
    tail_size = metadata.st_size - offset
    if tail_size > MAX_REJECTION_LOG_TAIL_BYTES:
        raise TestFailure("DUT log tail exceeded its bounded inspection size")
    os.lseek(descriptor, offset, os.SEEK_SET)
    remaining = tail_size
    chunks: list[bytes] = []
    while remaining:
        chunk = os.read(descriptor, min(remaining, 64 * 1024))
        if not chunk:
            raise TestFailure("DUT log tail could not be read completely")
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def log_tail_contains_marker(
    descriptor: int,
    offset: int,
    marker: bytes,
    expected_uid: int,
) -> bool:
    if not marker or len(marker) > 256:
        raise TestFailure("invalid DUT log marker request")
    return marker in read_validated_log_tail(descriptor, offset, expected_uid)


def wait_log_marker_count(
    descriptor: int,
    offset: int,
    marker: bytes,
    expected_count: int,
    expected_uid: int,
    timeout: float,
) -> int:
    """Wait for a fixed marker without exposing arbitrary child output."""
    if not marker or len(marker) > 256 or expected_count < 1 or timeout < 0:
        raise TestFailure("invalid DUT log marker count request")
    deadline = time.monotonic() + timeout
    while True:
        count = read_validated_log_tail(descriptor, offset, expected_uid).count(marker)
        if count >= expected_count:
            return count
        if time.monotonic() >= deadline:
            raise TestFailure("timed out waiting for a fixed recovery log marker")
        time.sleep(0.025)


def initial_live_log_failure(tail: bytes) -> str | None:
    """Classify only fixed initial-LIVE failures without returning child output."""
    for marker, reason in INITIAL_LIVE_FORBIDDEN_LOG_MARKERS:
        if marker in tail:
            return reason
    return None


def transition_log_failure(tail: bytes) -> str | None:
    """Classify fixed timestamp/mux failures across every relay transition."""
    for marker, reason in TRANSITION_FORBIDDEN_LOG_MARKERS:
        if marker in tail:
            return reason
    return None


def known_forward_dts_marker_count(tail: bytes) -> int:
    """Count only the known native relay-output forward timestamp failure."""
    return sum(
        1
        for line in tail.splitlines()
        if b"[path " + OUTPUT_PATH.encode("ascii") + b"] [forward " in line
        and KNOWN_DTS_REGRESSION_MARKER in line
    )


def require_initial_live_log_clean(
    descriptor: int,
    offset: int,
    expected_uid: int,
) -> None:
    reason = initial_live_log_failure(read_validated_log_tail(descriptor, offset, expected_uid))
    if reason is not None:
        raise TestFailure(f"initial LIVE log gate failed: {reason}")


def wait_initial_live_bridge_active(
    descriptor: int,
    offset: int,
    expected_uid: int,
    timeout: float = INITIAL_LIVE_BRIDGE_ACTIVE_TIMEOUT_SECONDS,
) -> None:
    """Require bridge-active while reporting only fixed secret-free reasons."""
    if timeout < 0:
        raise TestFailure("invalid initial LIVE log gate timeout")
    deadline = time.monotonic() + timeout
    while True:
        tail = read_validated_log_tail(descriptor, offset, expected_uid)
        reason = initial_live_log_failure(tail)
        if reason is not None:
            raise TestFailure(f"initial LIVE log gate failed: {reason}")
        if NORMALIZER_BRIDGE_ACTIVE_MARKER in tail:
            return
        if time.monotonic() >= deadline:
            raise TestFailure("initial LIVE log gate failed: bridge-active-missing")
        time.sleep(0.025)


def classify_normalizer_restart(
    descriptor: int,
    offset: int,
    expected_uid: int,
) -> str:
    """Return only the fixed stage for the latest secret-free restart token."""
    tail = read_validated_log_tail(descriptor, offset, expected_uid)
    latest_position = -1
    latest_stage = "auth-x-norm"
    for marker, stage in NORMALIZER_RESTART_STAGE_MARKERS:
        position = tail.rfind(marker)
        if position > latest_position:
            latest_position = position
            latest_stage = stage
    return latest_stage


def wait_normalizer_restart_stage(
    descriptor: int,
    offset: int,
    expected_uid: int,
    timeout: float = 0.5,
) -> str:
    """Wait briefly for a fixed restart token that may trail connection teardown."""
    deadline = time.monotonic() + max(0.0, timeout)
    while True:
        stage = classify_normalizer_restart(descriptor, offset, expected_uid)
        if stage != "auth-x-norm" or time.monotonic() >= deadline:
            return stage
        time.sleep(0.025)


def publisher_exclusivity_sample_problem(
    sample: dict,
    initial_ingest_ids: list[str],
    initial_normalized_ids: list[str],
    initial_sink_id: str,
    initial_ingest_bytes: int,
) -> str | None:
    ingest_bytes = sample.get("ingest_bytes")
    if sample.get("ingest_ids") != initial_ingest_ids:
        return "auth-x-ingest"
    if sample.get("normalized_ids") != initial_normalized_ids:
        return "auth-x-norm"
    if sample.get("sink_ids") != [initial_sink_id]:
        return "auth-x-sink"
    if not sample.get("live"):
        return "auth-x-live"
    if type(ingest_bytes) is not int or ingest_bytes < initial_ingest_bytes:
        return "auth-x-bytes"
    return None


def publisher_exclusivity_sample_valid(
    sample: dict,
    initial_ingest_ids: list[str],
    initial_normalized_ids: list[str],
    initial_sink_id: str,
    initial_ingest_bytes: int,
) -> bool:
    return (
        publisher_exclusivity_sample_problem(
            sample,
            initial_ingest_ids,
            initial_normalized_ids,
            initial_sink_id,
            initial_ingest_bytes,
        )
        is None
    )


def publisher_exclusivity_proved(
    samples: list[dict],
    initial_ingest_ids: list[str],
    initial_normalized_ids: list[str],
    initial_sink_id: str,
    initial_ingest_bytes: int,
    second_outbound_bytes: int,
    server_rejection_seen: bool,
) -> bool:
    return bool(
        samples
        and second_outbound_bytes > 0
        and server_rejection_seen
        and all(
            publisher_exclusivity_sample_valid(
                sample,
                initial_ingest_ids,
                initial_normalized_ids,
                initial_sink_id,
                initial_ingest_bytes,
            )
            for sample in samples
        )
        and max(int(sample["ingest_bytes"]) for sample in samples) > initial_ingest_bytes
    )


def wait_helper_path(metrics_port: int, timeout: float = 15.0, health_check=None) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if health_check is not None:
            health_check()
        if helper_path_ready(metrics_port):
            return
        time.sleep(0.1)
    if health_check is not None:
        health_check()
    raise TestFailure("local source helper did not receive its non-secret RTMP input")


def wait_ports_released(ports: tuple[tuple[str, int], ...], timeout: float = 10.0) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if all(port_is_free(kind, port) for kind, port in ports):
            return
        time.sleep(0.1)
    occupied = [f"{kind}/{port}" for kind, port in ports if not port_is_free(kind, port)]
    raise TestFailure("local source helper ports remained open: " + ", ".join(occupied))


def count_video_pts_dts_offset_clusters(
    samples: list[tuple[int, float | None]],
) -> int:
    """Count high-offset runs for diagnostics, not source-switch validation."""

    clusters = 0
    active = False
    normal_run = 0
    for index, offset in samples:
        if index != 0:
            continue
        if offset is None:
            normal_run = 0
            continue
        if offset > VIDEO_NORMAL_REORDER_LIMIT_SECONDS:
            if not active:
                clusters += 1
                active = True
            normal_run = 0
        elif active:
            normal_run += 1
            if normal_run >= VIDEO_REORDER_SETTLE_PACKETS:
                active = False
                normal_run = 0
    return clusters


def analyze_timestamps(capture: Path) -> dict:
    command = [
        str(FFPROBE),
        "-v",
        "error",
        "-show_packets",
        "-show_entries",
        "packet=stream_index,pts_time,dts_time",
        "-of",
        "compact=p=0:nk=0",
        str(capture),
    ]
    process = subprocess.Popen(
        command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
    )
    previous_dts: dict[int, float] = {}
    max_dts_gap: dict[int, float] = {}
    packets: dict[int, int] = {}
    pts_packets: dict[int, int] = {}
    first_dts: dict[int, float] = {}
    pts_values: dict[int, list[float]] = {}
    max_pts_dts_offset: dict[int, float] = {}
    pts_dts_offsets: list[tuple[int, float | None]] = []
    minimum_dts_step: dict[int, float] = {}
    maximum_dts_backward_step: dict[int, float] = {}
    negative_dts_steps: dict[int, int] = {}
    dts_backward_events_beyond_tolerance: dict[int, int] = {}
    strict_dts_monotonic = True
    dts_within_tolerance = True
    assert process.stdout is not None
    for line in process.stdout:
        fields = {}
        for item in line.strip().split("|"):
            if "=" in item:
                key, value = item.split("=", 1)
                fields[key] = value
        if "stream_index" not in fields:
            continue
        try:
            index_match = re.match(r"\d+", fields["stream_index"])
            if not index_match:
                continue
            index = int(index_match.group(0))
        except (ValueError, AttributeError):
            continue
        packets[index] = packets.get(index, 0) + 1
        parsed: dict[str, float] = {}
        for name in ("dts_time", "pts_time"):
            raw = fields.get(name)
            if raw in (None, "N/A"):
                continue
            match = re.match(r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)", raw)
            if match:
                try:
                    parsed[name] = float(match.group(0))
                except ValueError:
                    pass
        dts = parsed.get("dts_time")
        pts = parsed.get("pts_time")
        pts_dts_offsets.append(
            (index, abs(pts - dts) if pts is not None and dts is not None else None)
        )
        if dts is not None:
            first_dts.setdefault(index, dts)
            if index in previous_dts:
                gap = dts - previous_dts[index]
                minimum_dts_step[index] = min(minimum_dts_step.get(index, gap), gap)
                if gap < 0:
                    negative_dts_steps[index] = negative_dts_steps.get(index, 0) + 1
                    maximum_dts_backward_step[index] = max(
                        maximum_dts_backward_step.get(index, 0.0), -gap
                    )
                if gap < -0.000001:
                    strict_dts_monotonic = False
                if gap < -TIMESTAMP_BACKWARD_TOLERANCE_SECONDS:
                    dts_backward_events_beyond_tolerance[index] = (
                        dts_backward_events_beyond_tolerance.get(index, 0) + 1
                    )
                    dts_within_tolerance = False
                max_dts_gap[index] = max(max_dts_gap.get(index, 0.0), gap)
            previous_dts[index] = dts
        if pts is not None:
            pts_packets[index] = pts_packets.get(index, 0) + 1
            pts_values.setdefault(index, []).append(pts)
            if dts is not None:
                offset = abs(pts - dts)
                max_pts_dts_offset[index] = max(max_pts_dts_offset.get(index, 0.0), offset)
    stderr = process.communicate(timeout=30)[1]
    durations = {
        index: previous_dts[index] - first_dts[index]
        for index in first_dts
        if index in previous_dts
    }
    sorted_pts_gaps = {}
    first_pts = {}
    last_pts = {}
    for index, values in pts_values.items():
        ordered = sorted(values)
        first_pts[index] = ordered[0]
        last_pts[index] = ordered[-1]
        sorted_pts_gaps[index] = max(
            (right - left for left, right in zip(ordered, ordered[1:])),
            default=0.0,
        )
    av_difference = (
        abs(durations.get(0, 0.0) - durations.get(1, 0.0))
        if 0 in durations and 1 in durations
        else None
    )
    av_end_difference = (
        abs(last_pts.get(0, 0.0) - last_pts.get(1, 0.0))
        if 0 in last_pts and 1 in last_pts
        else None
    )
    return {
        "ffprobe_exit": process.returncode,
        "strict_dts_monotonic": strict_dts_monotonic,
        "dts_within_tolerance": dts_within_tolerance,
        "dts_backward_tolerance_seconds": TIMESTAMP_BACKWARD_TOLERANCE_SECONDS,
        "minimum_dts_step_seconds": minimum_dts_step,
        "maximum_dts_backward_step_seconds": maximum_dts_backward_step,
        "negative_dts_steps": negative_dts_steps,
        "dts_backward_events_beyond_tolerance": dts_backward_events_beyond_tolerance,
        "pts_present_for_every_packet": all(
            packets.get(index, 0) == pts_packets.get(index, 0) for index in packets
        ),
        "packets": packets,
        "pts_packets": pts_packets,
        "max_dts_gap_seconds": max_dts_gap,
        "max_sorted_pts_gap_seconds": sorted_pts_gaps,
        "max_pts_dts_offset_seconds": max_pts_dts_offset,
        "video_pts_dts_offset_normal_reorder_limit_seconds": VIDEO_NORMAL_REORDER_LIMIT_SECONDS,
        "video_pts_dts_offset_clusters_over_normal_reorder": (
            count_video_pts_dts_offset_clusters(pts_dts_offsets)
        ),
        "first_dts_seconds": first_dts,
        "last_dts_seconds": previous_dts,
        "first_pts_seconds": first_pts,
        "last_pts_seconds": last_pts,
        "stream_durations_seconds": durations,
        "audio_video_duration_difference_seconds": av_difference,
        "audio_video_end_difference_seconds": av_end_difference,
        "stderr_empty": not bool(stderr.strip()),
    }


def analyze_decoded_video_frames(capture: Path) -> dict:
    command = [
        str(FFPROBE),
        "-v",
        "error",
        "-select_streams",
        "v:0",
        "-show_frames",
        "-show_entries",
        "frame=width,height,pix_fmt,key_frame,pict_type,decode_error_flags,"
        "pts_time,pkt_pts_time,best_effort_timestamp_time",
        "-of",
        "compact=p=0:nk=0",
        str(capture),
    ]
    process = subprocess.Popen(
        command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
    )
    frame_count = 0
    dimensions: dict[str, int] = {}
    pixel_formats: dict[str, int] = {}
    decode_error_flags: dict[str, int] = {}
    presentation_timestamps: list[float] = []
    best_effort_timestamps: list[float] = []
    assert process.stdout is not None
    for line in process.stdout:
        fields = {}
        for item in line.strip().split("|"):
            if "=" in item:
                key, value = item.split("=", 1)
                fields[key] = value
        width_match = re.match(r"\d+", fields.get("width", ""))
        height_match = re.match(r"\d+", fields.get("height", ""))
        if not width_match or not height_match:
            continue
        frame_count += 1
        size = f"{int(width_match.group(0))}x{int(height_match.group(0))}"
        dimensions[size] = dimensions.get(size, 0) + 1
        pix_fmt = fields.get("pix_fmt", "missing")
        pixel_formats[pix_fmt] = pixel_formats.get(pix_fmt, 0) + 1
        error_flags = fields.get("decode_error_flags")
        if error_flags not in (None, "0", "0x0"):
            decode_error_flags[error_flags] = decode_error_flags.get(error_flags, 0) + 1
        for fields_in_priority_order, target in (
            (("pts_time", "pkt_pts_time"), presentation_timestamps),
            (("best_effort_timestamp_time",), best_effort_timestamps),
        ):
            timestamp = next(
                (
                    fields.get(field)
                    for field in fields_in_priority_order
                    if fields.get(field) not in (None, "N/A")
                ),
                None,
            )
            if timestamp not in (None, "N/A"):
                match = re.match(r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)", timestamp)
                if match:
                    try:
                        target.append(float(match.group(0)))
                    except ValueError:
                        pass
    stderr = process.communicate(timeout=60)[1]
    required_size = f"{PORTRAIT_WIDTH}x{PORTRAIT_HEIGHT}"
    presentation_steps = [
        right - left for left, right in zip(presentation_timestamps, presentation_timestamps[1:])
    ]
    negative_presentation_steps = [step for step in presentation_steps if step < 0]
    positive_presentation_steps = [step for step in presentation_steps if step > 0.000001]
    median_presentation_step = (
        statistics.median(positive_presentation_steps) if positive_presentation_steps else None
    )
    best_effort_steps = [
        right - left for left, right in zip(best_effort_timestamps, best_effort_timestamps[1:])
    ]
    return {
        "ffprobe_exit": process.returncode,
        "frame_count": frame_count,
        "dimensions": dimensions,
        "pixel_formats": pixel_formats,
        "landscape_1280x720_frames": dimensions.get("1280x720", 0),
        "legacy_portrait_720x1280_frames": dimensions.get("720x1280", 0),
        "unexpected_dimension_frames": sum(
            count for size, count in dimensions.items() if size != required_size
        ),
        "unexpected_pixel_format_frames": sum(
            count for name, count in pixel_formats.items() if name != "yuv420p"
        ),
        "decode_error_flags": decode_error_flags,
        "presentation_timestamp_count": len(presentation_timestamps),
        "strict_presentation_timestamps_monotonic": not any(
            step < -0.000001 for step in presentation_steps
        ),
        "negative_presentation_timestamp_steps": len(negative_presentation_steps),
        "maximum_presentation_timestamp_backward_step_seconds": max(
            (-step for step in negative_presentation_steps), default=0.0
        ),
        "minimum_presentation_timestamp_step_seconds": min(presentation_steps, default=None),
        "maximum_presentation_timestamp_gap_seconds": max(presentation_steps, default=None),
        "median_presentation_timestamp_step_seconds": median_presentation_step,
        "presentation_frame_rate_matches": (
            median_presentation_step is not None
            and abs(median_presentation_step - (1 / VIDEO_FPS))
            <= VIDEO_FRAME_INTERVAL_TOLERANCE_SECONDS
        ),
        "best_effort_timestamp_count": len(best_effort_timestamps),
        "strict_best_effort_timestamps_monotonic": not any(
            step < -0.000001 for step in best_effort_steps
        ),
        "maximum_best_effort_timestamp_backward_step_seconds": max(
            (-step for step in best_effort_steps if step < 0), default=0.0
        ),
        "stderr_empty": not bool(stderr.strip()),
    }


def require_aggregate_portrait_dimensions(decoded_frames: dict) -> None:
    """Reject observed resolution changes even when recorder decode warnings are diagnostic."""
    if decoded_frames["landscape_1280x720_frames"] > 0:
        raise TestFailure("aggregate capture unexpectedly switched back to landscape 1280x720")
    if decoded_frames["legacy_portrait_720x1280_frames"] > 0:
        raise TestFailure("aggregate capture unexpectedly switched back to legacy portrait 720x1280")
    if decoded_frames["unexpected_dimension_frames"] > 0:
        raise TestFailure("aggregate capture contains frames outside the 1080x1920 portrait profile")


def analyze_decoded_audio_timestamps(capture: Path) -> dict:
    command = [
        str(FFPROBE),
        "-v",
        "error",
        "-select_streams",
        "a:0",
        "-show_frames",
        "-show_entries",
        "frame=best_effort_timestamp_time",
        "-of",
        "compact=p=0:nk=0",
        str(capture),
    ]
    process = subprocess.Popen(
        command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
    )
    timestamps: list[float] = []
    frame_count = 0
    assert process.stdout is not None
    for line in process.stdout:
        frame_count += 1
        fields = {}
        for item in line.strip().split("|"):
            if "=" in item:
                key, value = item.split("=", 1)
                fields[key] = value
        raw = fields.get("best_effort_timestamp_time")
        if raw in (None, "N/A"):
            continue
        match = re.match(r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)", raw)
        if match:
            try:
                timestamps.append(float(match.group(0)))
            except ValueError:
                pass
    stderr = process.communicate(timeout=60)[1]
    steps = [right - left for left, right in zip(timestamps, timestamps[1:])]
    negative_steps = [step for step in steps if step < 0]
    beyond_tolerance = [step for step in steps if step < -TIMESTAMP_BACKWARD_TOLERANCE_SECONDS]
    return {
        "ffprobe_exit": process.returncode,
        "frame_count": frame_count,
        "presentation_timestamp_count": len(timestamps),
        "strict_presentation_timestamps_monotonic": not any(step < -0.000001 for step in steps),
        "negative_presentation_timestamp_steps": len(negative_steps),
        "presentation_timestamp_steps_beyond_tolerance": len(beyond_tolerance),
        "maximum_presentation_timestamp_backward_step_seconds": max(
            (-step for step in negative_steps), default=0.0
        ),
        "minimum_presentation_timestamp_step_seconds": min(steps, default=None),
        "maximum_presentation_timestamp_gap_seconds": max(steps, default=None),
        "stderr_empty": not bool(stderr.strip()),
    }


def output_format_failure_stage(
    normalized_video: dict,
    normalized_audio: dict,
    expected_video: dict,
    *,
    check_b_frames: bool = True,
) -> str | None:
    """Return a bounded, non-sensitive stage for an output format mismatch."""

    checks = (
        ("fmt-v-codec", normalized_video.get("codec_name") == "h264"),
        ("fmt-v-prof", normalized_video.get("profile") == expected_video.get("profile")),
        ("fmt-v-level", normalized_video.get("level") == expected_video.get("level")),
        (
            "fmt-v-bframes",
            not check_b_frames
            or normalized_video.get("has_b_frames") == expected_video.get("has_b_frames"),
        ),
        (
            "fmt-v-size",
            (normalized_video.get("width"), normalized_video.get("height"))
            == (PORTRAIT_WIDTH, PORTRAIT_HEIGHT),
        ),
        ("fmt-v-pixfmt", normalized_video.get("pix_fmt") == "yuv420p"),
        ("fmt-v-rfps", normalized_video.get("r_frame_rate") == f"{VIDEO_FPS}/1"),
        ("fmt-a-codec", normalized_audio.get("codec_name") == "aac"),
        ("fmt-a-prof", normalized_audio.get("profile") == "LC"),
        ("fmt-a-rate", normalized_audio.get("sample_rate") == "48000"),
        ("fmt-a-chans", normalized_audio.get("channels") == 2),
        ("fmt-a-layout", normalized_audio.get("channel_layout") == "stereo"),
    )
    for stage, passed in checks:
        if not passed:
            return stage
    return None


def capture_final_sink_media_segment(
    work: Path,
    segment_index: int,
    process_metadata_guard,
) -> tuple[Path, int]:
    """Capture one bounded final-sink sample without probing or decoding it."""
    if type(segment_index) is not int or segment_index < 1:
        raise TestFailure("invalid strict RTMP sink segment index")
    sink_capture = work / f"sink-proof-{segment_index:03d}.flv"
    try:
        capture_command = [
            str(FFMPEG),
            "-nostdin",
            "-hide_banner",
            "-loglevel",
            "error",
            "-xerror",
            "-y",
            "-i",
            f"rtmp://127.0.0.1:{SINK_RTMP_PORT}/live/sink",
            # RTMP readers are admitted on an IDR by MediaMTX. One complete GOP
            # plus one second proves that the recovered encoded epoch is usable
            # without turning this into another long-lived observer.
            "-frames:v",
            str(VIDEO_GOP_FRAMES + VIDEO_FPS),
            "-map",
            "0:v:0",
            "-map",
            "0:a:0",
            "-c",
            "copy",
            "-f",
            "flv",
            str(sink_capture),
        ]
        process_metadata_guard(capture_command)
        try:
            captured = run(
                capture_command,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=15,
            )
        except subprocess.TimeoutExpired as exc:
            raise TestFailure("strict RTMP sink media read timed out") from exc
        if captured.returncode != 0 or not sink_capture.is_file():
            raise TestFailure("strict RTMP sink media read failed")
        capture_bytes = sink_capture.stat().st_size
        if capture_bytes < SLATE_CAPTURE_GROWTH_BYTES:
            raise TestFailure("strict RTMP sink media capture is incomplete")
        os.chmod(sink_capture, 0o600)
        return sink_capture, capture_bytes
    except Exception:
        try:
            sink_capture.unlink(missing_ok=True)
        except OSError:
            pass
        raise


def validate_final_sink_media_segment(
    sink_capture: Path,
    capture_bytes: int,
    expected_video: dict,
    process_metadata_guard,
) -> dict[str, int]:
    """Strictly probe and decode a retained final-RTMP-sink stream-copy sample."""
    try:
        if not sink_capture.is_file() or capture_bytes < SLATE_CAPTURE_GROWTH_BYTES:
            raise TestFailure("strict RTMP sink media capture is unavailable")
        signature = stream_signature(sink_capture, include_gop=False)
        streams = signature.get("streams", [])
        if len(streams) != 2 or [item.get("codec_type") for item in streams] != [
            "video",
            "audio",
        ]:
            raise TestFailure("strict RTMP sink media does not contain video and audio")
        if output_format_failure_stage(streams[0], streams[1], expected_video) is not None:
            raise TestFailure("strict RTMP sink media format is invalid")

        gop = video_gop_signature(sink_capture)
        keyframe_indexes = gop.get("keyframe_indexes", [])
        intervals = gop.get("interval_frames", [])
        if (
            not keyframe_indexes
            or keyframe_indexes[0] != 0
            or not intervals
            or any(interval != VIDEO_GOP_FRAMES for interval in intervals)
        ):
            raise TestFailure("strict RTMP sink media GOP is invalid")

        decode_command = [
            str(FFMPEG),
            "-nostdin",
            "-hide_banner",
            "-loglevel",
            "error",
            "-xerror",
            "-err_detect",
            "explode",
            "-i",
            str(sink_capture),
            "-map",
            "0:v:0",
            "-map",
            "0:a:0",
            "-f",
            "null",
            "-",
        ]
        process_metadata_guard(decode_command)
        decoded = run(
            decode_command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=15,
        )
        if decoded.returncode != 0:
            raise TestFailure("strict RTMP sink media decode failed")

        decoded_frames = analyze_decoded_video_frames(sink_capture)
        if (
            decoded_frames["ffprobe_exit"] != 0
            or decoded_frames["frame_count"] < VIDEO_GOP_FRAMES
            or decoded_frames["unexpected_dimension_frames"] != 0
            or decoded_frames["unexpected_pixel_format_frames"] != 0
            or decoded_frames["decode_error_flags"]
            or not decoded_frames["stderr_empty"]
        ):
            raise TestFailure("strict RTMP sink video frame validation failed")

        decoded_audio = analyze_decoded_audio_timestamps(sink_capture)
        timestamps = analyze_timestamps(sink_capture)
        timestamp_stage = timestamp_failure_stage(
            timestamps,
            decoded_frames,
            decoded_audio,
            0,
        )
        if timestamp_stage == "ts-probe-pts":
            probe_checks = (
                ("packet-pts", timestamps["pts_present_for_every_packet"]),
                ("packet-exit", timestamps["ffprobe_exit"] == 0),
                ("packet-stderr", timestamps["stderr_empty"]),
                (
                    "video-pts-count",
                    decoded_frames["presentation_timestamp_count"]
                    == decoded_frames["frame_count"],
                ),
                (
                    "video-pts-gap",
                    decoded_frames["maximum_presentation_timestamp_gap_seconds"]
                    is not None,
                ),
                ("audio-exit", decoded_audio["ffprobe_exit"] == 0),
                ("audio-frames", decoded_audio["frame_count"] > 0),
                (
                    "audio-pts-count",
                    decoded_audio["presentation_timestamp_count"]
                    == decoded_audio["frame_count"],
                ),
                (
                    "audio-pts-gap",
                    decoded_audio["maximum_presentation_timestamp_gap_seconds"]
                    is not None,
                ),
                ("audio-stderr", decoded_audio["stderr_empty"]),
            )
            probe_failure = next(
                (name for name, passed in probe_checks if not passed),
                "unknown",
            )
            timestamp_stage = f"{timestamp_stage}:{probe_failure}"
        if timestamp_stage != "timestamps":
            raise TestFailure(
                "strict RTMP sink timestamp validation failed "
                f"({timestamp_stage})"
            )

        return {
            "capture_bytes": capture_bytes,
            "video_frames": int(decoded_frames["frame_count"]),
            "audio_frames": int(decoded_audio["frame_count"]),
            "keyframes": len(keyframe_indexes),
        }
    finally:
        try:
            sink_capture.unlink(missing_ok=True)
        except OSError as exc:
            raise TestFailure("strict RTMP sink media cleanup failed") from exc


def timestamp_failure_stage(
    timestamps: dict,
    decoded_frames: dict,
    decoded_audio: dict,
    max_bounded_audio_backward_steps: int,
) -> str:
    """Return one bounded, non-sensitive stage for a failed timestamp check."""

    probe_and_pts_presence_ok = (
        timestamps["pts_present_for_every_packet"]
        and timestamps["ffprobe_exit"] == 0
        and timestamps["stderr_empty"]
        and decoded_frames["presentation_timestamp_count"] == decoded_frames["frame_count"]
        and decoded_frames["maximum_presentation_timestamp_gap_seconds"] is not None
        and decoded_audio["ffprobe_exit"] == 0
        and decoded_audio["frame_count"] > 0
        and decoded_audio["presentation_timestamp_count"] == decoded_audio["frame_count"]
        and decoded_audio["maximum_presentation_timestamp_gap_seconds"] is not None
        and decoded_audio["stderr_empty"]
    )
    packet_dts_ok = (
        timestamps["dts_within_tolerance"]
        and timestamps["negative_dts_steps"].get(0, 0) == 0
        and timestamps["negative_dts_steps"].get(1, 0) <= max_bounded_audio_backward_steps
        and not timestamps["dts_backward_events_beyond_tolerance"]
    )
    video_pts_offset_ok = (
        timestamps["max_pts_dts_offset_seconds"].get(0, 999) <= VIDEO_PTS_DTS_OFFSET_LIMIT_SECONDS
    )
    video_pts_order_ok = decoded_frames["strict_presentation_timestamps_monotonic"]
    video_frame_rate_ok = decoded_frames["presentation_frame_rate_matches"]
    audio_pts_ok = (
        decoded_audio["presentation_timestamp_steps_beyond_tolerance"] == 0
        and decoded_audio["negative_presentation_timestamp_steps"]
        <= max_bounded_audio_backward_steps
        and timestamps["max_pts_dts_offset_seconds"].get(1, 999)
        <= AUDIO_PTS_DTS_OFFSET_LIMIT_SECONDS
    )
    packet_video_dts_gap_ok = (
        timestamps["max_dts_gap_seconds"].get(0, 999) <= VIDEO_PRESENTATION_GAP_LIMIT_SECONDS
    )
    packet_audio_dts_gap_ok = (
        timestamps["max_dts_gap_seconds"].get(1, 999) <= AUDIO_PRESENTATION_GAP_LIMIT_SECONDS
    )
    packet_video_pts_gap_ok = (
        timestamps["max_sorted_pts_gap_seconds"].get(0, 999) <= VIDEO_PRESENTATION_GAP_LIMIT_SECONDS
    )
    packet_audio_pts_gap_ok = (
        timestamps["max_sorted_pts_gap_seconds"].get(1, 999) <= AUDIO_PRESENTATION_GAP_LIMIT_SECONDS
    )
    decoded_video_pts_gap_ok = (
        decoded_frames["maximum_presentation_timestamp_gap_seconds"] is not None
        and decoded_frames["maximum_presentation_timestamp_gap_seconds"]
        <= VIDEO_PRESENTATION_GAP_LIMIT_SECONDS
    )
    decoded_audio_pts_gap_ok = (
        decoded_audio["maximum_presentation_timestamp_gap_seconds"] is not None
        and decoded_audio["maximum_presentation_timestamp_gap_seconds"]
        <= AUDIO_PRESENTATION_GAP_LIMIT_SECONDS
    )
    av_end_and_duration_ok = (
        timestamps["audio_video_duration_difference_seconds"] is not None
        and timestamps["audio_video_duration_difference_seconds"]
        <= VIDEO_PRESENTATION_GAP_LIMIT_SECONDS
        and timestamps["audio_video_end_difference_seconds"] is not None
        and timestamps["audio_video_end_difference_seconds"] <= AV_END_DIFFERENCE_LIMIT_SECONDS
    )

    for stage, passed in (
        ("ts-probe-pts", probe_and_pts_presence_ok),
        ("ts-packet-dts", packet_dts_ok),
        ("ts-v-offset", video_pts_offset_ok),
    ):
        if not passed:
            return stage
    for stage, passed in (
        ("ts-v-order", video_pts_order_ok),
        ("ts-v-fps", video_frame_rate_ok),
        ("ts-audio-pts", audio_pts_ok),
        ("ts-g-vdts", packet_video_dts_gap_ok),
        ("ts-g-adts", packet_audio_dts_gap_ok),
        ("ts-g-vpts", packet_video_pts_gap_ok),
        ("ts-g-apts", packet_audio_pts_gap_ok),
        ("ts-g-vdec", decoded_video_pts_gap_ok),
        ("ts-g-adec", decoded_audio_pts_gap_ok),
        ("ts-av-sync", av_end_and_duration_ok),
    ):
        if not passed:
            return stage
    return "timestamps"


def scan_for_markers(
    markers: list[bytes],
    work: Path,
    authorized: set[Path],
    journal_since_epoch: int,
) -> dict:
    unexpected_files: list[str] = []
    for path in authorized:
        validate_secret_config(path, work)
    authorized_resolved = {path.resolve(strict=True) for path in authorized}
    for path in work.rglob("*"):
        try:
            path_stat = os.lstat(path)
        except OSError:
            continue
        if not stat.S_ISREG(path_stat.st_mode):
            continue
        try:
            resolved = path.resolve(strict=True)
            resolved.relative_to(work.resolve(strict=True))
            if resolved in authorized_resolved:
                continue
            blob = path.read_bytes()
        except ValueError as exc:
            raise TestFailure("self-test file scan encountered an escaping path") from exc
        except OSError:
            continue
        if any(marker in blob for marker in markers):
            unexpected_files.append(str(path.relative_to(work)))
    journal_result = run(
        ["journalctl", "--since", f"@{journal_since_epoch}", "--no-pager", "-o", "cat"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if journal_result.returncode != 0:
        raise TestFailure("journal scan could not be completed")
    journal = journal_result.stdout
    process_cmdline_hit = False
    process_environment_hit = False
    process_candidates = 0
    cmdlines_scanned = 0
    environments_scanned = 0
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        process_candidates += 1
        for leaf in ("cmdline", "environ"):
            try:
                blob = (proc / leaf).read_bytes()
            except OSError:
                continue
            if leaf == "cmdline":
                cmdlines_scanned += 1
            else:
                environments_scanned += 1
            if any(marker in blob for marker in markers):
                if leaf == "cmdline":
                    process_cmdline_hit = True
                else:
                    process_environment_hit = True
    if cmdlines_scanned == 0 or environments_scanned == 0:
        raise TestFailure("process metadata scan could not be completed")
    return {
        "unexpected_file_hits": unexpected_files,
        "journal_scope": "all_units_since_test_start",
        "journal_hit": any(marker in journal for marker in markers),
        "process_cmdline_hit": process_cmdline_hit,
        "process_environment_hit": process_environment_hit,
        "process_candidates": process_candidates,
        "cmdlines_scanned": cmdlines_scanned,
        "environments_scanned": environments_scanned,
    }


