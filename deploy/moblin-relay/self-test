def parse_source_helper_status(metrics: str) -> dict:
    """Collapse helper metrics to fixed, secret-free diagnostic fields."""
    path_ready = any(
        labels.get("name") == SOURCE_PATH and labels.get("state") == "ready" and value == 1
        for labels, value in parse_metrics(metrics, "paths")
    )
    states = [
        labels.get("state", "")
        for labels, value in parse_metrics(metrics, "forward_dests")
        if labels.get("path") == SOURCE_PATH and labels.get("protocol") == "srt" and value == 1
    ]
    state = states[0] if len(states) == 1 else "unknown"
    if state not in {"forwarding", "ready", "error"}:
        state = "unknown"
    return {
        "metrics_ok": True,
        "path_ready": path_ready,
        "forward_state": state,
    }


def source_helper_status(metrics_port: int) -> dict:
