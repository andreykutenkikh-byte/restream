def video_gop_signature(path: Path) -> dict:
    completed = run(
        [
            str(FFPROBE), "-v", "error", "-select_streams", "v:0", "-show_frames",
            "-show_entries", "frame=key_frame", "-of", "json", str(path),
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if completed.returncode != 0:
        raise TestFailure(f"ffprobe frame scan failed for {path.name}")
    try:
        frames = json.loads(completed.stdout)["frames"]
    except (KeyError, TypeError, json.JSONDecodeError) as exc:
        raise TestFailure(f"invalid ffprobe frame data for {path.name}") from exc
    keyframe_indexes = [index for index, frame in enumerate(frames) if frame.get("key_frame") == 1]
    intervals = [right - left for left, right in zip(keyframe_indexes, keyframe_indexes[1:])]
    return {
        "frame_count": len(frames),
        "keyframe_indexes": keyframe_indexes,
        "keyframe_count": len(keyframe_indexes),
        "interval_frames": intervals,
    }


def stream_signature(path: Path, *, include_gop: bool = True) -> dict:
    completed = run(
        [str(FFPROBE), "-v", "error", "-show_streams", "-show_format", "-of", "json", str(path)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if completed.returncode != 0:
        raise TestFailure(f"ffprobe failed for {path.name}")
    try:
        probe = json.loads(completed.stdout)
        streams = probe["streams"]
    except (KeyError, TypeError, json.JSONDecodeError) as exc:
        raise TestFailure(f"invalid ffprobe stream data for {path.name}") from exc
    signature = []
    for stream in streams:
        signature.append({
            "codec_type": stream.get("codec_type"),
            "codec_name": stream.get("codec_name"),
            "profile": stream.get("profile"),
            "level": stream.get("level"),
            "width": stream.get("width"),
            "height": stream.get("height"),
            "pix_fmt": stream.get("pix_fmt"),
            "r_frame_rate": stream.get("r_frame_rate"),
            "avg_frame_rate": stream.get("avg_frame_rate"),
            "sample_rate": stream.get("sample_rate"),
            "channels": stream.get("channels"),
            "channel_layout": stream.get("channel_layout"),
        })
    try:
        duration = float(probe.get("format", {}).get("duration"))
    except (TypeError, ValueError):
        duration = None
    result = {
        "duration_seconds": duration,
        "streams": signature,
    }
    if include_gop:
        result["video_gop"] = video_gop_signature(path)
    return result


def validate_portrait_asset(label: str, signature: dict, *, audio_channels: int = 2) -> None:
    streams = signature.get("streams", [])
    if [stream.get("codec_type") for stream in streams] != ["video", "audio"]:
        raise TestFailure(f"{label} does not contain exactly video then audio")
    video, audio = streams
    dimensions = (video.get("width"), video.get("height"))
    if dimensions == (1280, 720):
        raise TestFailure(f"{label} unexpectedly switched back to landscape 1280x720")
    if dimensions == (720, 1280):
        raise TestFailure(f"{label} unexpectedly switched back to legacy portrait 720x1280")
    if dimensions != (PORTRAIT_WIDTH, PORTRAIT_HEIGHT):
        raise TestFailure(
            f"{label} dimensions are not portrait {PORTRAIT_WIDTH}x{PORTRAIT_HEIGHT}"
        )
    expected_video = {
        "codec_name": "h264",
        "profile": "Main",
        "level": 40,
        "pix_fmt": "yuv420p",
        "r_frame_rate": f"{VIDEO_FPS}/1",
        "avg_frame_rate": f"{VIDEO_FPS}/1",
    }
    if any(video.get(key) != value for key, value in expected_video.items()):
        raise TestFailure(
            f"{label} video is not H.264 Main Level 4.0, yuv420p, {VIDEO_FPS} FPS"
        )
    expected_audio = {
        "codec_name": "aac",
        "profile": "LC",
        "sample_rate": "48000",
        "channels": audio_channels,
        "channel_layout": "stereo" if audio_channels == 2 else "mono",
    }
    if any(audio.get(key) != value for key, value in expected_audio.items()):
        raise TestFailure(
            f"{label} audio is not AAC-LC 48 kHz with the expected channel layout"
        )
    gop = signature.get("video_gop", {})
    keyframe_indexes = gop.get("keyframe_indexes", [])
    if (not keyframe_indexes or keyframe_indexes[0] != 0
            or len(gop.get("interval_frames", [])) < 1
            or any(interval != VIDEO_GOP_FRAMES for interval in gop.get("interval_frames", []))):
        raise TestFailure(f"{label} GOP is not exactly {VIDEO_GOP_FRAMES} frames")
    duration = signature.get("duration_seconds")
    if duration is None or abs(duration - ASSET_DURATION_SECONDS) > 0.1:
        raise TestFailure(f"{label} duration is not {ASSET_DURATION_SECONDS} seconds")


