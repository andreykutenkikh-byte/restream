            return live_feeder

        def require_primary_source_liveness() -> None:
            if primary_helper is None or primary_helper.poll() is not None:
                mark_self_test_stage("auth-src-help")
                raise TestFailure("primary source helper exited during startup")
            elif publisher is None or publisher.poll() is not None:
                mark_self_test_stage("auth-src-bind")
                raise TestFailure("primary publisher exited during startup")
            elif feeder is None or not feeder.healthy():
                mark_self_test_stage("auth-src-feed")
                raise TestFailure("primary feeder exited during startup")

        def stop_primary_srt_source(label: str) -> None:
            nonlocal feeder, primary_helper, publisher
            if feeder is None or publisher is None or primary_helper is None:
                raise TestFailure(f"primary source is missing before {label}")
            if not feeder.healthy() or not feeder.finish():
                raise TestFailure(f"live feeder did not stop during {label}")
            feeder = None
            if not safe_stop(primary_helper, force=True):
                raise TestFailure(f"SRT source helper did not stop during {label}")
            primary_helper = None
            if not safe_stop(publisher, force=True):
                raise TestFailure(f"publisher did not stop during {label}")
            publisher = None
            wait_ports_released(
                (
                    ("tcp", SOURCE_PRIMARY_RTMP_PORT),
                    ("udp", SOURCE_PRIMARY_FEED_PORT),
                    ("tcp", SOURCE_PRIMARY_METRICS_PORT),
                )
            )

        def wait_sink_delivery_growth(
            description: str,
            state_predicate,
            timeout: float,
            *,
            not_before: float = 0.0,
            health_check=None,
        ) -> dict:
            growth_gate = SinkDeliveryGrowthGate()

            def recovered(item: dict) -> bool:
                if not state_predicate(item):
                    growth_gate.reset()
                    return False
                return growth_gate.observe(item)

            return observer.wait_sample(
                description,
                recovered,
                timeout,
                not_before=not_before,
                health_check=health_check,
            )

        def wait_downstream_transition(
            description: str,
            transition_started: float,
            state_predicate,
            timeout: float,
            *,
            health_check=None,
        ) -> dict:
            nonlocal current_sink_id
            remaining = min(
                timeout,
                RTMP_SINK_RECOVERY_TIMEOUT_SECONDS - (time.monotonic() - transition_started),
            )
            if remaining <= 0:
                raise TestFailure(f"{description} exceeded the RTMP sink recovery bound")
            sample = wait_sink_delivery_growth(
                description,
                state_predicate,
                remaining,
                not_before=transition_started,
                health_check=health_check,
            )
            recovery_seconds = float(sample.get("finished", sample["t"])) - transition_started
            if recovery_seconds > RTMP_SINK_RECOVERY_TIMEOUT_SECONDS:
                raise TestFailure(f"{description} exceeded the RTMP sink recovery bound")
            recovered_sink_id = sample["sink_ids"][0]
            if transition_log_descriptor is None:
                raise TestFailure("transition log gate was not initialized")
            # This cumulative count is checkpointed for every event. A marker
            # consumed by an earlier event cannot authorize a later rotation.
            known_dts_marker_count = known_forward_dts_marker_count(
                read_validated_log_tail(
                    transition_log_descriptor,
                    transition_log_offset,
                    os.geteuid(),
                )
            )
            if "LIVE" in description or description == INTENTIONAL_RTMP_RECONNECT_EVENT:
                record_strict_sink_segment(
                    description,
                    state_predicate,
                    recovered_sink_id,
                    result_key=(
                        "initial_live_rtmp_sink_media"
                        if description == "initial healthy LIVE"
                        else None
                    ),
                )
            event_delivery_ledger.append(
                {
                    "event": description,
                    "recovery_seconds": round(recovery_seconds, 3),
                    "publisher_rotated": recovered_sink_id != current_sink_id,
                    "known_dts_marker_count": known_dts_marker_count,
                }
            )
            current_sink_id = recovered_sink_id
            return sample

        def wait_new_authenticated_ingest(
            description: str,
            recovery_started: float,
            recovery_deadline: float,
            previous_ingest_ids: list[str],
            *,
            health_check=None,
        ) -> dict:
            """Wait for a fresh SRT publisher without charging handshake time to delivery."""
            remaining = recovery_deadline - time.monotonic()
            if remaining <= 0:
                raise TestFailure(f"{description} exceeded the source recovery bound")
            return observer.wait_sample(
                description,
                lambda sample: (
                    sample.get("ingest_live")
                    and sample.get("path_ready")
                    and len(sample.get("ingest_ids", [])) == 1
                    and sample.get("ingest_ids") != previous_ingest_ids
                ),
                remaining,
                not_before=recovery_started,
                health_check=health_check,
            )

        def wait_healthy_live(
            description: str,
            timeout: float,
            *,
            not_before: float = 0.0,
            expected_ingest_ids: list[str] | None = None,
            sink_transition_started: float | None = None,
        ) -> dict:
            def live_state(sample: dict) -> bool:
                return bool(
                    sample.get("live")
                    and sample.get("normalized")
                    and sample.get("path_ready")
                    and (
                        expected_ingest_ids is None
                        or sample.get("ingest_ids") == expected_ingest_ids
                    )
                )

            if sink_transition_started is not None:
                return wait_downstream_transition(
                    description,
                    sink_transition_started,
                    live_state,
                    timeout,
                )
            return observer.wait_sample(
                description,
                lambda sample: live_state(sample) and sink_delivery_active(sample, current_sink_id),
                timeout,
                not_before=not_before,
            )

        def wait_slate_with_live_srt(
            description: str,
            transition_started: float,
            expected_ingest_ids: list[str] | None,
        ) -> dict:
            remaining = LIVE_TO_SLATE_DEADLINE_SECONDS - (time.monotonic() - transition_started)
            if remaining <= 0:
                raise TestFailure(f"{description} exceeded the SLATE deadline")
            sample = observer.wait_sample(
                description,
                lambda item: (
                    not item.get("normalized")
                    and not item.get("live")
                    and (
                        expected_ingest_ids is None
                        or (
                            item.get("ingest_live")
                            and item.get("ingest_ids") == expected_ingest_ids
                        )
                    )
                    and item.get("path_ready")
                ),
                remaining,
                not_before=transition_started,
            )
            elapsed = float(sample["t"]) - transition_started
            if elapsed > LIVE_TO_SLATE_DEADLINE_SECONDS:
                raise TestFailure(f"{description} exceeded the SLATE deadline")
            return sample

        def wait_slate_downstream_recovery(
            description: str,
            transition_started: float,
            *,
            absolute_deadline: float | None = None,
        ) -> dict:
            # The local SLATE state and RTSP capture have their own shorter
            # deadlines.  RTMP forward retries are independently allowed the
            # full bounded recovery window from the original transition.
            timeout = RTMP_SINK_RECOVERY_TIMEOUT_SECONDS
            if absolute_deadline is not None:
                timeout = min(timeout, absolute_deadline - time.monotonic())
            if timeout <= 0:
                raise TestFailure(f"{description} exceeded its absolute recovery deadline")
            return wait_downstream_transition(
                description,
                transition_started,
                lambda item: item.get("path_ready"),
                timeout,
            )

        def wait_slate_capture_growth(description: str, slate_sample: dict) -> dict:
            if not complete_metrics_sample(slate_sample):
                raise TestFailure(f"invalid SLATE sample while waiting for {description}")
            return capture_observer.wait_growth(
                description,
                SLATE_CAPTURE_GROWTH_BYTES,
                SLATE_CAPTURE_GROWTH_TIMEOUT_SECONDS,
            )

        def wait_srt_idle_expiry(
            description: str,
            outage_started: float,
        ) -> tuple[dict, float]:
            remaining = SRT_IDLE_UPPER_BOUND_SECONDS - (time.monotonic() - outage_started)
            if remaining <= 0:
                raise TestFailure(f"{description} exceeded the SRT idle timeout bound")
            sample = observer.wait_sample(
                description,
                lambda item: (
                    not item.get("ingest_live")
                    and not item.get("normalized")
                    and not item.get("live")
                    and item.get("path_ready")
                ),
                remaining,
                not_before=outage_started,
            )
            elapsed = float(sample["t"]) - outage_started
            if not SRT_IDLE_LOWER_BOUND_SECONDS <= elapsed <= SRT_IDLE_UPPER_BOUND_SECONDS:
                raise TestFailure(f"{description} violated the configured SRT idle tolerance")
            return sample, elapsed

        def wait_normalizer_child(
            description: str,
            timeout: float,
            *,
            previous_pid: int | None = None,
        ) -> tuple[int, int]:
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                supervisors = matching_test_normalizer_supervisor_ids(work)
                if len(supervisors) == 1:
                    children = direct_child_process_ids(supervisors[0])
                    if len(children) == 1 and children[0] != previous_pid:
                        try:
                            command = Path(f"/proc/{children[0]}/cmdline").read_bytes()
                        except OSError:
                            time.sleep(0.025)
                            continue
                        if str(FFMPEG).encode() in command and OUTPUT_PATH.encode() in command:
                            return supervisors[0], children[0]
                time.sleep(0.025)
            raise TestFailure(f"timed out waiting for {description}")

        def reject_with_helper(config: Path, label: str) -> int:
            helper = start_source_helper(config, label, SOURCE_AUX_METRICS_PORT)
            candidate = start_local_publisher(SOURCE_AUX_RTMP_PORT)
            observation_started = time.monotonic()
            try:
                wait_helper_path(SOURCE_AUX_METRICS_PORT)
                forward_error_seen = False
                deadline = time.monotonic() + 12
                while time.monotonic() < deadline:
                    forward_error_seen = forward_error_seen or helper_forward_error(
                        SOURCE_AUX_METRICS_PORT
                    )
                    sample = observer.checked_snapshot(label)
                    if sample and not all(
                        sample.get(name) for name in ("dut_alive", "sink_alive", "reader_alive")
                    ):
                        raise TestFailure(f"continuity failed while checking {label}")
                    if candidate.poll() is not None or helper.poll() is not None:
                        raise TestFailure(f"local source path exited while checking {label}")
                    if not complete_metrics_sample(sample):
                        time.sleep(0.1)
                        continue
                    if sample.get("live"):
                        raise TestFailure(f"{label} caused a transient LIVE state")
                    if not all(sample.get(name) for name in ("path_ready", "forward")):
                        raise TestFailure(f"continuity failed while checking {label}")
                    if not sink_delivery_active(sample, current_sink_id):
                        raise TestFailure(f"downstream identity changed while checking {label}")
                    time.sleep(0.1)
                observation_finished = time.monotonic()
                observed_interval = observer.samples_between(
                    observation_started, observation_finished
                )
                require_metrics_coverage(
                    observed_interval,
                    observation_started,
                    observation_finished,
                    label,
                )
                interval = [
                    sample for sample in observed_interval if complete_metrics_sample(sample)
                ]
                if not interval or any(sample.get("live") for sample in interval):
                    raise TestFailure(f"{label} was not rejected for the full observer interval")
                if not forward_error_seen:
                    raise TestFailure(f"{label} did not produce a verified SRT forward rejection")
                return len(interval)
            finally:
                safe_stop(candidate, force=True)
                safe_stop(helper)
                wait_ports_released(
                    (
                        ("tcp", SOURCE_AUX_RTMP_PORT),
                        ("tcp", SOURCE_AUX_METRICS_PORT),
                    )
                )

        mark_self_test_stage("auth")
        print(
            "[3/8] Verifying SRT authentication/encryption, SLATE -> LIVE and publisher exclusivity",
            flush=True,
        )

        wrong_password = password + "X"
        wrong_passphrase = ("A" if passphrase[0] != "A" else "B") + passphrase[1:]
        markers.extend((wrong_password.encode(), wrong_passphrase.encode()))
        wrong_password_config = write_source_config(
