            """Stream-copy one stable sink sample without probing on the recovery path."""
            nonlocal strict_sink_segment_sequence
            before_sample = observer.checked_snapshot(
                f"{description} strict RTMP sink segment precondition"
            )
            if (
                not complete_metrics_sample(before_sample)
                or not state_predicate(before_sample)
                or not sink_delivery_active(before_sample, expected_sink_id)
            ):
                raise TestFailure("final RTMP sink was not stable before media capture")
            strict_sink_segment_sequence += 1
            sink_capture, capture_bytes = capture_final_sink_media_segment(
                work,
                strict_sink_segment_sequence,
                assert_clean_process_metadata,
            )
            after_sample = observer.checked_snapshot(
                f"{description} strict RTMP sink segment completion"
            )
            if (
                not complete_metrics_sample(after_sample)
                or not state_predicate(after_sample)
                or not sink_delivery_active(after_sample, expected_sink_id)
            ):
                with contextlib.suppress(OSError):
