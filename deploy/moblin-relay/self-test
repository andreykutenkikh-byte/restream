        network_capture_window_started = time.monotonic()

        print(
            "[4/8] Running required outages: " + ", ".join(str(item) + "s" for item in durations),
            flush=True,
        )
        to_slate_times, to_live_times, srt_idle_times = [], [], []
        outage_capture_stalls = []
        for index, duration in enumerate(durations, start=1):
            if feeder is None or not feeder.healthy():
                raise TestFailure(f"live feeder is unavailable before outage {index}")
            before_outage = wait_healthy_live(
                f"healthy LIVE before outage {index}",
                5,
            )
            outage_ingest_ids = list(before_outage["ingest_ids"])
            if len(outage_ingest_ids) != 1:
                raise TestFailure(f"outage {index} precondition lacks one SRT connection")
            stopped_feeder = feeder
            outage_started = time.monotonic()
            mark_self_test_stage("outage-slate")
            stop_primary_srt_source(f"outage {index}")
            if (
                stopped_feeder.is_alive()
                or stopped_feeder.remux_pid is not None
                or feeder is not None
                or publisher is not None
                or primary_helper is not None
                or not port_is_free("udp", SOURCE_PRIMARY_FEED_PORT)
            ):
                raise TestFailure(f"primary source survived outage {index} shutdown")
            mark_self_test_stage("outage-normal")
            detached = wait_slate_with_live_srt(
                f"outage {index} SLATE transition",
                outage_started,
                outage_ingest_ids,
            )
            to_slate = float(detached["t"]) - outage_started
            wait_slate_capture_growth(
                f"outage {index} SLATE capture growth",
                detached,
            )
            _srt_expired, srt_idle_elapsed = wait_srt_idle_expiry(
                f"outage {index} SRT idle expiry",
                outage_started,
            )
            wait_slate_downstream_recovery(
                f"outage {index} SLATE transition",
                outage_started,
            )
            to_slate_times.append(round(to_slate, 3))
            srt_idle_times.append(round(srt_idle_elapsed, 3))
            print(
                f"  outage {index}/3: SLATE active; total SRT outage target {duration}s", flush=True
            )
            mark_self_test_stage("outage-hold")
            while time.monotonic() - outage_started < duration:
                if (
                    feeder is not None
                    or publisher is not None
                    or primary_helper is not None
                    or not port_is_free("udp", SOURCE_PRIMARY_FEED_PORT)
                ):
                    raise TestFailure(f"primary source remained active during outage {index}")
                sample = observer.checked_snapshot(f"outage {index}")
                if sample and not all(
                    sample.get(name) for name in ("dut_alive", "sink_alive", "reader_alive")
                ):
                    raise TestFailure(f"continuity failed during outage {index}")
                if not complete_metrics_sample(sample):
                    remaining = duration - (time.monotonic() - outage_started)
                    if remaining <= 0:
                        break
                    time.sleep(min(1.0, remaining))
                    continue
                if not all(sample.get(name) for name in ("path_ready", "forward")):
                    raise TestFailure(f"continuity failed during outage {index}")
                if sample.get("ingest_live") or sample.get("normalized") or sample.get("live"):
                    raise TestFailure(f"LIVE state returned unexpectedly during outage {index}")
                if not sink_delivery_active(sample, current_sink_id):
                    raise TestFailure(f"downstream RTMP identity changed during outage {index}")
                remaining = duration - (time.monotonic() - outage_started)
                if remaining <= 0:
                    break
                time.sleep(min(1.0, remaining))
            recovery_started = time.monotonic()
            require_metrics_coverage(
                observer.samples_between(outage_started, recovery_started),
                outage_started,
                recovery_started,
                f"outage {index}",
            )
            outage_samples = capture_observer.checked_samples_since(
                float(detached["t"]),
                f"outage {index}",
            )
            outage_no_growth = maximum_capture_no_growth_seconds(outage_samples)
            if outage_no_growth > CAPTURE_NO_GROWTH_LIMIT_SECONDS:
                raise TestFailure(f"downstream media stalled during outage {index}")
            outage_capture_stalls.append(round(outage_no_growth, 3))
            mark_self_test_stage("outage-live")
            primary_helper = start_source_helper(
                primary_config, f"primary-recovery-{index}", SOURCE_PRIMARY_METRICS_PORT
            )
            publisher = start_primary_publisher()
            feeder = start_live_feeder()
            recovered_feeder = feeder
            recovered_feeder_ident = feeder.ident
            recovered_remux_pid = feeder.remux_pid
            wait_helper_path(SOURCE_PRIMARY_METRICS_PORT)
            outage_recovery_deadline = recovery_started + SOURCE_RESET_TIMEOUT_SECONDS
            outage_ingest = wait_new_authenticated_ingest(
                f"outage {index} SRT reconnect",
                recovery_started,
                outage_recovery_deadline,
                outage_ingest_ids,
                health_check=require_primary_source_liveness,
            )
            recovered = wait_healthy_live(
                f"outage {index} LIVE recovery",
                max(0.0, outage_recovery_deadline - time.monotonic()),
                not_before=float(outage_ingest["t"]),
                expected_ingest_ids=list(outage_ingest["ingest_ids"]),
                sink_transition_started=float(outage_ingest["finished"]),
            )
            to_live = float(recovered["t"]) - recovery_started
            if (
                feeder is None
                or feeder is stopped_feeder
                or feeder is not recovered_feeder
                or not feeder.healthy()
                or recovered_feeder_ident is None
                or feeder.ident != recovered_feeder_ident
                or recovered_remux_pid is None
                or feeder.remux_pid != recovered_remux_pid
            ):
                raise TestFailure(f"fresh live feeder failed after outage {index}")
            to_live_times.append(round(to_live, 3))
            print(f"  outage {index}/3: LIVE restored", flush=True)
            time.sleep(3 if not args.quick else 1)
        result["live_to_slate_seconds"] = to_slate_times
        result["slate_to_live_seconds"] = to_live_times
        result["srt_idle_expiry_seconds"] = srt_idle_times
        result["outage_max_capture_no_growth_seconds"] = outage_capture_stalls

        mark_self_test_stage("continuity")
        print("[5/8] Checking RTSP continuity and automatic RTMP recovery", flush=True)
        if feeder is None or not feeder.healthy():
            raise TestFailure("live feeder is unavailable before final transition")

        # Force one exact, loopback-only downstream disconnect so recovery is
        # proven deterministically even when all content transitions happened
        # to preserve their RTMP publisher connection.
        before_forced_reconnect = wait_healthy_live(
            "healthy LIVE before forced RTMP sink reconnect",
            5,
        )
        forced_old_sink_id = before_forced_reconnect["sink_ids"][0]
        forced_reconnect_started = time.monotonic()
        kick_test_sink_rtmp_connection(forced_old_sink_id)
        observer.wait_sample(
            "forced RTMP sink disconnect",
            lambda sample: sample.get("sink_ids") == [],
            3,
            not_before=forced_reconnect_started,
        )
        forced_reconnected = wait_downstream_transition(
            "forced RTMP sink reconnect",
            forced_reconnect_started,
            lambda sample: (
                sample.get("live")
                and sample.get("path_ready")
                and sample.get("sink_ids") != [forced_old_sink_id]
            ),
            RTMP_SINK_RECOVERY_TIMEOUT_SECONDS,
        )
        if forced_reconnected["sink_ids"] == [forced_old_sink_id]:
            raise TestFailure("forced RTMP sink reconnect reused its old publisher")
        forced_reconnect_samples = capture_observer.checked_samples_since(
            forced_reconnect_started,
            "forced RTMP sink reconnect",
        )
        forced_reconnect_no_growth = maximum_capture_no_growth_seconds(forced_reconnect_samples)
        if forced_reconnect_no_growth > CAPTURE_NO_GROWTH_LIMIT_SECONDS:
            raise TestFailure("RTSP capture stalled during forced RTMP sink reconnect")

        before_final = wait_healthy_live("healthy LIVE before final transition", 5)
        final_ingest_ids = list(before_final["ingest_ids"])
        if len(final_ingest_ids) != 1:
            raise TestFailure("final transition precondition lacks one SRT connection")
        final_started = time.monotonic()
        stop_primary_srt_source("final continuity transition")
        final_slate = wait_slate_with_live_srt(
            "final SLATE transition",
            final_started,
            final_ingest_ids,
        )
        wait_slate_capture_growth("final SLATE capture growth", final_slate)
        _final_expired, final_srt_idle = wait_srt_idle_expiry(
            "final SRT idle expiry",
            final_started,
        )
        wait_slate_downstream_recovery("final SLATE transition", final_started)
        final_stable = wait_sink_delivery_growth(
            "stable final RTMP sink delivery",
            lambda sample: (
                not sample.get("live") and not sample.get("normalized") and sample.get("path_ready")
            ),
            3,
            not_before=float(final_slate["t"]),
        )
        current_sink_id = final_stable["sink_ids"][0]
        record_strict_sink_segment(
            "stable final SLATE",
            lambda sample: (
                not sample.get("live")
                and not sample.get("normalized")
                and sample.get("path_ready")
            ),
            current_sink_id,
            result_key="final_rtmp_sink_media",
        )
        final_recent = wait_sink_delivery_growth(
            "recent final RTMP sink delivery",
            lambda sample: (
                not sample.get("live") and not sample.get("normalized") and sample.get("path_ready")
            ),
            3,
            not_before=time.monotonic(),
        )
        current_sink_id = final_recent["sink_ids"][0]
        final_finished = time.monotonic()
        observer.checked_snapshot("final transition")
        final_samples = capture_observer.checked_samples_since(
            float(final_slate["t"]),
            "final transition",
        )
        capture_samples = capture_observer.checked_samples_since(
            network_capture_window_started,
            "network-outage matrix",
        )
        capture_observer.finish()
        observer.finish()
        samples = observer.samples
        result["max_metrics_blind_seconds"] = round(
            require_metrics_coverage(
                samples,
                observer_coverage_started,
                final_finished,
                "complete self-test",
            ),
            3,
        )
        final_no_growth = maximum_capture_no_growth_seconds(final_samples)
        if final_no_growth > CAPTURE_NO_GROWTH_LIMIT_SECONDS:
            raise TestFailure("downstream media stalled during final transition")
        result["final_transition"] = {
            "to_slate_seconds": round(float(final_slate["t"]) - final_started, 3),
            "srt_idle_expiry_seconds": round(final_srt_idle, 3),
            "max_capture_no_growth_seconds": round(final_no_growth, 3),
        }
        result["observer_samples"] = len(samples)
        result["capture_observer_samples"] = len(capture_samples)
        result["overall_max_capture_no_growth_seconds"] = round(
            maximum_capture_no_growth_seconds(capture_samples),
            3,
        )
        result["overall_capture_scope"] = "network-outage matrix after local fault injections"
        if result["overall_max_capture_no_growth_seconds"] > CAPTURE_NO_GROWTH_LIMIT_SECONDS:
            raise TestFailure("downstream media stalled during the complete self-test")
        expected_events = [
            "initial healthy LIVE",
            "same-session SLATE transition",
            "same-session LIVE recovery",
            "persistent-stall SLATE transition",
            "persistent-stall LIVE recovery",
            "supervisor-crash SLATE transition",
            "supervisor-crash LIVE recovery",
        ]
        for failure_index in range(1, BRIDGE_FAILURES_TO_INJECT + 1):
            expected_events.append(f"repeated-failure {failure_index} SLATE transition")
            expected_events.append(f"LIVE after forced bridge failure {failure_index}")
        for index in range(1, len(durations) + 1):
            expected_events.extend(
                (
                    f"outage {index} SLATE transition",
                    f"outage {index} LIVE recovery",
                )
            )
        expected_events.extend(
            (
                "forced RTMP sink reconnect",
                "final SLATE transition",
            )
        )
        event_delivery_summary = summarize_event_delivery_ledger(
            event_delivery_ledger,
            tuple(expected_events),
        )
        delivery_summary = summarize_downstream_delivery(
            samples,
            observer_coverage_started,
            final_finished,
        )
        require_accounted_downstream_recovery(delivery_summary, event_delivery_summary)
        result["event_to_delivery_recovery"] = event_delivery_ledger
        result["automatic_rtmp_forward_recovery"] = {
            **event_delivery_summary,
            **{
                key: (round(value, 3) if key == "max_delivery_outage_seconds" else value)
                for key, value in delivery_summary.items()
            },
            "forced_disconnect_recovered": True,
            "forced_disconnect_max_rtsp_capture_no_growth_seconds": round(
                forced_reconnect_no_growth,
                3,
            ),
            "test_scope": "isolated-loopback-immediate-failure",
        }
        result["rtsp_capture_session_preserved"] = reader.poll() is None
        result["max_rss_kib"] = observer.max_rss_kib
        result["max_cpu_percent"] = {
            key: round(value, 2) for key, value in observer.max_cpu_percent.items()
        }
        result["average_cpu_percent"] = {
            key: round(value, 2) for key, value in observer.average_cpu_percent().items()
        }
        result["capture_bytes"] = capture.stat().st_size
        if not result["rtsp_capture_session_preserved"]:
            raise TestFailure("long-lived RTSP/TCP capture reader exited")

        for handle in log_handles:
            handle.flush()
        if transition_log_descriptor is None:
            raise TestFailure("transition log gate was not initialized")
        transition_log_tail = read_validated_log_tail(
            transition_log_descriptor,
            transition_log_offset,
            os.geteuid(),
        )
        transition_failure = transition_log_failure(transition_log_tail)
        if transition_failure is not None:
            mark_self_test_stage("dts-regression")
            raise TestFailure(f"unsafe RTMP transition log marker occurred: {transition_failure}")
        dts_reconnects = transition_log_tail.count(KNOWN_DTS_REGRESSION_MARKER)
        result["rtmp_transition_log_contract"] = {
            # MediaMTX v1.20.1 may reject one H.264 transition while replacing
            # its timestamp extractor. Its native forward loop reconnects after
            # five seconds; the event-to-delivery ledger above proves that the
            # sink resumed within the bounded recovery window.
            "recoverable_dts_reconnects": dts_reconnects,
            "dts_reconnects_recovered": True,
            "missing_or_unset_timestamps_absent": True,
            "mux_invalid_argument_absent": True,
        }

        safe_stop(reader)
        reader = None
        strict_sink_segment_counts: list[dict[str, int]] = []
        try:
            for segment_number, pending_segment in enumerate(
                pending_strict_sink_segments,
                start=1,
            ):
                result["strict_sink_segment_validation_progress"] = {
                    "current_segment": segment_number,
                    "validated_segments": len(strict_sink_segment_counts),
                    "captured_segments": len(pending_strict_sink_segments),
                }
                strict_counts = validate_final_sink_media_segment(
                    pending_segment["path"],
                    int(pending_segment["capture_bytes"]),
                    slate_sig["streams"][0],
                    assert_clean_process_metadata,
                )
                strict_sink_segment_counts.append(strict_counts)
                result_key = pending_segment.get("result_key")
                if isinstance(result_key, str):
                    result[result_key] = dict(strict_counts)
                result["strict_sink_segment_validation_progress"]["validated_segments"] = len(
                    strict_sink_segment_counts
                )
        finally:
            for pending_segment in pending_strict_sink_segments:
                with contextlib.suppress(OSError):
                    pending_segment["path"].unlink(missing_ok=True)
        if len(strict_sink_segment_counts) != len(pending_strict_sink_segments):
            raise TestFailure("not every final RTMP sink segment was strictly validated")
        result["strict_sink_segment_capture"]["pending_validation"] = 0
        result["strict_sink_segment_validation"] = {
            "segments": len(strict_sink_segment_counts),
            "capture_bytes": sum(
                item["capture_bytes"] for item in strict_sink_segment_counts
            ),
            "video_frames": sum(item["video_frames"] for item in strict_sink_segment_counts),
            "audio_frames": sum(item["audio_frames"] for item in strict_sink_segment_counts),
            "keyframes": sum(item["keyframes"] for item in strict_sink_segment_counts),
            "temporary_segments_retained": 0,
        }
        mark_self_test_stage("decode")
        print(
            "[6/8] Collecting aggregate RTSP format, GOP and timestamp diagnostics",
            flush=True,
        )
        result["aggregate_rtsp_capture_diagnostic_only"] = True
        result["aggregate_rtsp_capture_corruption_oracle"] = False
        mark_self_test_stage("streams")
        normalized_signature = stream_signature(capture, include_gop=False)
        normalized_streams = normalized_signature.get("streams", [])
        if len(normalized_streams) != 2:
            raise TestFailure("normalized capture does not contain exactly video and audio")
        normalized_video, normalized_audio = normalized_streams
        mark_self_test_stage("format")
        format_failure = output_format_failure_stage(
            normalized_video,
            normalized_audio,
            slate_sig["streams"][0],
            check_b_frames=False,
        )
        result["aggregate_format_diagnostic_passed"] = format_failure is None
        mark_self_test_stage("gop")
        normalized_signature["video_gop"] = video_gop_signature(capture)
        normalized_gop_intervals = normalized_signature["video_gop"].get("interval_frames", [])
        aggregate_gop_diagnostic_passed = not (
            not normalized_gop_intervals
            or max(normalized_gop_intervals) != VIDEO_GOP_FRAMES
            or any(
                interval < 1 or interval > VIDEO_GOP_FRAMES for interval in normalized_gop_intervals
            )
        )
        result["aggregate_gop_diagnostic_passed"] = aggregate_gop_diagnostic_passed
        result["normalized_output_streams"] = normalized_streams
        result["mono_to_stereo_normalization_passed"] = True
        mark_self_test_stage("decoder")
        decode = run(
            [
                str(FFMPEG),
                "-nostdin",
                "-hide_banner",
                "-v",
                "warning",
                "-err_detect",
                "explode",
                "-i",
                str(capture),
                "-map",
                "0:v:0",
                "-map",
                "0:a:0",
                "-f",
                "null",
                "-",
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
        )
        decode_text = decode.stderr.decode(errors="replace")
        # A single long-lived RTSP-to-FLV recorder observes several independent
        # publisher epochs. Its muxer can clamp DTS at intentional SLATE/LIVE
        # boundaries and, if the diagnostic reader falls behind, its own queue
        # can discard encoded frames. Keep these aggregate values diagnostic;
        # the short final-RTMP-sink samples above are the corruption hard gate.
        timestamp_warning = re.compile(r"Non-monotonous DTS|Invalid DTS", re.I)
        media_corruption = re.compile(
            r"Packet corrupt|corrupt(?:ed)? frame|decode error|error while decoding|"
            r"concealing .* errors|Broken pipe|Connection reset",
            re.I,
        )
        result["decode_exit"] = decode.returncode
        result["decode_timestamp_warning_count"] = len(timestamp_warning.findall(decode_text))
        result["decode_error_pattern_found"] = bool(media_corruption.search(decode_text))

        mark_self_test_stage("frames")
        result["decoded_video_frames"] = analyze_decoded_video_frames(capture)
        decoded_frames = result["decoded_video_frames"]
        landscape_regression_absent = decoded_frames["landscape_1280x720_frames"] == 0
        legacy_portrait_regression_absent = decoded_frames["legacy_portrait_720x1280_frames"] == 0
        result["landscape_1280x720_regression_absent"] = landscape_regression_absent
        result["legacy_portrait_720x1280_regression_absent"] = legacy_portrait_regression_absent
        portrait_frames_ok = (
            decoded_frames["ffprobe_exit"] == 0
            and decoded_frames["frame_count"] > 0
            and decoded_frames["unexpected_dimension_frames"] == 0
            and landscape_regression_absent
            and legacy_portrait_regression_absent
            and decoded_frames["unexpected_pixel_format_frames"] == 0
            and not decoded_frames["decode_error_flags"]
            and decoded_frames["stderr_empty"]
        )
        result["portrait_capture_guard_passed"] = portrait_frames_ok
        # The recorder can have decoder artifacts across publisher epochs, but
        # a positively observed wrong resolution must never be diagnostic-only.
        require_aggregate_portrait_dimensions(decoded_frames)

        mark_self_test_stage("timestamps")
        result["decoded_audio_timestamps"] = analyze_decoded_audio_timestamps(capture)
        result["timestamps"] = analyze_timestamps(capture)
        decoded_audio = result["decoded_audio_timestamps"]
        # Audio can exhibit one bounded timestamp repeat at each intentional
        # source splice. Video high-offset runs remain diagnostic only: native
        # FLV with H.264 B-frames can expose more than one such run for a single
        # splice. Strict video packet-DTS and decoded-PTS checks remain
        # authoritative; audio uses the explicit bounded-jitter policy together
        # with hard gap, offset, decode and A/V-sync limits below.
        max_bounded_audio_backward_steps = 2 * len(durations) + 6
        bounded_splice_jitter_passed = (
            result["timestamps"]["dts_within_tolerance"]
            and result["timestamps"]["negative_dts_steps"].get(0, 0) == 0
            and result["timestamps"]["negative_dts_steps"].get(1, 0)
            <= max_bounded_audio_backward_steps
            and not result["timestamps"]["dts_backward_events_beyond_tolerance"]
            and decoded_audio["presentation_timestamp_steps_beyond_tolerance"] == 0
            and decoded_audio["negative_presentation_timestamp_steps"]
            <= max_bounded_audio_backward_steps
        )
        result["bounded_splice_jitter_passed"] = bounded_splice_jitter_passed
        result["timestamp_validation_policy"] = {
            "video": "strict decoded PTS and packet DTS monotonicity",
            "audio": "bounded splice jitter with strict presentation-gap and A/V-sync limits",
        }
        result["strict_timestamp_monotonicity"] = {
            "packet_dts": result["timestamps"]["strict_dts_monotonic"],
            "decoded_video_pts": decoded_frames["strict_presentation_timestamps_monotonic"],
            "decoded_video_best_effort": decoded_frames["strict_best_effort_timestamps_monotonic"],
            "decoded_audio_pts": decoded_audio["strict_presentation_timestamps_monotonic"],
        }
        timestamp_ok = (
            bounded_splice_jitter_passed
            and result["timestamps"]["pts_present_for_every_packet"]
            and result["timestamps"]["ffprobe_exit"] == 0
            and result["timestamps"]["stderr_empty"]
            and result["timestamps"]["max_dts_gap_seconds"].get(0, 999)
            <= VIDEO_PRESENTATION_GAP_LIMIT_SECONDS
            and result["timestamps"]["max_dts_gap_seconds"].get(1, 999)
            <= AUDIO_PRESENTATION_GAP_LIMIT_SECONDS
            and result["timestamps"]["max_sorted_pts_gap_seconds"].get(0, 999)
            <= VIDEO_PRESENTATION_GAP_LIMIT_SECONDS
            and result["timestamps"]["max_sorted_pts_gap_seconds"].get(1, 999)
            <= AUDIO_PRESENTATION_GAP_LIMIT_SECONDS
            and result["timestamps"]["max_pts_dts_offset_seconds"].get(0, 999)
            <= VIDEO_PTS_DTS_OFFSET_LIMIT_SECONDS
            and result["timestamps"]["max_pts_dts_offset_seconds"].get(1, 999)
            <= AUDIO_PTS_DTS_OFFSET_LIMIT_SECONDS
            and decoded_frames["presentation_timestamp_count"] == decoded_frames["frame_count"]
            and decoded_frames["strict_presentation_timestamps_monotonic"]
            and decoded_frames["presentation_frame_rate_matches"]
            and decoded_frames["maximum_presentation_timestamp_gap_seconds"] is not None
            and decoded_frames["maximum_presentation_timestamp_gap_seconds"]
            <= VIDEO_PRESENTATION_GAP_LIMIT_SECONDS
            and decoded_audio["ffprobe_exit"] == 0
            and decoded_audio["frame_count"] > 0
            and decoded_audio["presentation_timestamp_count"] == decoded_audio["frame_count"]
            and decoded_audio["maximum_presentation_timestamp_gap_seconds"] is not None
            and decoded_audio["maximum_presentation_timestamp_gap_seconds"]
            <= AUDIO_PRESENTATION_GAP_LIMIT_SECONDS
            and decoded_audio["stderr_empty"]
            and result["timestamps"]["audio_video_duration_difference_seconds"] is not None
            and result["timestamps"]["audio_video_duration_difference_seconds"]
            <= VIDEO_PRESENTATION_GAP_LIMIT_SECONDS
            and result["timestamps"]["audio_video_end_difference_seconds"] is not None
            and result["timestamps"]["audio_video_end_difference_seconds"]
            <= AV_END_DIFFERENCE_LIMIT_SECONDS
        )
        result["timestamp_limits_seconds"] = {
            "dts_backward_tolerance": TIMESTAMP_BACKWARD_TOLERANCE_SECONDS,
            "video_frame_interval_tolerance": VIDEO_FRAME_INTERVAL_TOLERANCE_SECONDS,
            "video_pts_dts_offset": VIDEO_PTS_DTS_OFFSET_LIMIT_SECONDS,
            "audio_pts_dts_offset": AUDIO_PTS_DTS_OFFSET_LIMIT_SECONDS,
            "decoded_video_pts_gap": VIDEO_PRESENTATION_GAP_LIMIT_SECONDS,
            "decoded_audio_pts_gap": AUDIO_PRESENTATION_GAP_LIMIT_SECONDS,
            "audio_video_end_difference": AV_END_DIFFERENCE_LIMIT_SECONDS,
        }
        result["timestamp_event_limits"] = {
            "bounded_audio_backward_steps": max_bounded_audio_backward_steps,
        }
        result["timestamp_thresholds_passed"] = timestamp_ok

        mark_self_test_stage("secrets")
        print("[7/8] Scanning logs, files and process metadata for test-token residue", flush=True)
        if feeder is not None or publisher is not None or primary_helper is not None:
            raise TestFailure("primary source remained active before the secret scan")
        safe_stop(dut, process_group=True)
        dut = None
        safe_stop(sink)
        sink = None
        for handle in log_handles:
            handle.flush()
        result["secret_scan"] = scan_for_markers(
            markers, work, authorized_configs, journal_since_epoch
        )
        result["secret_scan"]["process_list_or_environment_hit_after_publishers_stopped"] = (
            result["secret_scan"]["process_cmdline_hit"]
            or result["secret_scan"]["process_environment_hit"]
        )
        if (
            result["secret_scan"]["unexpected_file_hits"]
            or result["secret_scan"]["journal_hit"]
            or result["secret_scan"]["process_cmdline_hit"]
            or result["secret_scan"]["process_environment_hit"]
        ):
            raise TestFailure("test-token residue was detected")

        current_ports = [f"{kind}/{port}" for kind, port in ports if not port_is_free(kind, port)]
        result["test_ports_released"] = not current_ports
        if current_ports:
            raise TestFailure("one or more isolated test ports remained open")
        result["status"] = "PASS"
    except Exception as exc:
        result["status"] = "FAIL"
        result["failure"] = redact_markers(str(exc), markers)
        for handle in log_handles:
            with contextlib.suppress(OSError):
                handle.flush()
        try:
            result["sanitized_diagnostics"] = collect_sanitized_failure_diagnostics(
                work,
                markers,
            )
        except (OSError, TestFailure) as diagnostic_exc:
            result["sanitized_diagnostics"] = {
                "collection": [f"[unavailable: {type(diagnostic_exc).__name__}]"],
            }
        result["result_phase"] = "pre-cleanup"
        result["finished_utc"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        try:
            persist_sanitized_results(result_files, result, markers)
            failure_checkpoint_saved = True
        except (OSError, TypeError, ValueError, TestFailure) as save_exc:
            print(
                f"Unable to save sanitized failure checkpoint: {type(save_exc).__name__}",
                file=sys.stderr,
                flush=True,
            )
        print(f"Self-test failed: {result['failure']}", file=sys.stderr, flush=True)
    finally:
        cleanup_errors = []
        for pending_segment in pending_strict_sink_segments:
            try:
                pending_segment["path"].unlink(missing_ok=True)
            except OSError as exc:
                cleanup_errors.append(f"sink-segment: {type(exc).__name__}")
        if result.get("status") == "PASS":
            try:
                mark_self_test_stage("cleanup")
            except (OSError, TestFailure) as exc:
                cleanup_errors.append(f"diagnostic-stage: {type(exc).__name__}")
        for item in handled_signals:
            signal.signal(item, signal.SIG_IGN)
        if observer is not None and observer.is_alive():
            observer.finish()
            if observer.is_alive():
                cleanup_errors.append("observer: ThreadDidNotStop")
        if capture_observer is not None and capture_observer.is_alive():
            capture_observer.finish()
            if capture_observer.is_alive():
                cleanup_errors.append("capture-observer: ThreadDidNotStop")
        if feeder is not None:
            if not feeder.finish():
                cleanup_errors.append("live-feeder: ThreadDidNotStop")
            feeder = None
        if primary_helper is not None:
            if not safe_stop(primary_helper, force=True):
                cleanup_errors.append(f"process-{primary_helper.pid}: DidNotStop")
            primary_helper = None
        if publisher is not None:
            if not safe_stop(publisher, force=True):
                cleanup_errors.append(f"process-{publisher.pid}: DidNotStop")
            publisher = None
        if transition_log_descriptor is not None:
            with contextlib.suppress(OSError):
                os.close(transition_log_descriptor)
            transition_log_descriptor = None
        for process in reversed(processes):
            if not safe_stop(
                process,
                force=True,
                process_group=process.pid in process_group_pids,
            ):
                cleanup_errors.append(f"process-{process.pid}: DidNotStop")
        test_normalizers_stopped = (
            terminate_test_normalizer_supervisors(work) if control_token_path is not None else True
        )
        if not test_normalizers_stopped:
            cleanup_errors.append("test-normalizer: DidNotStop")
        lingering_ports = [f"{kind}/{port}" for kind, port in ports if not port_is_free(kind, port)]
        if lingering_ports:
            cleanup_errors.append("ports: " + ",".join(lingering_ports))
        for handle in log_handles:
            with contextlib.suppress(OSError):
                handle.close()
        if result.get("status") == "FAIL":
            try:
                result["sanitized_diagnostics"] = collect_sanitized_failure_diagnostics(
                    work,
                    markers,
                )
            except (OSError, TestFailure) as diagnostic_exc:
                result["sanitized_diagnostics"] = {
                    "collection": [f"[unavailable: {type(diagnostic_exc).__name__}]"],
                }
            if capture.exists() and result.get("failure") in {
                "capture decoder validation failed",
                "capture frame validation failed",
                "capture timestamp validation failed",
            }:
                try:
                    debug_capture = TEST_ROOT / "debug-capture.flv"
                    shutil.copyfile(capture, debug_capture)
                    os.chmod(debug_capture, 0o600)
                    result["debug_capture"] = str(debug_capture)
                except OSError as exc:
                    result["debug_capture_error"] = type(exc).__name__

        wiped, workdir_removed, workdir_cleanup_errors = cleanup_test_workdir_after_supervisors(
            work,
            secret_configs,
            supervisors_stopped=test_normalizers_stopped,
        )
        cleanup_errors.extend(workdir_cleanup_errors)
        if not test_normalizers_stopped:
            result["cleanup_identity_anchor_preserved"] = True
        result["secret_configs_wiped"] = wiped
        result["workdir_removed"] = workdir_removed
        if cleanup_errors:
            result["status"] = "FAIL"
            result["cleanup_failure"] = cleanup_errors
            print("Self-test cleanup failed; result forced to FAIL.", file=sys.stderr, flush=True)

        result["finished_utc"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        result["result_phase"] = "final"
        result["failure_checkpoint_saved"] = failure_checkpoint_saved
        try:
            persist_sanitized_results(result_files, result, markers)
        except (OSError, TypeError, ValueError, TestFailure) as exc:
            result["status"] = "FAIL"
            result_save_failed = True
            print(f"Unable to save sanitized test result: {type(exc).__name__}", file=sys.stderr)
        if result["status"] == "PASS" and not result_save_failed:
            print("[8/8] Local relay continuity test: PASS", flush=True)
        os.close(lock_fd)
        for item, previous in previous_signal_handlers.items():
            signal.signal(item, previous)
    return 0 if result["status"] == "PASS" and not result_save_failed else 1


if __name__ == "__main__":
    raise SystemExit(main())
