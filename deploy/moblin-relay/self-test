            raise TestFailure("local RTMP sink path did not become ready")

        reader = subprocess.Popen([
            str(FFMPEG), "-nostdin", "-hide_banner", "-loglevel", "warning", "-y",
            "-i", f"rtmp://127.0.0.1:{SINK_RTMP_PORT}/live/sink",
            "-map", "0:v:0", "-map", "0:a:0", "-c", "copy", "-f", "mpegts", str(capture),
        ], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=reader_log)
        processes.append(reader)
        wait_file_growth(capture, 200_000)
        observer = Observer(dut, sink, reader, capture)
        capture_observer = CaptureObserver(capture)
        observer.start()
        capture_observer.start()
        initial = observer.wait_sample(
            "initial healthy SLATE",
            lambda sample: (
                sample.get("path_ready")
                and not sample.get("ingest_live")
                and not sample.get("normalized")
                and not sample.get("live")
                and sample.get("forward")
                and len(sample.get("sink_ids", [])) == 1
            ),
            5,
        )
        initial_sink_id = initial["sink_ids"][0]
        observer_coverage_started = float(initial["finished"])

        def assert_clean_process_metadata(command: list[str]) -> None:
            command_blob = b"\0".join(item.encode() for item in command)
            environment_blob = b"\0".join(
                f"{key}={value}".encode(errors="surrogateescape") for key, value in os.environ.items()
            )
            if any(marker in command_blob or marker in environment_blob for marker in markers):
                raise TestFailure("a test SRT token entered process arguments or environment before launch")

        def start_source_helper(config: Path, label: str, metrics_port: int) -> subprocess.Popen:
            helper_log = (work / f"source-{label}.log").open("wb")
            log_handles.append(helper_log)
            command = [str(MEDIAMTX), str(config)]
            assert_clean_process_metadata(command)
            process = subprocess.Popen(
                command,
                stdin=subprocess.DEVNULL,
                stdout=helper_log,
                stderr=subprocess.STDOUT,
                cwd=work,
            )
            processes.append(process)
            wait_tcp(metrics_port)
            return process

        def start_local_publisher(rtmp_port: int) -> subprocess.Popen:
            command = local_rtmp_publisher_command(live, rtmp_port)
            assert_clean_process_metadata(command)
            process = subprocess.Popen(
                command,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            processes.append(process)
            return process

        def stop_primary_srt_source(label: str) -> None:
            nonlocal primary_helper, publisher
            if primary_helper is None or publisher is None:
                raise TestFailure(f"primary source is missing before {label}")
            if not safe_stop(primary_helper, force=True):
                raise TestFailure(f"SRT source helper did not stop during {label}")
            primary_helper = None
            if not safe_stop(publisher, force=True):
                raise TestFailure(f"publisher did not stop during {label}")
            publisher = None
            wait_ports_released((
                ("tcp", SOURCE_PRIMARY_RTMP_PORT),
                ("tcp", SOURCE_PRIMARY_METRICS_PORT),
            ))

        def wait_healthy_live(
            description: str,
            timeout: float,
            *,
            not_before: float = 0.0,
            expected_ingest_ids: list[str] | None = None,
        ) -> dict:
            return observer.wait_sample(
                description,
                lambda sample: (
                    sample.get("live")
                    and sample.get("normalized")
                    and sample.get("path_ready")
                    and sample.get("forward")
                    and sample.get("sink_ids") == [initial_sink_id]
                    and (
                        expected_ingest_ids is None
                        or sample.get("ingest_ids") == expected_ingest_ids
                    )
                ),
                timeout,
                not_before=not_before,
            )

        def wait_slate_with_live_srt(
            description: str,
            transition_started: float,
            expected_ingest_ids: list[str],
        ) -> dict:
            remaining = LIVE_TO_SLATE_DEADLINE_SECONDS - (
                time.monotonic() - transition_started
            )
            if remaining <= 0:
                raise TestFailure(f"{description} exceeded the SLATE deadline")
            sample = observer.wait_sample(
                description,
                lambda item: (
                    not item.get("normalized")
                    and not item.get("live")
                    and item.get("ingest_live")
                    and item.get("ingest_ids") == expected_ingest_ids
                    and item.get("path_ready")
                    and item.get("forward")
                    and item.get("sink_ids") == [initial_sink_id]
                ),
                remaining,
                not_before=transition_started,
            )
            elapsed = float(sample["t"]) - transition_started
            if elapsed > LIVE_TO_SLATE_DEADLINE_SECONDS:
                raise TestFailure(f"{description} exceeded the SLATE deadline")
            return sample

        def wait_slate_capture_growth(description: str, slate_sample: dict) -> dict:
            if not complete_metrics_sample(slate_sample):
                raise TestFailure(f"invalid SLATE sample while waiting for {description}")
            return capture_observer.wait_growth(
                description,
                SLATE_CAPTURE_GROWTH_BYTES,
                SLATE_CAPTURE_GROWTH_TIMEOUT_SECONDS,
            )

        def wait_srt_idle_expiry(
            description: str,
            outage_started: float,
        ) -> tuple[dict, float]:
            remaining = SRT_IDLE_UPPER_BOUND_SECONDS - (
                time.monotonic() - outage_started
            )
            if remaining <= 0:
                raise TestFailure(f"{description} exceeded the SRT idle timeout bound")
            sample = observer.wait_sample(
                description,
                lambda item: (
                    not item.get("ingest_live")
                    and not item.get("normalized")
                    and not item.get("live")
                    and item.get("path_ready")
                    and item.get("forward")
                    and item.get("sink_ids") == [initial_sink_id]
                ),
                remaining,
                not_before=outage_started,
            )
            elapsed = float(sample["t"]) - outage_started
            if not SRT_IDLE_LOWER_BOUND_SECONDS <= elapsed <= SRT_IDLE_UPPER_BOUND_SECONDS:
                raise TestFailure(f"{description} violated the configured SRT idle tolerance")
            return sample, elapsed

        def reject_with_helper(config: Path, label: str) -> int:
            helper = start_source_helper(config, label, SOURCE_AUX_METRICS_PORT)
            candidate = start_local_publisher(SOURCE_AUX_RTMP_PORT)
            observation_started = time.monotonic()
            try:
                wait_helper_path(SOURCE_AUX_METRICS_PORT)
                forward_error_seen = False
                deadline = time.monotonic() + 12
                while time.monotonic() < deadline:
                    forward_error_seen = forward_error_seen or helper_forward_error(SOURCE_AUX_METRICS_PORT)
                    sample = observer.checked_snapshot(label)
                    if sample and not all(
                        sample.get(name) for name in ("dut_alive", "sink_alive", "reader_alive")
                    ):
                        raise TestFailure(f"continuity failed while checking {label}")
                    if candidate.poll() is not None or helper.poll() is not None:
                        raise TestFailure(f"local source path exited while checking {label}")
                    if not complete_metrics_sample(sample):
                        time.sleep(0.1)
                        continue
                    if sample.get("live"):
                        raise TestFailure(f"{label} caused a transient LIVE state")
                    if not all(sample.get(name) for name in ("path_ready", "forward")):
                        raise TestFailure(f"continuity failed while checking {label}")
                    if sample.get("sink_ids") != [initial_sink_id]:
                        raise TestFailure(f"downstream identity changed while checking {label}")
                    time.sleep(0.1)
                observation_finished = time.monotonic()
                observed_interval = observer.samples_between(
                    observation_started, observation_finished
                )
                require_metrics_coverage(
                    observed_interval,
                    observation_started,
                    observation_finished,
                    label,
                )
                interval = [
                    sample
                    for sample in observed_interval
                    if complete_metrics_sample(sample)
                ]
                if not interval or any(sample.get("live") for sample in interval):
                    raise TestFailure(f"{label} was not rejected for the full observer interval")
                if not forward_error_seen:
                    raise TestFailure(f"{label} did not produce a verified SRT forward rejection")
                return len(interval)
            finally:
                safe_stop(candidate, force=True)
                safe_stop(helper)
                wait_ports_released((
                    ("tcp", SOURCE_AUX_RTMP_PORT),
                    ("tcp", SOURCE_AUX_METRICS_PORT),
                ))

        mark_self_test_stage("auth")
        print("[3/8] Verifying SRT authentication/encryption, SLATE -> LIVE and publisher exclusivity", flush=True)

        wrong_password = password + "X"
        wrong_passphrase = ("A" if passphrase[0] != "A" else "B") + passphrase[1:]
        markers.extend((wrong_password.encode(), wrong_passphrase.encode()))
        wrong_password_config = write_source_config(
            work, "wrong-password", user, wrong_password, passphrase,
            SOURCE_AUX_RTMP_PORT, SOURCE_AUX_METRICS_PORT,
        )
        wrong_passphrase_config = write_source_config(
            work, "wrong-passphrase", user, password, wrong_passphrase,
            SOURCE_AUX_RTMP_PORT, SOURCE_AUX_METRICS_PORT,
        )
        secret_configs.update((wrong_password_config, wrong_passphrase_config))
        authorized_configs.update((wrong_password_config, wrong_passphrase_config))
        password_samples = reject_with_helper(wrong_password_config, "wrong SRT password")
        passphrase_samples = reject_with_helper(wrong_passphrase_config, "wrong SRT passphrase")
        result["wrong_srt_password_rejected"] = True
        result["wrong_srt_passphrase_rejected"] = True
        result["negative_auth_observer_samples"] = {
            "wrong_password": password_samples,
            "wrong_passphrase": passphrase_samples,
        }

        mark_self_test_stage("auth-source")
        primary_config = write_source_config(
            work, "primary", user, password, passphrase,
            SOURCE_PRIMARY_RTMP_PORT, SOURCE_PRIMARY_METRICS_PORT,
        )
        secret_configs.add(primary_config)
        authorized_configs.add(primary_config)
        primary_helper = start_source_helper(primary_config, "primary", SOURCE_PRIMARY_METRICS_PORT)
        publisher = start_local_publisher(SOURCE_PRIMARY_RTMP_PORT)
        wait_helper_path(SOURCE_PRIMARY_METRICS_PORT)
        initial_live_started = time.monotonic()
        initial_live_deadline = initial_live_started + 20
        mark_self_test_stage("live-ingest")
        accepted_ingest = observer.wait_sample(
            "initial authenticated SRT ingest",
            lambda sample: (
                sample.get("ingest_live")
                and len(sample.get("ingest_ids", [])) == 1
                and sample.get("path_ready")
                and sample.get("forward")
                and sample.get("sink_ids") == [initial_sink_id]
            ),
            max(0.0, initial_live_deadline - time.monotonic()),
            not_before=initial_live_started,
        )
        mark_self_test_stage("live-normalize")
        try:
            initial_live = wait_healthy_live(
                "initial healthy LIVE",
                max(0.0, initial_live_deadline - time.monotonic()),
                not_before=float(accepted_ingest["t"]),
                expected_ingest_ids=list(accepted_ingest["ingest_ids"]),
            )
        except TestFailure:
            normalization_interval = observer.samples_between(
                float(accepted_ingest["t"]), time.monotonic()
            )
            if any(sample.get("normalized") for sample in normalization_interval):
                mark_self_test_stage("norm-flap")
            else:
                supervisor_pids = matching_process_ids(
                    (b"moblin-relay-normalize", b"--sanitized-supervisor")
                )
                child_pids = sorted(
                    {
                        child_pid
                        for supervisor_pid in supervisor_pids
                        for child_pid in direct_child_process_ids(supervisor_pid)
                    }
                )
                if not supervisor_pids:
                    mark_self_test_stage("norm-hook")
                elif not child_pids:
                    mark_self_test_stage("norm-child")
                else:
                    mark_self_test_stage("norm-publish")
            raise
        initial_ingest_ids = list(initial_live["ingest_ids"])
        if len(initial_ingest_ids) != 1:
            raise TestFailure("initial LIVE did not expose exactly one SRT connection")
        result["initial_slate_to_live_seconds"] = round(
            float(initial_live["t"]) - initial_live_started,
            3,
        )
        if publisher.poll() is not None or primary_helper.poll() is not None:
            raise TestFailure("primary source path exited unexpectedly")

        mark_self_test_stage("auth-scan")
        for handle in log_handles:
            handle.flush()
        result["secret_scan_while_live"] = scan_for_markers(
            markers, work, authorized_configs, journal_since_epoch
        )
        live_scan = result["secret_scan_while_live"]
        if (live_scan["unexpected_file_hits"] or live_scan["journal_hit"]
                or live_scan["process_cmdline_hit"] or live_scan["process_environment_hit"]):
            raise TestFailure("test-token exposure was detected while LIVE was active")

        mark_self_test_stage("auth-exclusive")
        second_config = write_source_config(
            work, "second", user, password, passphrase,
            SOURCE_AUX_RTMP_PORT, SOURCE_AUX_METRICS_PORT,
        )
        secret_configs.add(second_config)
        authorized_configs.add(second_config)
        second_helper = start_source_helper(second_config, "second", SOURCE_AUX_METRICS_PORT)
        second = start_local_publisher(SOURCE_AUX_RTMP_PORT)
        second_started = time.monotonic()
        try:
            wait_helper_path(SOURCE_AUX_METRICS_PORT)
            second_error_seen = False
            deadline = time.monotonic() + 12
            while time.monotonic() < deadline:
                second_error_seen = second_error_seen or helper_forward_error(SOURCE_AUX_METRICS_PORT)
                sample = observer.checked_snapshot("second-publisher test")
                if sample and not all(
                    sample.get(name) for name in ("dut_alive", "sink_alive", "reader_alive")
                ):
                    raise TestFailure("a core process exited during second-publisher test")
                if second.poll() is not None or second_helper.poll() is not None:
                    raise TestFailure("second local source path exited before DUT rejection was verified")
                if publisher.poll() is not None or primary_helper.poll() is not None:
                    raise TestFailure("primary source path exited during second-publisher test")
                if not complete_metrics_sample(sample):
                    time.sleep(0.1)
                    continue
                if not sample.get("live") or sample.get("sink_ids") != [initial_sink_id]:
                    raise TestFailure("second SRT publisher disrupted the primary publisher")
                time.sleep(0.1)
            second_finished = time.monotonic()
            second_observed_interval = observer.samples_between(
                second_started, second_finished
            )
            require_metrics_coverage(
                second_observed_interval,
                second_started,
                second_finished,
                "second-publisher test",
            )
            second_interval = [
                sample
                for sample in second_observed_interval
                if complete_metrics_sample(sample)
            ]
            result["second_publisher_observer_samples"] = len(second_interval)
            result["second_publisher_rejected"] = (
                bool(second_interval)
                and all(sample.get("live") for sample in second_interval)
                and all(sample.get("sink_ids") == [initial_sink_id] for sample in second_interval)
                and second_error_seen
            )
        finally:
            safe_stop(second, force=True)
            safe_stop(second_helper)
            wait_ports_released((
                ("tcp", SOURCE_AUX_RTMP_PORT),
                ("tcp", SOURCE_AUX_METRICS_PORT),
            ))
        if not result["second_publisher_rejected"]:
            raise TestFailure("second publisher rejection failed")

        mark_self_test_stage("outages")
        print("  checking a recoverable same-session media stall", flush=True)
        mark_self_test_stage("stall-slate")
        before_pause = wait_healthy_live(
            "healthy LIVE before same-session stall",
            5,
            expected_ingest_ids=initial_ingest_ids,
        )
        previous_normalizer_ids = list(before_pause["normalized_ids"])
        if len(previous_normalizer_ids) != 1:
            raise TestFailure("same-session stall precondition lacks one normalizer")
        time.sleep(0.35)
        same_session_started = time.monotonic()
        publisher_paused = False
        try:
            os.kill(publisher.pid, signal.SIGSTOP)
            publisher_paused = True
            same_session_slate = wait_slate_with_live_srt(
                "same-session SLATE transition",
                same_session_started,
                initial_ingest_ids,
            )
            wait_slate_capture_growth(
                "same-session SLATE capture growth",
                same_session_slate,
            )
            mark_self_test_stage("stall-live")
            if time.monotonic() - same_session_started >= SRT_IDLE_LOWER_BOUND_SECONDS:
                raise TestFailure("same-session source was not resumed before SRT idle expiry")
            recovery_started = time.monotonic()
            os.kill(publisher.pid, signal.SIGCONT)
            publisher_paused = False
            same_session_live = wait_healthy_live(
                "same-session LIVE recovery",
                6,
                not_before=recovery_started,
                expected_ingest_ids=initial_ingest_ids,
            )
        finally:
            if publisher_paused and publisher is not None and publisher.poll() is None:
                os.kill(publisher.pid, signal.SIGCONT)
        if publisher.poll() is not None or primary_helper.poll() is not None:
            raise TestFailure("same-session recovery replaced the upstream processes")
        if same_session_live["normalized_ids"] == previous_normalizer_ids:
            raise TestFailure("same-session recovery did not replace the normalizer publisher")
        mark_self_test_stage("stall-cont")
        same_session_samples = capture_observer.checked_samples_since(
            same_session_started,
            "same-session recovery",
        )
        same_session_no_growth = maximum_capture_no_growth_seconds(
            same_session_samples
        )
        if same_session_no_growth > CAPTURE_NO_GROWTH_LIMIT_SECONDS:
            raise TestFailure("downstream media stalled during same-session recovery")
        result["same_session_stall"] = {
            "srt_connection_preserved": True,
            "upstream_processes_preserved": True,
            "normalizer_reconnected": True,
            "to_slate_seconds": round(
                float(same_session_slate["t"]) - same_session_started,
                3,
            ),
            "to_live_seconds": round(
                float(same_session_live["t"]) - recovery_started,
                3,
            ),
            "max_capture_no_growth_seconds": round(same_session_no_growth, 3),
        }

        print("  checking supervisor crash containment and automatic recovery", flush=True)
        mark_self_test_stage("crash-death")
        before_crash = wait_healthy_live(
            "healthy LIVE before supervisor crash",
            5,
            expected_ingest_ids=initial_ingest_ids,
        )
        old_normalizer_ids = list(before_crash["normalized_ids"])
        supervisor_ids = matching_process_ids(
            (str(NORMALIZER).encode(), b"--sanitized-supervisor")
        )
        if len(supervisor_ids) != 1:
            raise TestFailure("unable to identify exactly one normalizer supervisor")
        old_supervisor_pid = supervisor_ids[0]
        old_children = direct_child_process_ids(old_supervisor_pid)
        if len(old_children) != 1:
            raise TestFailure("normalizer supervisor does not own exactly one child")
        old_child_pid = old_children[0]
        old_child_command = Path(f"/proc/{old_child_pid}/cmdline").read_bytes()
        if str(FFMPEG).encode() not in old_child_command or OUTPUT_PATH.encode() not in old_child_command:
            raise TestFailure("normalizer child identity is invalid")
        supervisor_crash_started = time.monotonic()
        os.kill(old_supervisor_pid, signal.SIGKILL)
        if not wait_process_exit(old_supervisor_pid, 1.0):
            raise TestFailure("killed normalizer supervisor remained present")
        if not wait_process_exit(old_child_pid, 1.0):
            raise TestFailure("FFmpeg child survived its supervisor")
        crash_slate = wait_slate_with_live_srt(
            "supervisor-crash SLATE transition",
            supervisor_crash_started,
            initial_ingest_ids,
        )
        wait_slate_capture_growth(
            "supervisor-crash SLATE capture growth",
            crash_slate,
        )
        mark_self_test_stage("crash-live")
        crash_recovery_started = time.monotonic()
        crash_live = wait_healthy_live(
            "supervisor-crash LIVE recovery",
            SUPERVISOR_RESTART_TIMEOUT_SECONDS,
            not_before=crash_recovery_started,
            expected_ingest_ids=initial_ingest_ids,
        )
        if crash_live["normalized_ids"] == old_normalizer_ids:
            raise TestFailure("supervisor crash reused the old normalizer connection")
        mark_self_test_stage("crash-cont")
        replacement_supervisors = matching_process_ids(
            (str(NORMALIZER).encode(), b"--sanitized-supervisor")
        )
        if len(replacement_supervisors) != 1 or replacement_supervisors[0] == old_supervisor_pid:
            raise TestFailure("normalizer supervisor was not replaced cleanly")
        crash_samples = capture_observer.checked_samples_since(
            supervisor_crash_started,
            "supervisor recovery",
        )
        crash_no_growth = maximum_capture_no_growth_seconds(crash_samples)
        if crash_no_growth > CAPTURE_NO_GROWTH_LIMIT_SECONDS:
            raise TestFailure("downstream media stalled during supervisor recovery")
        result["supervisor_crash_recovery"] = {
            "ffmpeg_parent_death_passed": True,
            "srt_connection_preserved": True,
            "downstream_connection_preserved": True,
            "max_capture_no_growth_seconds": round(crash_no_growth, 3),
        }

        print("[4/8] Running required outages: " + ", ".join(str(item) + "s" for item in durations), flush=True)
        to_slate_times, to_live_times, srt_idle_times = [], [], []
        outage_capture_stalls = []
        for index, duration in enumerate(durations, start=1):
            before_outage = wait_healthy_live(
                f"healthy LIVE before outage {index}",
                5,
            )
            outage_ingest_ids = list(before_outage["ingest_ids"])
            if len(outage_ingest_ids) != 1:
                raise TestFailure(f"outage {index} precondition lacks one SRT connection")
            outage_started = time.monotonic()
            mark_self_test_stage("outage-slate")
            stop_primary_srt_source(f"outage {index}")
            mark_self_test_stage("outage-normal")
            detached = wait_slate_with_live_srt(
                f"outage {index} SLATE transition",
                outage_started,
                outage_ingest_ids,
            )
            to_slate = float(detached["t"]) - outage_started
            wait_slate_capture_growth(
                f"outage {index} SLATE capture growth",
                detached,
            )
            _srt_expired, srt_idle_elapsed = wait_srt_idle_expiry(
                f"outage {index} SRT idle expiry",
                outage_started,
            )
            to_slate_times.append(round(to_slate, 3))
            srt_idle_times.append(round(srt_idle_elapsed, 3))
            print(f"  outage {index}/3: SLATE active; total SRT outage target {duration}s", flush=True)
            mark_self_test_stage("outage-hold")
            while time.monotonic() - outage_started < duration:
                sample = observer.checked_snapshot(f"outage {index}")
                if sample and not all(
                    sample.get(name) for name in ("dut_alive", "sink_alive", "reader_alive")
                ):
                    raise TestFailure(f"continuity failed during outage {index}")
                if not complete_metrics_sample(sample):
                    remaining = duration - (time.monotonic() - outage_started)
                    if remaining <= 0:
                        break
                    time.sleep(min(1.0, remaining))
                    continue
                if not all(sample.get(name) for name in ("path_ready", "forward")):
                    raise TestFailure(f"continuity failed during outage {index}")
                if sample.get("ingest_live") or sample.get("normalized") or sample.get("live"):
                    raise TestFailure(f"LIVE state returned unexpectedly during outage {index}")
                if sample.get("sink_ids") != [initial_sink_id]:
                    raise TestFailure(f"downstream RTMP identity changed during outage {index}")
                remaining = duration - (time.monotonic() - outage_started)
                if remaining <= 0:
                    break
                time.sleep(min(1.0, remaining))
            recovery_started = time.monotonic()
            require_metrics_coverage(
                observer.samples_between(outage_started, recovery_started),
                outage_started,
                recovery_started,
                f"outage {index}",
            )
            outage_samples = capture_observer.checked_samples_since(
                float(detached["t"]),
                f"outage {index}",
            )
            outage_no_growth = maximum_capture_no_growth_seconds(outage_samples)
            if outage_no_growth > CAPTURE_NO_GROWTH_LIMIT_SECONDS:
                raise TestFailure(f"downstream media stalled during outage {index}")
            outage_capture_stalls.append(round(outage_no_growth, 3))
            mark_self_test_stage("outage-live")
            primary_helper = start_source_helper(
                primary_config, f"primary-recovery-{index}", SOURCE_PRIMARY_METRICS_PORT
            )
            publisher = start_local_publisher(SOURCE_PRIMARY_RTMP_PORT)
            wait_helper_path(SOURCE_PRIMARY_METRICS_PORT)
            recovered = wait_healthy_live(
                f"outage {index} LIVE recovery",
                20,
                not_before=recovery_started,
            )
            to_live = float(recovered["t"]) - recovery_started
            to_live_times.append(round(to_live, 3))
            print(f"  outage {index}/3: LIVE restored", flush=True)
            time.sleep(3 if not args.quick else 1)
        result["live_to_slate_seconds"] = to_slate_times
        result["slate_to_live_seconds"] = to_live_times
        result["srt_idle_expiry_seconds"] = srt_idle_times
        result["outage_max_capture_no_growth_seconds"] = outage_capture_stalls

        mark_self_test_stage("continuity")
        print("[5/8] Checking uninterrupted downstream identity and capture growth", flush=True)
        before_final = wait_healthy_live("healthy LIVE before final transition", 5)
        final_ingest_ids = list(before_final["ingest_ids"])
        if len(final_ingest_ids) != 1:
            raise TestFailure("final transition precondition lacks one SRT connection")
        final_started = time.monotonic()
        stop_primary_srt_source("final continuity transition")
        final_slate = wait_slate_with_live_srt(
            "final SLATE transition",
            final_started,
            final_ingest_ids,
        )
        wait_slate_capture_growth("final SLATE capture growth", final_slate)
        _final_expired, final_srt_idle = wait_srt_idle_expiry(
            "final SRT idle expiry",
            final_started,
        )
        time.sleep(1)
        final_finished = time.monotonic()
        observer.checked_snapshot("final transition")
        final_samples = capture_observer.checked_samples_since(
            float(final_slate["t"]),
            "final transition",
        )
        capture_samples = capture_observer.checked_samples_since(
            observer_coverage_started,
            "complete self-test",
        )
        capture_observer.finish()
        observer.finish()
        samples = observer.samples
        result["max_metrics_blind_seconds"] = round(
            require_metrics_coverage(
                samples,
                observer_coverage_started,
                final_finished,
                "complete self-test",
            ),
            3,
        )
        final_no_growth = maximum_capture_no_growth_seconds(final_samples)
        if final_no_growth > CAPTURE_NO_GROWTH_LIMIT_SECONDS:
            raise TestFailure("downstream media stalled during final transition")
        result["final_transition"] = {
            "to_slate_seconds": round(float(final_slate["t"]) - final_started, 3),
            "srt_idle_expiry_seconds": round(final_srt_idle, 3),
            "max_capture_no_growth_seconds": round(final_no_growth, 3),
        }
        result["observer_samples"] = len(samples)
        result["capture_observer_samples"] = len(capture_samples)
        result["overall_max_capture_no_growth_seconds"] = round(
            maximum_capture_no_growth_seconds(capture_samples),
            3,
        )
        if result["overall_max_capture_no_growth_seconds"] > CAPTURE_NO_GROWTH_LIMIT_SECONDS:
            raise TestFailure("downstream media stalled during the complete self-test")
        valid_sink_samples = [sample for sample in samples if sample.get("sink_metrics_ok")]
        result["downstream_unique_rtmp_ids"] = sorted(
            {item for sample in valid_sink_samples for item in sample["sink_ids"]}
        )
        result["downstream_missing_samples"] = sum(
            1 for sample in valid_sink_samples if sample["sink_ids"] != [initial_sink_id]
        )
        result["reader_survived_all_switches"] = reader.poll() is None
        result["max_rss_kib"] = observer.max_rss_kib
        result["max_cpu_percent"] = {key: round(value, 2) for key, value in observer.max_cpu_percent.items()}
        result["average_cpu_percent"] = {
            key: round(value, 2) for key, value in observer.average_cpu_percent().items()
        }
        result["capture_bytes"] = capture.stat().st_size
        if result["downstream_unique_rtmp_ids"] != [initial_sink_id] or result["downstream_missing_samples"] != 0:
            raise TestFailure("downstream RTMP session was not continuous")
        if not result["reader_survived_all_switches"]:
            raise TestFailure("long-lived downstream reader exited")

        safe_stop(reader)
        reader = None
        for handle in log_handles:
            handle.flush()
        mark_self_test_stage("decode")
        print("[6/8] Decoding capture and checking portrait frames, DTS/PTS and A/V continuity", flush=True)
        mark_self_test_stage("streams")
        normalized_signature = stream_signature(capture, include_gop=False)
        normalized_streams = normalized_signature.get("streams", [])
        if len(normalized_streams) != 2:
            raise TestFailure("normalized capture does not contain exactly video and audio")
        normalized_video, normalized_audio = normalized_streams
        mark_self_test_stage("format")
        if (
            normalized_video.get("codec_name") != "h264"
            or normalized_video.get("profile") != slate_sig["streams"][0].get("profile")
            or normalized_video.get("level") != slate_sig["streams"][0].get("level")
            or normalized_video.get("width") != PORTRAIT_WIDTH
            or normalized_video.get("height") != PORTRAIT_HEIGHT
            or normalized_video.get("pix_fmt") != "yuv420p"
            or normalized_video.get("r_frame_rate") != f"{VIDEO_FPS}/1"
            or normalized_video.get("avg_frame_rate") != f"{VIDEO_FPS}/1"
            or normalized_audio.get("codec_name") != "aac"
            or normalized_audio.get("profile") != "LC"
            or normalized_audio.get("sample_rate") != "48000"
            or normalized_audio.get("channels") != 2
            or normalized_audio.get("channel_layout") != "stereo"
        ):
            raise TestFailure("mono ingress was not normalized to the required stereo output")
        mark_self_test_stage("gop")
        normalized_signature["video_gop"] = video_gop_signature(capture)
        normalized_gop_intervals = normalized_signature["video_gop"].get(
            "interval_frames", []
        )
        if (
            not normalized_gop_intervals
            or max(normalized_gop_intervals) != VIDEO_GOP_FRAMES
            or any(
                interval < 1 or interval > VIDEO_GOP_FRAMES
                for interval in normalized_gop_intervals
            )
        ):
            raise TestFailure("normalized output GOP exceeded the required 60-frame interval")
        result["normalized_output_streams"] = normalized_streams
        result["mono_to_stereo_normalization_passed"] = True
        mark_self_test_stage("decoder")
        decode = run([
            str(FFMPEG), "-nostdin", "-hide_banner", "-v", "warning", "-xerror", "-err_detect", "explode",
            "-i", str(capture), "-map", "0:v:0", "-map", "0:a:0", "-f", "null", "-",
        ], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        decode_text = decode.stderr.decode(errors="replace")
        deny = re.compile(
            r"Non-monotonous DTS|Invalid DTS|Packet corrupt|corrupt(?:ed)? frame|"
            r"decode error|error while decoding|concealing .* errors|Broken pipe|Connection reset",
            re.I,
        )
        result["decode_exit"] = decode.returncode
        result["decode_error_pattern_found"] = bool(deny.search(decode_text))
        if decode.returncode != 0 or result["decode_error_pattern_found"]:
            raise TestFailure("capture decoder validation failed")

        mark_self_test_stage("frames")
        result["decoded_video_frames"] = analyze_decoded_video_frames(capture)
        decoded_frames = result["decoded_video_frames"]
        landscape_regression_absent = decoded_frames["landscape_1280x720_frames"] == 0
        legacy_portrait_regression_absent = (
            decoded_frames["legacy_portrait_720x1280_frames"] == 0
        )
        result["landscape_1280x720_regression_absent"] = landscape_regression_absent
        result["legacy_portrait_720x1280_regression_absent"] = (
            legacy_portrait_regression_absent
        )
        portrait_frames_ok = (
            decoded_frames["ffprobe_exit"] == 0
            and decoded_frames["frame_count"] > 0
            and decoded_frames["unexpected_dimension_frames"] == 0
            and landscape_regression_absent
            and legacy_portrait_regression_absent
            and decoded_frames["unexpected_pixel_format_frames"] == 0
            and not decoded_frames["decode_error_flags"]
            and decoded_frames["stderr_empty"]
        )
        result["portrait_capture_guard_passed"] = portrait_frames_ok
        if not portrait_frames_ok:
            raise TestFailure("capture frame validation failed")

        mark_self_test_stage("timestamps")
        result["decoded_audio_timestamps"] = analyze_decoded_audio_timestamps(capture)
        result["timestamps"] = analyze_timestamps(capture)
        decoded_audio = result["decoded_audio_timestamps"]
        # Two switch pairs are added by the same-session and supervisor-crash
        # resilience checks; the per-transition allowance itself is unchanged.
        max_bounded_audio_backward_steps = 2 * len(durations) + 6
        bounded_splice_jitter_passed = (
            result["timestamps"]["dts_within_tolerance"]
            and result["timestamps"]["negative_dts_steps"].get(0, 0) == 0
            and result["timestamps"]["negative_dts_steps"].get(1, 0) <= max_bounded_audio_backward_steps
            and not result["timestamps"]["dts_backward_events_beyond_tolerance"]
            and decoded_audio["presentation_timestamp_steps_beyond_tolerance"] == 0
            and decoded_audio["negative_presentation_timestamp_steps"] <= max_bounded_audio_backward_steps
        )
        result["bounded_splice_jitter_passed"] = bounded_splice_jitter_passed
        result["strict_timestamp_monotonicity"] = {
            "packet_dts": result["timestamps"]["strict_dts_monotonic"],
            "decoded_video_pts": decoded_frames["strict_presentation_timestamps_monotonic"],
            "decoded_audio_pts": decoded_audio["strict_presentation_timestamps_monotonic"],
        }
        timestamp_ok = (
            bounded_splice_jitter_passed
            and result["timestamps"]["pts_present_for_every_packet"]
            and result["timestamps"]["ffprobe_exit"] == 0
            and result["timestamps"]["stderr_empty"]
            and result["timestamps"]["max_dts_gap_seconds"].get(0, 999) <= VIDEO_PRESENTATION_GAP_LIMIT_SECONDS
            and result["timestamps"]["max_dts_gap_seconds"].get(1, 999) <= AUDIO_PRESENTATION_GAP_LIMIT_SECONDS
            and result["timestamps"]["max_sorted_pts_gap_seconds"].get(0, 999) <= VIDEO_PRESENTATION_GAP_LIMIT_SECONDS
            and result["timestamps"]["max_sorted_pts_gap_seconds"].get(1, 999) <= AUDIO_PRESENTATION_GAP_LIMIT_SECONDS
            and result["timestamps"]["max_pts_dts_offset_seconds"].get(0, 999) <= VIDEO_PTS_DTS_OFFSET_LIMIT_SECONDS
            and result["timestamps"]["max_pts_dts_offset_seconds"].get(1, 999) <= AUDIO_PTS_DTS_OFFSET_LIMIT_SECONDS
            and result["timestamps"]["video_pts_dts_offset_clusters_over_normal_reorder"]
                <= max_bounded_audio_backward_steps
            and decoded_frames["presentation_timestamp_count"] == decoded_frames["frame_count"]
            and decoded_frames["strict_presentation_timestamps_monotonic"]
            and decoded_frames["maximum_presentation_timestamp_gap_seconds"] is not None
            and decoded_frames["maximum_presentation_timestamp_gap_seconds"]
                <= VIDEO_PRESENTATION_GAP_LIMIT_SECONDS
            and decoded_audio["ffprobe_exit"] == 0
            and decoded_audio["frame_count"] > 0
            and decoded_audio["presentation_timestamp_count"] == decoded_audio["frame_count"]
            and decoded_audio["maximum_presentation_timestamp_gap_seconds"] is not None
            and decoded_audio["maximum_presentation_timestamp_gap_seconds"]
                <= AUDIO_PRESENTATION_GAP_LIMIT_SECONDS
            and decoded_audio["stderr_empty"]
            and result["timestamps"]["audio_video_duration_difference_seconds"] is not None
            and result["timestamps"]["audio_video_duration_difference_seconds"]
                <= VIDEO_PRESENTATION_GAP_LIMIT_SECONDS
            and result["timestamps"]["audio_video_end_difference_seconds"] is not None
            and result["timestamps"]["audio_video_end_difference_seconds"]
                <= AV_END_DIFFERENCE_LIMIT_SECONDS
        )
        result["timestamp_limits_seconds"] = {
            "dts_backward_tolerance": TIMESTAMP_BACKWARD_TOLERANCE_SECONDS,
            "video_pts_dts_offset": VIDEO_PTS_DTS_OFFSET_LIMIT_SECONDS,
            "audio_pts_dts_offset": AUDIO_PTS_DTS_OFFSET_LIMIT_SECONDS,
            "decoded_video_pts_gap": VIDEO_PRESENTATION_GAP_LIMIT_SECONDS,
            "decoded_audio_pts_gap": AUDIO_PRESENTATION_GAP_LIMIT_SECONDS,
            "audio_video_end_difference": AV_END_DIFFERENCE_LIMIT_SECONDS,
        }
        result["timestamp_event_limits"] = {
            "bounded_audio_backward_steps": max_bounded_audio_backward_steps,
            "video_pts_dts_offset_clusters_over_normal_reorder": max_bounded_audio_backward_steps,
        }
        result["timestamp_thresholds_passed"] = timestamp_ok
        if not timestamp_ok:
            mark_self_test_stage(
                timestamp_failure_stage(
                    result["timestamps"],
                    decoded_frames,
                    decoded_audio,
                    max_bounded_audio_backward_steps,
                )
            )
            raise TestFailure("capture timestamp validation failed")

        mark_self_test_stage("secrets")
        print("[7/8] Scanning logs, files and process metadata for test-token residue", flush=True)
        safe_stop(primary_helper)
        primary_helper = None
        safe_stop(dut, process_group=True)
        dut = None
        safe_stop(sink)
        sink = None
        for handle in log_handles:
            handle.flush()
        result["secret_scan"] = scan_for_markers(
            markers, work, authorized_configs, journal_since_epoch
        )
        result["secret_scan"]["process_list_or_environment_hit_after_publishers_stopped"] = (
            result["secret_scan"]["process_cmdline_hit"]
            or result["secret_scan"]["process_environment_hit"]
        )
        if (result["secret_scan"]["unexpected_file_hits"] or result["secret_scan"]["journal_hit"]
                or result["secret_scan"]["process_cmdline_hit"]
                or result["secret_scan"]["process_environment_hit"]):
            raise TestFailure("test-token residue was detected")

        current_ports = [f"{kind}/{port}" for kind, port in ports if not port_is_free(kind, port)]
        result["test_ports_released"] = not current_ports
        if current_ports:
            raise TestFailure("one or more isolated test ports remained open")
        result["status"] = "PASS"
    except Exception as exc:
        result["status"] = "FAIL"
        result["failure"] = redact_markers(str(exc), markers)
        print(f"Self-test failed: {result['failure']}", file=sys.stderr, flush=True)
    finally:
        cleanup_errors = []
        if result.get("status") == "PASS":
            try:
                mark_self_test_stage("cleanup")
            except (OSError, TestFailure) as exc:
                cleanup_errors.append(f"diagnostic-stage: {type(exc).__name__}")
        for item in handled_signals:
            signal.signal(item, signal.SIG_IGN)
        if observer is not None and observer.is_alive():
            observer.finish()
            if observer.is_alive():
                cleanup_errors.append("observer: ThreadDidNotStop")
        if capture_observer is not None and capture_observer.is_alive():
            capture_observer.finish()
            if capture_observer.is_alive():
                cleanup_errors.append("capture-observer: ThreadDidNotStop")
        for process in reversed(processes):
            if not safe_stop(
                process,
                force=True,
                process_group=process.pid in process_group_pids,
            ):
                cleanup_errors.append(f"process-{process.pid}: DidNotStop")
        lingering_ports = [f"{kind}/{port}" for kind, port in ports if not port_is_free(kind, port)]
        if lingering_ports:
            cleanup_errors.append("ports: " + ",".join(lingering_ports))
        for handle in log_handles:
            try:
                handle.close()
            except OSError:
                pass
        if result.get("status") == "FAIL":
            diagnostics = {}
            for path in sorted(work.glob("*.log")):
                try:
                    text = path.read_text(encoding="utf-8", errors="replace")
                    text = redact_markers(text, markers)
                    diagnostics[path.name] = text.splitlines()[-40:]
                except OSError as exc:
                    diagnostics[path.name] = [f"[unavailable: {type(exc).__name__}]"]
            result["sanitized_diagnostics"] = diagnostics
            if capture.exists() and result.get("failure") in {
                "capture decoder validation failed",
                "capture frame validation failed",
                "capture timestamp validation failed",
            }:
                try:
                    debug_capture = TEST_ROOT / "debug-capture.ts"
                    shutil.copyfile(capture, debug_capture)
                    os.chmod(debug_capture, 0o600)
                    result["debug_capture"] = str(debug_capture)
                except OSError as exc:
                    result["debug_capture_error"] = type(exc).__name__

        wiped = 0
        try:
            secret_configs.update(discover_secret_configs(work))
        except OSError as exc:
            cleanup_errors.append(f"secret-discovery: {type(exc).__name__}")
        for path in sorted(secret_configs):
            try:
                wipe_secret_config(path, work)
                wiped += 1
            except (OSError, TestFailure) as exc:
                cleanup_errors.append(f"{path.name}: {type(exc).__name__}")
        try:
            remove_workdir(work)
        except (OSError, TestFailure) as exc:
            cleanup_errors.append(f"workdir: {type(exc).__name__}")
        result["secret_configs_wiped"] = wiped
        result["workdir_removed"] = not work.exists() and not work.is_symlink()
        if cleanup_errors:
            result["status"] = "FAIL"
            result["cleanup_failure"] = cleanup_errors
            print("Self-test cleanup failed; result forced to FAIL.", file=sys.stderr, flush=True)

        result["finished_utc"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        try:
            atomic_json(result_file, result)
        except (OSError, TypeError, ValueError) as exc:
            result["status"] = "FAIL"
            result_save_failed = True
            print(f"Unable to save sanitized test result: {type(exc).__name__}", file=sys.stderr)
        if result["status"] == "PASS" and not result_save_failed:
            print("[8/8] Local relay continuity test: PASS", flush=True)
        os.close(lock_fd)
        for item, previous in previous_signal_handlers.items():
            signal.signal(item, previous)
    return 0 if result["status"] == "PASS" and not result_save_failed else 1


if __name__ == "__main__":
    raise SystemExit(main())
