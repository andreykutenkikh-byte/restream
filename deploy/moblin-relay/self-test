class PacedMPEGTSFeeder(threading.Thread):
    """Pace a backpressured transport without skipping or replaying on pause."""

    def __init__(
        self,
        remux_command: list[str],
        udp_port: int,
        *,
        bytes_per_second: float = LIVE_TRANSPORT_MUX_RATE_BITS_PER_SECOND / 8,
    ) -> None:
        super().__init__(name="moblin-relay-test-live-feeder", daemon=True)
        if (
            not remux_command
            or bytes_per_second <= 0
            or LIVE_FEED_CHUNK_BYTES % MPEGTS_PACKET_SIZE_BYTES != 0
            or LIVE_FEED_CHUNK_BYTES > MAX_UDP_DATAGRAM_BYTES
        ):
            raise TestFailure("synthetic LIVE transport has invalid pacing metadata")
        self._remux_command = tuple(remux_command)
        self._bytes_per_second = bytes_per_second
        self._destination = ("127.0.0.1", udp_port)
        self._condition = threading.Condition()
        self._remux: subprocess.Popen | None = None
        self._ready = False
        self._pause_requested = False
        self._paused = False
        self._stop_requested = False
        self._failure_kind: str | None = None

    @property
    def failure_kind(self) -> str | None:
        with self._condition:
            return self._failure_kind

    @property
    def remux_pid(self) -> int | None:
        with self._condition:
            remux = self._remux
        if remux is None or remux.poll() is not None:
            return None
        return remux.pid

    def healthy(self) -> bool:
        with self._condition:
            ready = self._ready
            stopped = self._stop_requested
            failed = self._failure_kind is not None
            remux = self._remux
        return (
            self.is_alive()
            and ready
            and not stopped
            and not failed
            and remux is not None
            and remux.poll() is None
        )

    def wait_ready(self, timeout: float) -> bool:
        with self._condition:
            observed = self._condition.wait_for(
                lambda: self._ready or self._stop_requested or self._failure_kind is not None,
                timeout,
            )
            return (
                observed and self._ready and not self._stop_requested and self._failure_kind is None
            )

    def pause(self, timeout: float = LIVE_FEED_CONTROL_TIMEOUT_SECONDS) -> bool:
        with self._condition:
            if not self._ready or self._stop_requested or self._failure_kind is not None:
                return False
            self._pause_requested = True
            self._condition.notify_all()
            observed = self._condition.wait_for(
                lambda: (
                    self._paused
                    or not self._ready
                    or self._stop_requested
                    or self._failure_kind is not None
                ),
                timeout,
            )
            return observed and self._paused and self._failure_kind is None

    def resume(self, timeout: float = LIVE_FEED_CONTROL_TIMEOUT_SECONDS) -> bool:
        with self._condition:
            if not self._paused or self._stop_requested or self._failure_kind is not None:
                return False
            self._pause_requested = False
            self._condition.notify_all()
            observed = self._condition.wait_for(
                lambda: (
                    not self._paused
                    or not self._ready
                    or self._stop_requested
                    or self._failure_kind is not None
                ),
                timeout,
            )
            return observed and not self._paused and self._failure_kind is None

    def finish(self, timeout: float = LIVE_FEED_STOP_TIMEOUT_SECONDS) -> bool:
        phase_timeout = max(0.0, timeout / 3)
        with self._condition:
            self._stop_requested = True
            self._pause_requested = False
            self._condition.notify_all()
            remux = self._remux
        if remux is not None and remux.poll() is None:
            with contextlib.suppress(OSError):
                remux.terminate()
        self.join(phase_timeout)
        if self.is_alive():
            with self._condition:
                remux = self._remux
            if remux is not None and remux.poll() is None:
                with contextlib.suppress(OSError):
                    remux.kill()
            self.join(phase_timeout)
        if self.is_alive():
            return False
        with self._condition:
            remux = self._remux
        if remux is not None:
            if remux.poll() is None:
                with contextlib.suppress(OSError):
                    remux.kill()
            try:
                remux.wait(timeout=phase_timeout)
            except (OSError, subprocess.TimeoutExpired):
                return False
            with self._condition:
                if self._remux is remux:
                    self._remux = None
        return not self.is_alive()

    def _fail(self, kind: str) -> None:
        with self._condition:
            if not self._stop_requested:
                self._failure_kind = kind
            self._condition.notify_all()

    def run(self) -> None:
        pending = bytearray()
        remux: subprocess.Popen | None = None
        try:
            remux = subprocess.Popen(  # noqa: S603 - fixed test-only argv
                list(self._remux_command),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                bufsize=0,
            )
            if remux.stdout is None:
                self._fail("remux")
                return
            with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sender:
                with self._condition:
                    self._remux = remux
                    self._condition.notify_all()
                pacing_anchor = time.monotonic()
                paced_bytes = 0
                while True:
                    with self._condition:
                        while self._pause_requested and not self._stop_requested:
                            self._paused = True
                            self._condition.notify_all()
                            self._condition.wait()
                        if self._stop_requested:
                            return
                        if self._paused:
                            self._paused = False
                            pacing_anchor = time.monotonic()
                            paced_bytes = 0
                            self._condition.notify_all()

                    while len(pending) < LIVE_FEED_CHUNK_BYTES:
                        with self._condition:
                            if self._stop_requested:
                                return
                            if self._pause_requested:
                                break
                        piece = remux.stdout.read(LIVE_FEED_CHUNK_BYTES - len(pending))
                        if not piece:
                            self._fail("remux")
                            return
                        pending.extend(piece)
                    if len(pending) < LIVE_FEED_CHUNK_BYTES:
                        continue

                    with self._condition:
                        if self._stop_requested:
                            return
                        if self._pause_requested:
                            continue
                        deadline = pacing_anchor + paced_bytes / self._bytes_per_second
                        now = time.monotonic()
                        if now < deadline:
                            self._condition.wait(deadline - now)
                            continue
                        if now > deadline:
                            # Drop accumulated wall-clock lag, never transport bytes.
                            # The following datagram remains one full interval away.
                            pacing_anchor += now - deadline
                    try:
                        sent = sender.sendto(pending, self._destination)
                    except OSError:
                        self._fail("socket")
                        return
                    if sent != len(pending):
                        self._fail("socket")
                        return
                    with self._condition:
                        if not self._ready and not self._stop_requested:
                            self._ready = True
                            self._condition.notify_all()
                    paced_bytes += len(pending)
                    pending.clear()
        except OSError:
            self._fail("remux")
        finally:
            if remux is not None:
                if remux.stdout is not None:
                    with contextlib.suppress(OSError):
                        remux.stdout.close()
                if remux.poll() is None:
                    with contextlib.suppress(OSError):
                        remux.terminate()
                try:
                    remux.wait(timeout=1.0)
                except subprocess.TimeoutExpired:
                    with contextlib.suppress(OSError):
                        remux.kill()
                    try:
                        remux.wait(timeout=1.0)
                    except (OSError, subprocess.TimeoutExpired):
                        self._fail("remux")
                except OSError:
                    self._fail("remux")
            with self._condition:
                if remux is None or remux.poll() is not None:
                    self._remux = None
                self._ready = False
                self._paused = False
                self._condition.notify_all()


