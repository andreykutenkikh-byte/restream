class TestFailure(RuntimeError):
    pass


def mark_self_test_stage(stage: str) -> None:
    if not SELF_TEST_STAGE_FILE:
        return
    if (
        stage not in SELF_TEST_STAGES
        or SELF_TEST_STAGE_PATH.fullmatch(SELF_TEST_STAGE_FILE) is None
    ):
        raise TestFailure("invalid internal self-test stage")
    parent_metadata = os.lstat(Path(SELF_TEST_STAGE_FILE).parent)
    if (
        not stat.S_ISDIR(parent_metadata.st_mode)
        or stat.S_ISLNK(parent_metadata.st_mode)
        or parent_metadata.st_uid != 0
        or stat.S_IMODE(parent_metadata.st_mode) & 0o022
    ):
        raise TestFailure("unsafe internal self-test stage directory")
    flags = os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC | os.O_NONBLOCK
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(SELF_TEST_STAGE_FILE, flags, 0o600)
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != 0 or metadata.st_nlink != 1:
            raise TestFailure("unsafe internal self-test stage file")
        os.fchmod(descriptor, 0o600)
        os.ftruncate(descriptor, 0)
        payload = f"{stage}\n".encode("ascii")
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise TestFailure("unable to write internal self-test stage")
            view = view[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def validate_preview_renderer_contract() -> dict:
    """Verify the installed renderer's optional HLS contract without enabling it."""

    loader = importlib.machinery.SourceFileLoader("moblin_relay_render_config_test", str(RENDERER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise TestFailure("unable to load the runtime config renderer")
    renderer = importlib.util.module_from_spec(spec)
    try:
        loader.exec_module(renderer)
    except (ImportError, OSError, SyntaxError) as exc:
        raise TestFailure(
            f"unable to load the runtime config renderer: {type(exc).__name__}"
        ) from exc

    token = secrets.token_urlsafe(32).encode("ascii")
    control_token = base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b"=")
    try:
        enabled = renderer.build_runtime_config(
            "test_publisher",
            "publisher-password-0123456789",
            "passphrase-0123456789",
            "rtmps://example.invalid/live2",
            "test-youtube-key",
            token,
            control_token,
        )
        disabled = renderer.build_runtime_config(
            "test_publisher",
            "publisher-password-0123456789",
            "passphrase-0123456789",
            "rtmps://example.invalid/live2",
            "test-youtube-key",
            None,
            control_token,
        )
    except (AttributeError, TypeError, ValueError) as exc:
        raise TestFailure(f"invalid preview renderer contract: {type(exc).__name__}") from exc

    preview_users = [
        item for item in enabled.get("authInternalUsers", []) if item.get("user") == "relay-preview"
    ]
    expected_hash = base64.b64encode(hashlib.sha256(token).digest()).decode("ascii")
    expected_user = {
        "user": "relay-preview",
        "pass": f"sha256:{expected_hash}",
        "ips": ["127.0.0.1", "::1"],
        "permissions": [{"action": "read", "path": OUTPUT_PATH}],
    }
    expected_hls = {
        "hls": True,
        "hlsAddress": "127.0.0.1:8888",
        "hlsVariant": "mpegts",
        "hlsSegmentDuration": "2s",
        "hlsSegmentCount": 4,
        "hlsSegmentMaxSize": "3M",
        "hlsAlwaysRemux": False,
    }
    if any(enabled.get(name) != value for name, value in expected_hls.items()):
        raise TestFailure("preview HLS settings do not match the loopback MPEG-TS contract")
    if any(
        config.get("srt") is not True or config.get("srtAddress") != "0.0.0.0:8890"
        for config in (enabled, disabled)
    ):
        raise TestFailure("production SRT listener is not explicitly bound to IPv4")
    if preview_users != [expected_user]:
        raise TestFailure("preview HLS reader is not least-privilege")
    if (
        enabled.get("rtsp") is not True
        or enabled.get("rtspAddress") != "127.0.0.1:8554"
        or enabled.get("rtmp") is not True
        or enabled.get("rtmpAddress") != "127.0.0.1:1935"
    ):
        raise TestFailure("audio normalizer loopback transports are not configured safely")
    expected_control_hash = base64.b64encode(hashlib.sha256(control_token).digest()).decode("ascii")
    control_users = [
        item
        for item in enabled.get("authInternalUsers", [])
        if item.get("user") == "relay-recovery"
    ]
    if control_users != [
        {
            "user": "relay-recovery",
            "pass": f"sha256:{expected_control_hash}",
            "ips": ["127.0.0.1", "::1"],
            "permissions": [{"action": "api"}],
        }
    ]:
        raise TestFailure("recovery control API user is not least-privilege")
    if (
        enabled.get("api") is not True
        or enabled.get("apiAddress") != "127.0.0.1:9997"
        or enabled.get("apiEncryption") is not False
        or enabled.get("apiAllowOrigins") != []
        or enabled.get("apiTrustedProxies") != []
    ):
        raise TestFailure("recovery control API is not loopback-only")
    if any(enabled.get(feature) for feature in ("pprof", "playback", "webrtc", "moq")):
        raise TestFailure("preview renderer enabled a forbidden MediaMTX service")
    paths = enabled.get("paths")
    if not isinstance(paths, dict):
        raise TestFailure("runtime renderer did not return path configuration")
    output = paths.get(OUTPUT_PATH)
    if output != {
        "source": "publisher",
        "overridePublisher": False,
        "alwaysAvailable": True,
        "alwaysAvailableFile": str(SLATE),
        "forward": [
            {"dest": "rtmps://example.invalid/live2#test-youtube-key"},
        ],
    }:
        raise TestFailure("YouTube forward is not attached directly to relay-output")
    local_users = [
        item
        for item in enabled.get("authInternalUsers", [])
        if item.get("user") == "any" and item.get("ips") == ["127.0.0.1", "::1"]
    ]
    required_local_permissions = {
        ("metrics", ""),
        ("read", INGEST_PATH),
        ("publish", OUTPUT_PATH),
    }
    if len(local_users) != 1 or {
        (permission.get("action"), permission.get("path", ""))
        for permission in local_users[0].get("permissions", [])
    } != required_local_permissions:
        raise TestFailure("loopback media workers are not least-privilege")
    serialized = json.dumps(enabled, sort_keys=True)
    if token.decode("ascii") in serialized or control_token.decode("ascii") in serialized:
        raise TestFailure("runtime credential is present in config without hashing")
    if disabled.get("hls") is not False or "hlsAddress" in disabled:
        raise TestFailure("missing preview credential did not disable HLS")
    if any(item.get("user") == "relay-preview" for item in disabled.get("authInternalUsers", [])):
        raise TestFailure("disabled preview unexpectedly retained its reader")
    return {
        "optional_fail_open": True,
        "listener": "127.0.0.1:8888",
        "variant": "mpegts",
        "segment_duration_seconds": 2,
        "segment_count": 4,
        "credential_in_runtime": "sha256-only",
        "reader_permission": f"read:{OUTPUT_PATH}",
        "forbidden_services_disabled": True,
        "srt_listener": "0.0.0.0:8890",
        "recovery_api": "127.0.0.1:9997",
        "recovery_permission": "api-only",
        "forward_path": OUTPUT_PATH,
        "video_mode": "copy",
    }


def redact_markers(text: str, markers: list[bytes]) -> str:
    for marker in sorted(set(markers), key=len, reverse=True):
        text = text.replace(marker.decode("ascii"), "[REDACTED]")
    return text


def sanitized_result_value(value, markers: list[bytes]):
    """Return a JSON-compatible copy with every test marker redacted."""
    if isinstance(value, str):
        return redact_markers(value, markers)
    if isinstance(value, dict):
        return {
            sanitized_result_value(key, markers): sanitized_result_value(item, markers)
            for key, item in value.items()
        }
    if isinstance(value, (list, tuple)):
        return [sanitized_result_value(item, markers) for item in value]
    return value


def acquire_self_test_lock() -> int:
    flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(SELF_TEST_LOCK, flags, 0o600)
    except OSError as exc:
        raise TestFailure(f"unable to open the self-test lock: {type(exc).__name__}") from exc
    try:
        file_stat = os.fstat(fd)
        if not stat.S_ISREG(file_stat.st_mode) or file_stat.st_uid != 0:
            raise TestFailure("the self-test lock is not a root-owned regular file")
        os.fchmod(fd, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return fd
    except BlockingIOError as exc:
        os.close(fd)
        raise TestFailure("another local self-test is already running") from exc
    except Exception:
        os.close(fd)
        raise


def validate_test_root() -> Path:
    root_stat = os.lstat(TEST_ROOT)
    if not stat.S_ISDIR(root_stat.st_mode) or stat.S_ISLNK(root_stat.st_mode):
        raise TestFailure("the self-test root is not a real directory")
    if root_stat.st_uid != 0:
        raise TestFailure("the self-test root is not owned by root")
    root = TEST_ROOT.resolve(strict=True)
    if root != TEST_ROOT:
        raise TestFailure("the self-test root resolves to an unexpected path")
    return root


def validate_workdir(path: Path) -> Path:
    root = validate_test_root()
    if not path.name.startswith(".run-") or path.parent != TEST_ROOT:
        raise TestFailure("unsafe self-test working directory name")
    path_stat = os.lstat(path)
    if not stat.S_ISDIR(path_stat.st_mode) or stat.S_ISLNK(path_stat.st_mode):
        raise TestFailure("unsafe self-test working directory type")
    if path_stat.st_uid != 0:
        raise TestFailure("self-test working directory is not owned by root")
    resolved = path.resolve(strict=True)
    if resolved.parent != root or resolved == root:
        raise TestFailure("self-test working directory escaped its root")
    return resolved


def remove_workdir(path: Path) -> None:
    validate_workdir(path)
    if not getattr(shutil.rmtree, "avoids_symlink_attacks", False):
        raise TestFailure("safe recursive cleanup is unavailable on this platform")
    shutil.rmtree(path)
    if path.exists() or path.is_symlink():
        raise TestFailure("self-test working directory cleanup was incomplete")
    directory_fd = os.open(TEST_ROOT, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def discover_secret_configs(work: Path) -> set[Path]:
    candidates = {
        work / "dut.json",
        work / "control-api.token",
        *work.glob("source-*.json"),
        *work.glob(".dut.json.*"),
        *work.glob(".source-*.json.*"),
    }
    return {path for path in candidates if path.exists() or path.is_symlink()}


def cleanup_stale_workdirs() -> int:
    validate_test_root()
    stale = sorted(path for path in TEST_ROOT.iterdir() if path.name.startswith(".run-"))
    for path in stale:
        if not terminate_test_normalizer_supervisors(path):
            raise TestFailure("stale test normalizer did not stop")
        for config in sorted(discover_secret_configs(path)):
            wipe_secret_config(config, path)
        remove_workdir(path)
    return len(stale)


def validate_secret_config(path: Path, work: Path) -> None:
    work_resolved = validate_workdir(work)
    file_stat = os.lstat(path)
    if (
        not stat.S_ISREG(file_stat.st_mode)
        or stat.S_ISLNK(file_stat.st_mode)
        or file_stat.st_nlink != 1
    ):
        raise TestFailure(f"unsafe secret config type: {path.name}")
    if file_stat.st_uid != 0 or stat.S_IMODE(file_stat.st_mode) != 0o600:
        raise TestFailure(f"unsafe secret config ownership or mode: {path.name}")
    if path.resolve(strict=True).parent != work_resolved:
        raise TestFailure(f"secret config escaped the test work directory: {path.name}")


def wipe_secret_config(path: Path, work: Path) -> None:
    if not path.exists():
        return
    validate_secret_config(path, work)
    flags = os.O_WRONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags)
    try:
        file_stat = os.fstat(fd)
        path_stat = os.lstat(path)
        if (
            (file_stat.st_dev, file_stat.st_ino) != (path_stat.st_dev, path_stat.st_ino)
            or not stat.S_ISREG(file_stat.st_mode)
            or file_stat.st_uid != 0
            or stat.S_IMODE(file_stat.st_mode) != 0o600
            or file_stat.st_nlink != 1
        ):
            raise TestFailure(f"secret config changed before wipe: {path.name}")
        remaining = file_stat.st_size
        zeros = b"\0" * 4096
        os.lseek(fd, 0, os.SEEK_SET)
        while remaining:
            written = os.write(fd, zeros[: min(remaining, len(zeros))])
            if written <= 0:
                raise TestFailure(f"unable to wipe secret config: {path.name}")
            remaining -= written
        os.fsync(fd)
    finally:
        os.close(fd)


def cleanup_test_workdir_after_supervisors(
    work: Path,
    secret_configs: set[Path],
    *,
    supervisors_stopped: bool,
) -> tuple[int, bool, list[str]]:
    """Wipe and remove a test workdir only after its supervisors are gone."""
    if not supervisors_stopped:
        return 0, False, []

    errors = []
    wiped = 0
    try:
        secret_configs.update(discover_secret_configs(work))
    except OSError as exc:
        errors.append(f"secret-discovery: {type(exc).__name__}")
    for path in sorted(secret_configs):
        try:
            wipe_secret_config(path, work)
            wiped += 1
        except (OSError, TestFailure) as exc:
            errors.append(f"{path.name}: {type(exc).__name__}")
    try:
        remove_workdir(work)
    except (OSError, TestFailure) as exc:
        errors.append(f"workdir: {type(exc).__name__}")
    return wiped, not work.exists() and not work.is_symlink(), errors


def run(args: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(args, check=False, **kwargs)


def service_is_active() -> bool:
    return (
        run(
            ["systemctl", "is-active", "--quiet", SERVICE],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode
        == 0
    )


def atomic_json(path: Path, value: dict, mode: int = 0o600) -> None:
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as fp:
            json.dump(value, fp, ensure_ascii=True, sort_keys=True, indent=2)
            fp.write("\n")
            fp.flush()
            os.fsync(fp.fileno())
        os.replace(temporary_path, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass


def persist_sanitized_result(path: Path, value: dict, markers: list[bytes]) -> None:
    """Atomically persist a result copy after a fail-closed marker scan."""
    sanitized = sanitized_result_value(value, markers)
    serialized = json.dumps(sanitized, ensure_ascii=True, sort_keys=True)
    if any(marker.decode("ascii") in serialized for marker in markers):
        raise TestFailure("sanitized self-test result still contains a test marker")
    atomic_json(path, sanitized)


def persist_sanitized_results(paths: tuple[Path, ...], value: dict, markers: list[bytes]) -> None:
    """Persist every target; never leave a newly written PASS after a partial failure."""
    failed = False
    for path in paths:
        try:
            persist_sanitized_result(path, value, markers)
        except (OSError, TypeError, ValueError, TestFailure):
            failed = True
    if failed:
        incomplete = {
            "status": "FAIL",
            "mode": value.get("mode", "unknown"),
            "result_phase": value.get("result_phase", "unknown"),
            "failure": "self-test result persistence incomplete",
        }
        for field in ("started_utc", "finished_utc"):
            if field in value:
                incomplete[field] = value[field]
        for path in paths:
            with contextlib.suppress(OSError, TypeError, ValueError, TestFailure):
                persist_sanitized_result(path, incomplete, [])
        raise TestFailure("unable to persist every self-test result target")


def read_sanitized_failure_log_tail(path: Path, work: Path, markers: list[bytes]) -> list[str]:
    """Read a bounded root-owned log tail without following links."""
    work_resolved = validate_workdir(work)
    path_metadata = os.lstat(path)
    if (
        not stat.S_ISREG(path_metadata.st_mode)
        or stat.S_ISLNK(path_metadata.st_mode)
        or path_metadata.st_uid != 0
        or path_metadata.st_nlink != 1
        or stat.S_IMODE(path_metadata.st_mode) & 0o022
        or path.resolve(strict=True).parent != work_resolved
    ):
        raise TestFailure("unsafe self-test diagnostic log")

    flags = os.O_RDONLY | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or (opened.st_dev, opened.st_ino) != (path_metadata.st_dev, path_metadata.st_ino)
            or opened.st_uid != 0
            or opened.st_nlink != 1
        ):
            raise TestFailure("self-test diagnostic log changed while opening")
        marker_overlap = max((len(marker) for marker in markers), default=0)
        maximum = FAILURE_DIAGNOSTIC_TAIL_BYTES + marker_overlap
        offset = max(0, opened.st_size - maximum)
        os.lseek(descriptor, offset, os.SEEK_SET)
        payload = bytearray()
        while len(payload) < maximum:
            chunk = os.read(descriptor, maximum - len(payload))
            if not chunk:
                break
            payload.extend(chunk)
    finally:
        os.close(descriptor)

    if offset:
        first_newline = payload.find(b"\n")
        if first_newline < 0:
            payload.clear()
        else:
            del payload[: first_newline + 1]
    text = redact_markers(payload.decode("utf-8", errors="replace"), markers)
    return text.splitlines()[-FAILURE_DIAGNOSTIC_LINE_LIMIT:]


def collect_sanitized_failure_diagnostics(work: Path, markers: list[bytes]) -> dict:
    """Collect only bounded, redacted log tails from the validated workdir."""
    validate_workdir(work)
    diagnostics = {}
    for path in sorted(work.glob("*.log")):
        try:
            diagnostics[path.name] = read_sanitized_failure_log_tail(path, work, markers)
        except (OSError, TestFailure) as exc:
            diagnostics[path.name] = [f"[unavailable: {type(exc).__name__}]"]
    return diagnostics


def write_control_api_token(work: Path) -> tuple[Path, bytes]:
    """Create the isolated root-only credential used by the recovery test DUT."""
    validate_workdir(work)
    path = work / "control-api.token"
    token = base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b"=")
    if len(token) != 43 or not re.fullmatch(rb"[A-Za-z0-9_-]{43}", token):
        raise TestFailure("unable to generate a valid recovery control credential")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags, 0o600)
    try:
        os.fchmod(descriptor, 0o600)
        payload = token + b"\n"
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise TestFailure("unable to write the recovery control credential")
            view = view[written:]
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    validate_secret_config(path, work)
    return path, token


def parse_metrics(text: str, name: str) -> list[tuple[dict[str, str], float]]:
    samples: list[tuple[dict[str, str], float]] = []
    pattern = re.compile(rf"^{re.escape(name)}(?:\{{([^}}]*)\}})?\s+([-+0-9.eE]+)$")
    label_pattern = re.compile(r'(\w+)="((?:\\.|[^"\\])*)"(?:,|$)')
    for line in text.splitlines():
        match = pattern.match(line)
        if not match:
            continue
        labels = {
            item.group(1): item.group(2) for item in label_pattern.finditer(match.group(1) or "")
        }
        try:
            samples.append((labels, float(match.group(2))))
        except ValueError:
            pass
    return samples


def fetch_metrics(port: int) -> str:
    with urllib.request.urlopen(f"http://127.0.0.1:{port}/metrics", timeout=1) as response:
        return response.read(2_000_000).decode("utf-8", errors="replace")


def kick_test_sink_rtmp_connection(connection_id: str) -> None:
    """Kick one exact loopback test-sink publisher without logging its ID."""
    if re.fullmatch(r"[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}", connection_id) is None:
        raise TestFailure("invalid test sink RTMP connection identity")
    request = urllib.request.Request(
        f"http://127.0.0.1:{SINK_API_PORT}/v3/rtmpconns/kick/{connection_id}",
        method="POST",
    )
    try:
        with urllib.request.urlopen(  # noqa: S310 - fixed loopback HTTP endpoint
            request,
            timeout=2,
        ) as response:
            status = response.status
            response.read(1)
    except OSError:
        raise TestFailure("test sink RTMP disconnect request failed") from None
    if status != 200:
        raise TestFailure("test sink RTMP disconnect request was rejected")


def port_is_free(kind: str, port: int) -> bool:
    sock_type = socket.SOCK_DGRAM if kind == "udp" else socket.SOCK_STREAM
    with socket.socket(socket.AF_INET, sock_type) as sock:
        if kind == "tcp":
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


def wait_tcp(port: int, timeout: float = 15.0) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.25):
                return
        except OSError:
            time.sleep(0.1)
    raise TestFailure(f"TCP/{port} did not become ready")


def wait_udp_bound(process: subprocess.Popen, port: int, timeout: float = 5.0) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise TestFailure(f"local primary publisher exited before binding UDP/{port}")
        if not port_is_free("udp", port):
            return
        time.sleep(0.05)
    raise TestFailure(f"UDP/{port} did not become ready")


def wait_file_growth(path: Path, minimum: int, timeout: float = 20.0) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            if path.stat().st_size >= minimum:
                return
        except FileNotFoundError:
            pass
        time.sleep(0.2)
    raise TestFailure(f"{path.name} did not grow")


def safe_stop(
    process: subprocess.Popen | None,
    *,
    force: bool = False,
    process_group: bool = False,
) -> bool:
    if process is None:
        return True
    # Never signal a numeric PID/PGID after its owned leader has exited. A PID
    # may already have been recycled; scoped child cleanup is handled through
    # validated pidfds instead.
    if process.poll() is not None:
        return True
    stop_signal = signal.SIGKILL if force else signal.SIGINT
    try:
        if process_group:
            os.killpg(process.pid, stop_signal)
        else:
            process.send_signal(stop_signal)
        if process.poll() is None:
            process.wait(timeout=8)
    except (OSError, subprocess.TimeoutExpired):
        if process.poll() is not None:
            return True
        try:
            if process_group:
                os.killpg(process.pid, signal.SIGKILL)
            else:
                process.kill()
            if process.poll() is None:
                process.wait(timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            pass
    return process.poll() is not None


def process_rss_kib(pid: int) -> int:
    try:
        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
            if line.startswith("VmRSS:"):
                return int(line.split()[1])
    except (OSError, ValueError):
        pass
    return 0


def process_cpu_ticks(pid: int) -> int:
    try:
        text = Path(f"/proc/{pid}/stat").read_text()
        fields = text[text.rfind(")") + 2 :].split()
        return int(fields[11]) + int(fields[12])
    except (OSError, ValueError, IndexError):
        return 0


class Observer(threading.Thread):
    def __init__(
        self, dut: subprocess.Popen, sink: subprocess.Popen, reader: subprocess.Popen, capture: Path
    ):
        super().__init__(daemon=True)
        self.dut = dut
        self.sink = sink
        self.reader = reader
        self.capture = capture
        self.stop_event = threading.Event()
        self.lock = threading.Lock()
        self.samples: list[dict] = []
        self.max_rss_kib = {"dut": 0, "sink": 0, "reader": 0}
        self.max_cpu_percent = {"dut": 0.0, "sink": 0.0, "reader": 0.0}
        self.cpu_previous: dict[str, tuple[float, int]] = {}
        self.cpu_first: dict[str, tuple[float, int]] = {}
        self.clock_ticks = os.sysconf("SC_CLK_TCK")
        self.monitoring_started = time.monotonic()

    def run(self) -> None:
        while not self.stop_event.is_set():
            now = time.monotonic()
            sample = {
                "t": now,
                "dut_alive": self.dut.poll() is None,
                "sink_alive": self.sink.poll() is None,
                "reader_alive": self.reader.poll() is None,
                "dut_metrics_ok": False,
                "sink_metrics_ok": False,
                "path_ready": False,
                "ingest_live": False,
                "ingest_ids": [],
                "ingest_bytes": None,
                "ingest_transport_bytes": None,
                "live": False,
                "normalized": False,
                "normalized_ids": [],
                "normalized_bytes": None,
                "forward": False,
                "sink_ids": [],
                "sink_bytes": None,
                "capture_size": self.capture.stat().st_size if self.capture.exists() else 0,
            }
            try:
                dut_metrics = fetch_metrics(DUT_METRICS_PORT)
                sample["dut_metrics_ok"] = True
                sample["path_ready"] = any(
                    labels.get("name") == OUTPUT_PATH
                    and labels.get("state") == "ready"
                    and value == 1
                    for labels, value in parse_metrics(dut_metrics, "paths")
                )
                sample["ingest_live"] = any(
                    labels.get("path") == INGEST_PATH
                    and labels.get("state") == "publish"
                    and value == 1
                    for labels, value in parse_metrics(dut_metrics, "srt_conns")
                )
                sample["ingest_ids"] = sorted(
                    labels.get("id", "missing-id")
                    for labels, value in parse_metrics(dut_metrics, "srt_conns")
                    if labels.get("path") == INGEST_PATH
                    and labels.get("state") == "publish"
                    and value == 1
                )
                ingest_path_counters = [
                    int(value)
                    for labels, value in parse_metrics(dut_metrics, "paths_inbound_bytes")
                    if labels.get("name") == INGEST_PATH and labels.get("state") == "ready"
                ]
                if len(ingest_path_counters) == 1:
                    sample["ingest_bytes"] = ingest_path_counters[0]
                ingest_transport_counters = [
                    int(value)
                    for labels, value in parse_metrics(
                        dut_metrics, "srt_conns_bytes_received_unique"
                    )
                    if labels.get("id") in sample["ingest_ids"]
                    and labels.get("path") == INGEST_PATH
                    and labels.get("state") == "publish"
                ]
                if len(ingest_transport_counters) == 1:
                    sample["ingest_transport_bytes"] = ingest_transport_counters[0]
                sample["forward"] = any(
                    labels.get("path") == OUTPUT_PATH
                    and labels.get("state") in ("ready", "forwarding")
                    and value == 1
                    for labels, value in parse_metrics(dut_metrics, "forward_dests")
                )
                sample["normalized_ids"] = sorted(
                    labels.get("id", "missing-id")
                    for labels, value in parse_metrics(dut_metrics, "rtmp_conns")
                    if labels.get("path") == OUTPUT_PATH
                    and labels.get("state") == "publish"
                    and value == 1
                )
                sample["normalized"] = len(sample["normalized_ids"]) == 1
                normalizer_counters = [
                    int(value)
                    for labels, value in parse_metrics(dut_metrics, "rtmp_conns_inbound_bytes")
                    if labels.get("id") in sample["normalized_ids"]
                    and labels.get("path") == OUTPUT_PATH
                    and labels.get("state") == "publish"
                ]
                if len(normalizer_counters) == 1:
                    sample["normalized_bytes"] = normalizer_counters[0]
                sample["live"] = sample["ingest_live"] and sample["normalized"]
            except OSError:
                pass
            try:
                sink_metrics = fetch_metrics(SINK_METRICS_PORT)
                sample["sink_metrics_ok"] = True
                sample["sink_ids"] = sorted(
                    labels.get("id", "missing-id")
                    for labels, value in parse_metrics(sink_metrics, "rtmp_conns")
                    if labels.get("path") == "live/sink"
                    and labels.get("state") == "publish"
                    and value == 1
                )
                sink_counters = [
                    int(value)
                    for labels, value in parse_metrics(
                        sink_metrics,
                        "rtmp_conns_inbound_bytes",
                    )
                    if labels.get("id") in sample["sink_ids"]
                    and labels.get("path") == "live/sink"
                    and labels.get("state") == "publish"
                    and value >= 0
                    and value.is_integer()
                ]
                if len(sink_counters) == 1:
                    sample["sink_bytes"] = sink_counters[0]
            except OSError:
                pass
            for name, process in (("dut", self.dut), ("sink", self.sink), ("reader", self.reader)):
                if process.poll() is None:
                    self.max_rss_kib[name] = max(
                        self.max_rss_kib[name], process_rss_kib(process.pid)
                    )
                    ticks = process_cpu_ticks(process.pid)
                    previous = self.cpu_previous.get(name)
                    if previous and now > previous[0]:
                        percent = (
                            (ticks - previous[1]) / self.clock_ticks / (now - previous[0]) * 100.0
                        )
                        self.max_cpu_percent[name] = max(self.max_cpu_percent[name], percent)
                    self.cpu_first.setdefault(name, (now, ticks))
                    self.cpu_previous[name] = (now, ticks)
            with self.lock:
                sample["finished"] = time.monotonic()
                self.samples.append(sample)
            self.stop_event.wait(0.2)

    def snapshot(self) -> dict:
        with self.lock:
            return dict(self.samples[-1]) if self.samples else {}

    def checked_snapshot(self, description: str) -> dict:
        with self.lock:
            samples = [dict(sample) for sample in self.samples]
        problem = observer_health_problem(
            samples,
            monitoring_started=self.monitoring_started,
            now=time.monotonic(),
            alive=self.is_alive(),
        )
        if problem:
            raise TestFailure(f"{problem} during {description}")
        return samples[-1] if samples else {}

    def samples_between(self, started: float, finished: float) -> list[dict]:
        with self.lock:
            return [dict(sample) for sample in self.samples if started <= sample["t"] <= finished]

    def wait_sample(
        self,
        description: str,
        predicate,
        timeout: float,
        *,
        not_before: float = 0.0,
        health_check=None,
    ) -> dict:
        started = time.monotonic()
        deadline = started + timeout
        fresh_after = max(started, not_before)
        while time.monotonic() < deadline:
            if health_check is not None:
                health_check()
            sample = self.checked_snapshot(description)
            dead_processes = [
                name
                for name in ("dut", "sink", "reader")
                if sample and not sample.get(f"{name}_alive")
            ]
            if dead_processes:
                raise TestFailure(
                    "core test process exited during a transition: " + ",".join(dead_processes)
                )
            if (
                sample.get("t", 0.0) >= fresh_after
                and complete_metrics_sample(sample)
                and predicate(sample)
            ):
                return sample
            time.sleep(0.05)
        if health_check is not None:
            health_check()
        raise TestFailure(f"timed out waiting for {description}")

    def finish(self) -> None:
        self.stop_event.set()
        self.join(timeout=3)

    def average_cpu_percent(self) -> dict[str, float]:
        averages = {}
        for name, first in self.cpu_first.items():
            latest = self.cpu_previous.get(name)
            if latest and latest[0] > first[0]:
                averages[name] = (
                    (latest[1] - first[1]) / self.clock_ticks / (latest[0] - first[0]) * 100.0
                )
        return averages


class CaptureObserver(threading.Thread):
    """Sample downstream file growth independently from metrics HTTP requests."""

    def __init__(self, capture: Path):
        super().__init__(daemon=True)
        self.capture = capture
        self.stop_event = threading.Event()
        self.lock = threading.Lock()
        self.samples: list[dict] = []

    def read_sample(self) -> dict:
        capture_ok = False
        capture_size = 0
        try:
            capture_size = self.capture.stat().st_size
            capture_ok = True
        except OSError:
            pass
        return {
            "t": time.monotonic(),
            "capture_ok": capture_ok,
            "capture_size": capture_size,
        }

    def append_sample(self) -> dict:
        sample = self.read_sample()
        with self.lock:
            self.samples.append(sample)
        return sample

    def run(self) -> None:
        while not self.stop_event.is_set():
            self.append_sample()
            self.stop_event.wait(CAPTURE_SAMPLE_INTERVAL_SECONDS)

    def checked_samples_since(self, started: float, description: str) -> list[dict]:
        if not self.is_alive():
            raise TestFailure(f"capture observer stopped during {description}")
        boundary = self.append_sample()
        with self.lock:
            samples = [
                dict(sample)
                for sample in self.samples
                if started <= float(sample["t"]) <= float(boundary["t"])
            ]
        samples.sort(key=lambda sample: float(sample["t"]))
        if not samples or any(not sample.get("capture_ok") for sample in samples):
            raise TestFailure(f"capture observer failed during {description}")
        if not self.is_alive():
            raise TestFailure(f"capture observer stopped during {description}")
        return samples

    def wait_growth(
        self,
        description: str,
        minimum_growth: int,
        timeout: float,
    ) -> dict:
        if not self.is_alive():
            raise TestFailure(f"capture observer stopped during {description}")
        baseline = self.append_sample()
        if not baseline.get("capture_ok"):
            raise TestFailure(f"capture observer failed during {description}")
        minimum_size = int(baseline["capture_size"]) + minimum_growth
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            sample = self.append_sample()
            if not sample.get("capture_ok"):
                raise TestFailure(f"capture observer failed during {description}")
            if int(sample["capture_size"]) >= minimum_size:
                return sample
            if not self.is_alive():
                raise TestFailure(f"capture observer stopped during {description}")
            time.sleep(0.05)
        raise TestFailure(f"timed out waiting for {description}")

    def finish(self) -> None:
        self.stop_event.set()
        self.join(timeout=3)


def complete_metrics_sample(sample: dict) -> bool:
    return bool(sample.get("dut_metrics_ok") and sample.get("sink_metrics_ok"))


def sink_delivery_active(sample: dict, expected_id: str | None = None) -> bool:
    publisher_ids = sample.get("sink_ids")
    inbound_bytes = sample.get("sink_bytes")
    return bool(
        complete_metrics_sample(sample)
        and sample.get("forward")
        and isinstance(publisher_ids, list)
        and len(publisher_ids) == 1
        and isinstance(publisher_ids[0], str)
        and (expected_id is None or publisher_ids[0] == expected_id)
        and type(inbound_bytes) is int
        and inbound_bytes >= 0
    )


class SinkDeliveryGrowthGate:
    """Require two increasing byte observations from one RTMP publisher."""

    def __init__(self) -> None:
        self.publisher_id: str | None = None
        self.inbound_bytes: int | None = None

    def reset(self) -> None:
        self.publisher_id = None
        self.inbound_bytes = None

    def observe(self, sample: dict) -> bool:
        if not sink_delivery_active(sample):
            self.reset()
            return False
        publisher_id = sample["sink_ids"][0]
        inbound_bytes = sample["sink_bytes"]
        if self.publisher_id != publisher_id or self.inbound_bytes is None:
            self.publisher_id = publisher_id
            self.inbound_bytes = inbound_bytes
            return False
        grew = inbound_bytes > self.inbound_bytes
        if inbound_bytes < self.inbound_bytes:
            self.reset()
            return False
        self.inbound_bytes = inbound_bytes
        return grew


def summarize_downstream_delivery(samples: list[dict], started: float, finished: float) -> dict:
    """Summarize confirmed sink-byte delivery across reconnecting publishers."""
    if finished < started:
        raise ValueError("downstream delivery window is invalid")
    ordered = []
    for sample in samples:
        try:
            observed = float(sample.get("finished", sample["t"]))
        except (KeyError, TypeError, ValueError):
            continue
        if started <= observed <= finished and sample.get("sink_metrics_ok"):
            ordered.append((observed, sample))
    ordered.sort(key=lambda item: item[0])

    unique_ids: set[str] = set()
    delivery_gap_count = 0
    rotation_count = 0
    duplicate_publishers = False
    counter_regression = False
    invalid_samples = 0
    inactive_samples = 0
    current_id: str | None = None
    last_seen_id: str | None = None
    last_counter: int | None = None
    last_growth = started
    max_no_growth = 0.0
    final_active = False

    for observed, sample in ordered:
        # A successful sink scrape is authoritative for presence/absence.  A
        # malformed counter sample is not: fail it separately without
        # manufacturing a reconnect from an observation problem.
        final_active = False
        publisher_ids = sample.get("sink_ids")
        if not isinstance(publisher_ids, list) or any(
            not isinstance(item, str) for item in publisher_ids
        ):
            invalid_samples += 1
            continue
        if len(publisher_ids) > 1:
            duplicate_publishers = True
            current_id = None
            continue
        if not publisher_ids:
            inactive_samples += 1
            current_id = None
            continue

        publisher_id = publisher_ids[0]
        inbound_bytes = sample.get("sink_bytes")
        if type(inbound_bytes) is not int or inbound_bytes < 0:
            invalid_samples += 1
            continue
        unique_ids.add(publisher_id)
        if current_id is None and last_seen_id is not None:
            delivery_gap_count += 1
            if publisher_id != last_seen_id:
                rotation_count += 1
        elif current_id is not None and publisher_id != current_id:
            delivery_gap_count += 1
            rotation_count += 1

        if publisher_id == last_seen_id and last_counter is not None:
            if inbound_bytes < last_counter:
                counter_regression = True
            elif inbound_bytes > last_counter:
                max_no_growth = max(max_no_growth, observed - last_growth)
                last_growth = observed
        current_id = publisher_id
        last_seen_id = publisher_id
        last_counter = inbound_bytes
        final_active = bool(sample.get("dut_metrics_ok") and sample.get("forward"))

    max_no_growth = max(max_no_growth, finished - last_growth)
    if not ordered or current_id is None:
        final_active = False
    return {
        "unique_publisher_count": len(unique_ids),
        "delivery_gap_count": delivery_gap_count,
        "id_rotation_count": rotation_count,
        "inactive_samples": inactive_samples,
        "invalid_samples": invalid_samples,
        "duplicate_publishers": duplicate_publishers,
        "counter_regression": counter_regression,
        "max_delivery_outage_seconds": max_no_growth,
        "final_active": final_active,
    }


def summarize_event_delivery_ledger(ledger: list[dict], expected: tuple[str, ...]) -> dict:
    """Validate fixed events and summarize when byte delivery resumed after each."""
    if [item.get("event") for item in ledger] != list(expected):
        raise TestFailure("event-to-delivery recovery ledger is incomplete")
    recovery_seconds = []
    rotations = 0
    previous_dts_marker_count = 0
    for item in ledger:
        elapsed = item.get("recovery_seconds")
        rotated = item.get("publisher_rotated")
        dts_marker_count = item.get("known_dts_marker_count", 0)
        if (
            not isinstance(elapsed, (int, float))
            or isinstance(elapsed, bool)
            or not math.isfinite(elapsed)
            or elapsed < 0
            or elapsed > RTMP_SINK_RECOVERY_TIMEOUT_SECONDS
            or type(rotated) is not bool
            or type(dts_marker_count) is not int
            or dts_marker_count < previous_dts_marker_count
        ):
            raise TestFailure("event-to-delivery recovery ledger is invalid")
        fresh_dts_markers = dts_marker_count - previous_dts_marker_count
        previous_dts_marker_count = dts_marker_count
        event = item.get("event")
        if rotated and event != INTENTIONAL_RTMP_RECONNECT_EVENT and not fresh_dts_markers:
            raise TestFailure("unexpected downstream RTMP publisher rotation")
        if event == INTENTIONAL_RTMP_RECONNECT_EVENT and not rotated:
            raise TestFailure("intentional downstream RTMP reconnect did not rotate publisher")
        recovery_seconds.append(float(elapsed))
        rotations += int(rotated)
    return {
        "event_count": len(ledger),
        "recovery_limit_seconds": RTMP_SINK_RECOVERY_TIMEOUT_SECONDS,
        "maximum_event_to_delivery_seconds": round(max(recovery_seconds, default=0.0), 3),
        "events_with_publisher_rotation": rotations,
    }


def require_accounted_downstream_recovery(delivery: dict, events: dict) -> None:
    """Retain strict media delivery checks and reject rotations outside proven events."""
    if (
        delivery["duplicate_publishers"]
        or delivery["counter_regression"]
        or delivery["invalid_samples"]
        or delivery["max_delivery_outage_seconds"] > RTMP_SINK_RECOVERY_TIMEOUT_SECONDS
        or not delivery["final_active"]
        or delivery["id_rotation_count"] != events["events_with_publisher_rotation"]
    ):
        raise TestFailure("automatic downstream RTMP recovery validation failed")


def observer_health_problem(
    samples: list[dict],
    *,
    monitoring_started: float,
    now: float,
    alive: bool,
) -> str | None:
    if not alive:
        return "observer stopped"
    if not samples:
        if now - monitoring_started > METRICS_BLIND_LIMIT_SECONDS:
            return "observer produced no fresh samples"
        return None
    try:
        latest_finished = float(samples[-1]["finished"])
    except (KeyError, TypeError, ValueError):
        return "observer produced an invalid sample"
    if now - latest_finished > METRICS_BLIND_LIMIT_SECONDS:
        return "observer samples became stale"
    last_complete = monitoring_started
    for sample in reversed(samples):
        if complete_metrics_sample(sample):
            try:
                last_complete = float(sample["finished"])
            except (KeyError, TypeError, ValueError):
                return "observer produced an invalid sample"
            break
    if now - last_complete > METRICS_BLIND_LIMIT_SECONDS:
        return "metrics observability was lost"
    return None


def maximum_metrics_blind_seconds(
    samples: list[dict],
    started: float,
    finished: float,
) -> float:
    """Measure leading, internal and trailing gaps between complete scrapes."""
    if finished < started:
        raise ValueError("metrics observation window is invalid")
    checkpoints = [started]
    for sample in samples:
        if not complete_metrics_sample(sample):
            continue
        try:
            observed = float(sample["finished"])
        except (KeyError, TypeError, ValueError):
            continue
        if started < observed < finished:
            checkpoints.append(observed)
    checkpoints.append(finished)
    checkpoints = sorted(set(checkpoints))
    return max((right - left for left, right in zip(checkpoints, checkpoints[1:])), default=0.0)


def require_metrics_coverage(
    samples: list[dict],
    started: float,
    finished: float,
    description: str,
) -> float:
    blind_seconds = maximum_metrics_blind_seconds(samples, started, finished)
    if blind_seconds > METRICS_BLIND_LIMIT_SECONDS:
        raise TestFailure(f"metrics observability was lost during {description}")
    return blind_seconds


def maximum_capture_no_growth_seconds(samples: list[dict]) -> float:
    """Measure the longest observed wall-clock interval without captured media."""
    if len(samples) < 2:
        return float("inf")
    previous_size = int(samples[0]["capture_size"])
    last_growth = float(samples[0]["t"])
    longest = 0.0
    for sample in samples[1:]:
        timestamp = float(sample["t"])
        size = int(sample["capture_size"])
        longest = max(longest, timestamp - last_growth)
        if size > previous_size:
            previous_size = size
            last_growth = timestamp
    return longest


def parse_proc_fields(payload: bytes) -> tuple[bytes, ...] | None:
    """Parse a NUL-delimited proc file, rejecting malformed empty fields."""
    if not payload or not payload.endswith(b"\0"):
        return None
    fields = tuple(payload[:-1].split(b"\0"))
    if not fields or any(not field for field in fields):
        return None
    return fields


def parse_proc_environment(payload: bytes) -> dict[bytes, bytes] | None:
    fields = parse_proc_fields(payload)
    if fields is None:
        return None
    environment: dict[bytes, bytes] = {}
    for field in fields:
        key, separator, value = field.partition(b"=")
        if not separator or not key or key in environment:
            return None
        environment[key] = value
    return environment


def validated_test_normalizer_token_path(work: Path) -> Path:
    work_resolved = validate_workdir(work)
    token_path = work_resolved / "control-api.token"
    validate_secret_config(token_path, work)
    if token_path.resolve(strict=True) != work_resolved / "control-api.token":
        raise TestFailure("test normalizer token path escaped its workdir")
    return token_path


def proc_process_owner_uid(process_path: Path) -> int:
    return process_path.stat().st_uid


def is_test_normalizer_supervisor(pid: int, work: Path) -> bool:
    """Match only the root-owned normalizer instance for this exact test DUT."""
    if type(pid) is not int or pid <= 1:
        return False
    try:
        token_path = validated_test_normalizer_token_path(work)
        process_path = PROC_ROOT / str(pid)
        if proc_process_owner_uid(process_path) != 0:
            return False
        command = parse_proc_fields((process_path / "cmdline").read_bytes())
        environment = parse_proc_environment((process_path / "environ").read_bytes())
    except (OSError, TestFailure):
        return False

    expected_command = (
        NORMALIZER_PYTHON,
        b"-I",
        os.fsencode(NORMALIZER.as_posix()),
        NORMALIZER_SUPERVISOR_ARGUMENT,
    )
    if command != expected_command or environment is None:
        return False
    expected_environment = {
        b"LANG": b"C",
        b"LC_ALL": b"C",
        b"PATH": b"/usr/bin:/bin",
        b"MOBLIN_RELAY_INTERNAL_RTSP_PORT": str(DUT_RTSP_PORT).encode("ascii"),
        b"MOBLIN_RELAY_INTERNAL_RTMP_PORT": str(DUT_RTMP_PORT).encode("ascii"),
        b"MOBLIN_RELAY_INTERNAL_METRICS_PORT": str(DUT_METRICS_PORT).encode("ascii"),
        b"MOBLIN_RELAY_INTERNAL_CONTROL_API_PORT": str(DUT_API_PORT).encode("ascii"),
        b"MOBLIN_RELAY_INTERNAL_CONTROL_TOKEN_FILE": os.fsencode(str(token_path)),
    }
    source_id = environment.pop(b"MOBLIN_RELAY_INTERNAL_SRT_CONNECTION_ID", None)
    return (
        environment == expected_environment
        and source_id is not None
        and re.fullmatch(rb"[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}", source_id) is not None
    )


def matching_test_normalizer_supervisor_ids(work: Path) -> list[int]:
    """Discover supervisors scoped by the exact validated test token path."""
    validated_test_normalizer_token_path(work)
    matches = []
    try:
        candidates = tuple(PROC_ROOT.iterdir())
    except OSError as exc:
        raise TestFailure("unable to inspect test normalizer processes") from exc
    for process_path in candidates:
        if process_path.name.isdigit():
            pid = int(process_path.name)
            if is_test_normalizer_supervisor(pid, work):
                matches.append(pid)
    return sorted(matches)


def signal_test_normalizer_supervisor(pid: int, work: Path, signum: int) -> bool:
    """Signal an exact test supervisor through a PID-stable descriptor."""
    if signum not in (signal.SIGINT, signal.SIGKILL):
        raise TestFailure("invalid test normalizer cleanup signal")
    if not is_test_normalizer_supervisor(pid, work):
        return False
    pidfd_open = getattr(os, "pidfd_open", None)
    pidfd_send_signal = getattr(signal, "pidfd_send_signal", None)
    if pidfd_open is None or pidfd_send_signal is None:
        return False
    try:
        descriptor = pidfd_open(pid, 0)
    except OSError:
        return False
    try:
        if not is_test_normalizer_supervisor(pid, work):
            return False
        try:
            pidfd_send_signal(descriptor, signum, None, 0)
        except ProcessLookupError:
            return True
        except OSError:
            return False
        return True
    finally:
        os.close(descriptor)


def terminate_test_normalizer_supervisors(work: Path) -> bool:
    """Boundedly reap only supervisors belonging to this test workdir."""
    try:
        validated_test_normalizer_token_path(work)
        for pid in matching_test_normalizer_supervisor_ids(work):
            signal_test_normalizer_supervisor(pid, work, signal.SIGINT)
        deadline = time.monotonic() + TEST_NORMALIZER_STOP_GRACE_SECONDS
        survivors = matching_test_normalizer_supervisor_ids(work)
        while survivors and time.monotonic() < deadline:
            time.sleep(0.025)
            survivors = matching_test_normalizer_supervisor_ids(work)
        for pid in survivors:
            signal_test_normalizer_supervisor(pid, work, signal.SIGKILL)
        deadline = time.monotonic() + TEST_NORMALIZER_STOP_GRACE_SECONDS
        survivors = matching_test_normalizer_supervisor_ids(work)
        while survivors and time.monotonic() < deadline:
            time.sleep(0.025)
            survivors = matching_test_normalizer_supervisor_ids(work)
    except (OSError, TestFailure):
        return False
    return not survivors


def direct_child_process_ids(pid: int) -> list[int]:
    try:
        payload = Path(f"/proc/{pid}/task/{pid}/children").read_text()
    except OSError:
        return []
    return sorted(int(item) for item in payload.split() if item.isdigit())


def wait_process_exit(pid: int, timeout: float) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not Path(f"/proc/{pid}").exists():
            return True
        time.sleep(0.025)
    return not Path(f"/proc/{pid}").exists()


