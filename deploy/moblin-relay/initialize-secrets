#!/usr/bin/python3
"""One-time, server-side generation of production SRT credentials."""

import json
import os
import secrets
import stat
import tempfile
from pathlib import Path

target = Path("/etc/moblin-relay/secrets.json")
if os.geteuid() != 0:
    raise SystemExit("relay secrets must be initialized as root")

target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
parent_stat = target.parent.lstat()
if (
    not stat.S_ISDIR(parent_stat.st_mode)
    or parent_stat.st_uid != 0
    or stat.S_IMODE(parent_stat.st_mode) != 0o700
):
    raise SystemExit("relay secret directory is unsafe")
try:
    target.lstat()
except FileNotFoundError:
    pass
else:
    raise SystemExit("refusing to overwrite existing relay secrets")

data = {
    "schema": 1,
    "srt": {
        "user": "moblin_" + secrets.token_hex(6),
        "password": secrets.token_urlsafe(24),
        "passphrase": secrets.token_urlsafe(24),
    },
    "youtube": {"url": "", "key": ""},
}

fd, temporary = tempfile.mkstemp(prefix=".secrets.", dir=target.parent)
temporary_path = Path(temporary)
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fp:
        json.dump(data, fp, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
        fp.write("\n")
        fp.flush()
        os.fsync(fp.fileno())
    os.replace(temporary_path, target)
    directory_fd = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
finally:
    try:
        temporary_path.unlink()
    except FileNotFoundError:
        pass
