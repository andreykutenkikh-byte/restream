# Deployment example only. Merge into the existing production proxy only after the audit gate.
server {
    listen 443 ssl http2;
    server_name restream.adojapan.ru;

    # Reuse the production certificate mechanism already present on the host.
    ssl_certificate     /path/managed-by-existing-proxy/fullchain.pem;
    ssl_certificate_key /path/managed-by-existing-proxy/privkey.pem;

    client_max_body_size 1m;

    location = /internal {
        return 404;
    }

    location ^~ /internal/ {
        return 404;
    }

    # Only the authenticated relay-media segment route may exceed the global
    # request-body limit. Streaming disables request/response disk buffering.
    location ~ "^/relay-media/v1/preview/segments/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/(?:0|[1-9][0-9]{0,18})$" {
        client_max_body_size 3m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    # Browser preview assets are session-authenticated and remain memory-only.
    location ~ "^/api/nodes/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/relay/preview/(?:index\.m3u8|segment/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/(?:0|[1-9][0-9]{0,18})\.ts)$" {
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
