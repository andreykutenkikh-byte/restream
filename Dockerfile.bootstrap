FROM python:3.12.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENVIRONMENT=production \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_NO_CACHE=1 \
    UV_LINK_MODE=copy \
    HOME=/nonexistent \
    BOOTSTRAP_SOCKET_PATH=/run/adojapan-bootstrap/bootstrap.sock \
    PATH="/srv/bootstrap/.venv/bin:$PATH"

WORKDIR /srv/bootstrap

COPY pyproject.toml uv.lock README.md ./
COPY bootstrap_worker ./bootstrap_worker

RUN pip install "uv==0.11.28" \
    && uv sync --locked --no-dev --no-editable --compile-bytecode \
    && groupadd --gid 10001 adojapan \
    && useradd --uid 10001 --gid adojapan --home-dir /nonexistent \
       --shell /usr/sbin/nologin adojapan \
    && install -d -o 10001 -g 10001 -m 0700 /run/adojapan-bootstrap

USER 10001:10001

STOPSIGNAL SIGTERM

CMD ["python", "-m", "bootstrap_worker"]
