#!/bin/sh
set -eu

mode=${ADOJAPAN_RPM_FIXTURE_MODE:-ready}

if [ "$#" -eq 6 ] && [ "$1" = -q ] && [ "$2" = "--disablerepo=*" ] && \
  [ "$3" = "--enablerepo=docker-ce-stable" ] && [ "$4" = list ] && \
  [ "$5" = --available ]; then
  case "$6" in
    docker-ce|docker-ce-cli)
      [ "$mode" != alma_native_repo_incomplete ] && exit 0
      exit 1
      ;;
    containerd.io|docker-buildx-plugin|docker-compose-plugin)
      exit 0
      ;;
  esac
  exit 64
fi

case "$*" in
  "-y --setopt=install_weak_deps=False install ca-certificates curl gnupg2"|\
  "-q --disablerepo=* --enablerepo=docker-ce-stable makecache")
    exit 0
    ;;
  "-y --setopt=install_weak_deps=False install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin")
    [ "$mode" != alma_native_repo_incomplete ] && exit 0
    exit 91
    ;;
esac

exit 64
